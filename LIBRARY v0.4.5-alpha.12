function dbAssaultObserveDirect(d,visible){
 if(d.location!=='stronghold')return;
 var a=dbAssaultInit(d),s=String(visible||'');if(!s.trim())return;
 var uncertain=/\b(?:if the gate|if the doors|might break|could break|would shatter|attempt to shatter|imagines? the gate|perhaps the gate|dream(?:s|ed|ing)?|imagine(?:s|d)?|recall(?:s|ed)?|suppose|what if|rumors? say)\b/i.test(s);
 var gate=a.assets.gate,frontBlocked=dbArcaneFrontBlocked(d);
 // The explicitly protected magical front retains priority over AI prose.
 if(!frontBlocked&&gate.status!=='destroyed'&&gate.status!=='disabled'&&!uncertain){
  var gateName=/\b(?:gate|gates|doors?|portcullis|threshold)\b/i.test(s);
  var shattered=/(?:\b(?:gate|gates|doors?|portcullis)\b[^.!?\n]{0,110}\b(?:explode inward|explodes inward|exploded inward|blown apart|blows apart|blasted open|torn free|ripped from|collapsed inward|shattered completely)\b|\b(?:shattered|destroyed)\s+(?:main )?(?:gate|gates|doors?|threshold)\b[^.!?\n]{0,70}\b(?:open|yawns|gapes)\b)/i.test(s);
  var damaged=gateName&&/(?:\b(?:gate|gates|doors?|portcullis|hinges?|bracing)\b[^.!?\n]{0,105}\b(?:buckles?|buckle|bend|bends|bent|splinters?|splintered|fractures?|fractured|cracks?|cracked|twists?|twisted|snaps?|snapped)\b|\b(?:hinges?|bracing)\s+\b(?:snap|snapped|buckle|buckled)\b)/i.test(s);
  if(shattered){gate.status='destroyed';console.log('[DB][ASSAULT] gate=destroyed (narrative confirmation)');}
  else if(damaged&&gate.status==='ready'){gate.status='damaged';console.log('[DB][ASSAULT] gate=damaged (narrative confirmation)');}
 }
 // A loaded, aimed or incoming projectile is not a second firing event.
 var sky=a.assets.sky,actualShot=/(?:\bharpoon\b[^.!?\n]{0,72}\b(?:fires?|fired|launches?|launched|streaks?|streaked|shoots?|shot|whistles?|whistled)\b|\b(?:fires?|fired|launches?|launched)\b[^.!?\n]{0,65}\bharpoon\b)/i.test(s);
 var justAiming=/\b(?:aims?|aimed|takes aim|clicks into place|readies?|prepares?|loaded|loading)\b/i.test(s)&&!actualShot;
 if(/\b(?:not|never|has not|have not|isn't|wasn't|hasn't|haven't)\s+(?:yet\s+)?(?:fired|launched|released|shot)\b/i.test(s))actualShot=false;
 var recap=/\b(?:the same harpoon|previously fired|already fired|was launched|that was launched|still streaking|continues its flight|from the last shot)\b/i.test(s);
 if(sky&&sky.status!=='exhausted'&&sky.status!=='destroyed'&&sky.status!=='disabled'&&sky.charges>0&&actualShot&&!justAiming&&!recap&&sky.lastNarratedFiringInput!==d.turn&&sky.lastGeneration!==dbGenerationKey(d)){
  sky.charges--;sky.lastTurn=d.turn;sky.lastGeneration=dbGenerationKey(d);sky.lastNarratedFiringInput=d.turn;
  if(sky.charges===0)sky.status='exhausted';dbThreatBeginShot(d,a,'confirmed launch');console.log('[DB][ASSAULT] sky=spent remaining='+sky.charges+' (narrative launch)');
 }
 // Upgrade reconciliation: an already in-flight projectile may be first
