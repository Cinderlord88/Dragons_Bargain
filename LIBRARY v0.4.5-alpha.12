   if(eventMiss&&!sky.observedMiss){sky.observedMiss=true;console.log('[DB][THREAT] sky_volley=partial_miss (narrative confirmation)');}
   if(eventDeflected&&!sky.observedDeflection){sky.observedDeflection=true;console.log('[DB][THREAT] sky_volley=partial_deflection (narrative confirmation)');}
   if(finalMention&& (eventHit||eventMiss||eventDeflected)){
    sky.status='resolved';sky.outcome=sky.observedHit&&(sky.observedMiss||sky.observedDeflection)?'mixed':sky.observedHit?'hit':sky.observedMiss?'missed':'deflected';
    sky.resolvedGeneration=dbGenerationKey(d);
    console.log('[DB][THREAT] sky_volley='+sky.outcome+' (final projectile confirmed; no HP inferred)');
   }
