 }
 var bridgeDrop=/\b(?:bridge|causeway|span)\b[^.!?\n]{0,100}\b(?:tilts?|tilted|pitches?|pitched|drops?|dropped|falling|plunges?|plunged)\b|\b(?:bridge plates?|obsidian plates?)\b[^.!?\n]{0,80}\b(?:tilts?|tilted|pitches?|pitched|drop|dropped)\b/i.test(s);
 var bridgeMechanism=/\b(?:winch|counterweight|chain|mechanism|release|balance)\b/i.test(s);
 var bridgeOnlyPreparing=/\b(?:prepare(?:s|d)? to|preparing to|about to|ready to|try to|attempt to)\s+(?:drop|tilt|pitch)\b/i.test(s);
 if(bridgeDrop&&bridgeMechanism&&!bridgeOnlyPreparing){
