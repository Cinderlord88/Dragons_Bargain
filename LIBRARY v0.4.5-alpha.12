 var routeMouth=/\b(?:you (?:remain|stand|wait) outside\b.{0,80}\btunnel(?:'s)? (?:mouth|entrance)|your (?:massive )?form crouches (?:just )?outside the entrance\b.{0,85}\btunnel)\b/i.test(prose)&&/\b(?:counterweights?|winch|pulleys?)\b/i.test(prose)&&/\bbridge\b/i.test(prose);
 if(!f.knownBridgeService&&!/\b(?:enter|slip into|squeeze into|crawl into)\b/i.test(input)&&/\b(?:look|inspect|scout|survey|examine)\b/i.test(input)&&route.test(input)&&
    (routeMouth||/\b(?:you can trace|you (?:see|spot|find|notice|identify)|visible|(?:maintenance tunnel|service corridor) ahead (?:slopes|runs|opens))\b/i.test(prose)&&route.test(prose)&&/\b(?:bridge|winch)\b/i.test(prose))){
