 // spend twice; otherwise account for one finite projectile, without a hit.
 var liveFlight=/\b(?:the|a)\s+harpoon\s+(?:comes(?:\s+(?:at|for|toward|towards)\b)?|hurtles?\b[^.!?\n]{0,65}\b(?:toward|towards|at)\b|bears?\s+down\s+on\b|is\s+(?:still\s+)?(?:in\s+flight|flying\s+(?:toward|towards))\b)\b/i.test(s)&&! /\bharpoon\s+comes\s+to\s+(?:rest|a\s+halt)\b/i.test(s);
 if(liveFlight&&sky&&a.threats&&!a.threats.skyShot&&sky.status!=='destroyed'&&sky.status!=='disabled'){
  var alreadySpent=sky.lastNarratedFiringInput===d.turn||sky.lastTurn===d.turn;
