function dbHash(s){var h=2166136261;for(var i=0;i<s.length;i++)h=Math.imul(h^s.charCodeAt(i),16777619);return h>>>0;}
function dbNextRandom(d){d.rng=(Math.imul(d.rng,1664525)+1013904223)>>>0;return d.rng/4294967296;}
function dbPick(d,items){return items[Math.floor(dbNextRandom(d)*items.length)];}
function dbRoll(d,salt){return dbHash(d.seed+'|'+d.turn+'|'+d.clock.elapsedHours+'|'+salt)%10000/10000;}
// PROCEDURAL FORTRESS v0.4.0-alpha.2: princess-first, seed-once world generator.
