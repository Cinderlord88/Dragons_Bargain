function dbArcaneActive(a,id){var x=a&&a.assets&&a.assets[id];return !!x&&(x.status==='ready'||x.status==='damaged');}
function dbArcaneBlocker(a){return dbArcaneActive(a,'aegis')?'aegis':dbArcaneActive(a,'gate_seal')?'gate_seal':null;}
function dbArcanePrepare(d,raw){
 var a=dbArcaneInit(d);if(!a)return null;a.pendingAction=null;
 var s=String(raw||'').replace(/^\s*>\s*(?:You\s+)?/i,'');
 if(/^\s*#/.test(s)||/\b(?:consider|ponder|wonder|imagine|suppose|think about|thinking of|plan to|what if|might|could|do not|don't|without attempting)\b/i.test(s))return null;
 var physical=/\b(?:charge|smash|ram|batter|tear|rip|break|slam|crash|storm|breach|strike|hack|attack|claw|pry|prying|sever|cut|overload|disable|shatter|walk through|stride through|step through|rush through|pass through|force through)\b/i.test(s);
 var supernatural=/\b(?:breathe|breath weapon|cast|conjure|magical fire|spellcasting|pyrokinesis|flame breath|fire breath)\b/i.test(s);
 if(!physical&&!supernatural)return null;
 var tactical=/\b(?:rune|anchor|keystone|conduit|sigil|lattice|focus|counterweight|winch|hinge|drainage|service shaft|culvert|side route|ward relay|shield pylon|underpinning|seal phrase|flank|roof|teleport|portal|dimensional passage|side wall|back wall|rear wall|upper wall|upper tower|upper floor|back entrance|rear entrance|unwarded window|high window|side entrance|underwater entrance|under the foundation)\b/i.test(s);
 var entry=/\b(?:gates?|gatehouse|entrances?|doors?|portcullis|walls?|tower|stonework|threshold|arch|keystone|anchor|rune|shield|seal|conduit)\b/i.test(s);
 if(!entry)return null;
 var zone=d.fortress&&d.fortress.zone;
 var atFront=zone==='approach'||zone==='perimeter';
 var localGate=/\b(?:main gate|gatehouse|bridge approach|portcullis)\b/i.test(s);
 var remote=/\b(?:from afar|miles away|beyond (?:their |its )?range|from the distant|outside (?:their |its )?range)\b/i.test(s);
 if(d.location!=='stronghold'&&!(atFront&&localGate&&!remote))return null;
 if(atFront&&localGate&&!remote)d.location='stronghold';
 var blocker=tactical?null:dbArcaneBlocker(a);
 var screened=remote||/\b(?:beneath the bridge|under the bridge|behind thick cover|under the arch|still concealed|hidden behind|blind angle|rear face|from cover|behind the ridge)\b/i.test(s);
 var clearLane=/\b(?:bridge|open approach|exposed approach|firing lane|straight at|frontal)\b/i.test(s);
 var response=null;
 if(atFront&&!screened&&!tactical){
  if(dbArcaneActive(a,'net_ballista')&&a.assets.net_ballista.charges>0)response='net_ballista';
  else if(clearLane&&dbArcaneActive(a,'catapult')&&a.assets.catapult.charges>0)response='catapult';
  else if(zone==='perimeter'&&dbArcaneActive(a,'elite_guard')&&a.assets.elite_guard.charges>0)response='elite_guard';
 }
 var seekingAnchor=tactical&&/\b(?:anchor|keystone|runic conduit|shield pylon)\b/i.test(s)&&a.assets.gate_anchor&&!a.assets.gate_anchor.observed;
 a.pendingAction={turn:d.turn,kind:tactical?'targeted_weakness':'frontal_entry',result:seekingAnchor?'SEARCH_REQUIRED':tactical?'TACTICAL':blocker?'STOPPED':'CONTESTED',
  blocker:blocker,response:response,reactionUsed:false,requiresPowerAuthorization:supernatural,reason:blocker?'active anchored frontal protection':'actual action subject to size, coverage and guard response'};
 console.log('[DB][ARCANE] plan='+a.pendingAction.result+' target='+(a.pendingAction.blocker||'none')+' response='+(response||'none'));
 return a.pendingAction;
}
function dbArcaneFrontBlocked(d){var a=d.arcaneFortress,p=a&&a.pendingAction;return !!(p&&p.turn===d.turn&&p.kind==='frontal_entry'&&p.result==='STOPPED'&&dbArcaneActive(a,p.blocker));}
function dbArcaneAllowEntry(d,method){if(!dbArcaneFrontBlocked(d))return true;
 console.log('[DB][ARCANE] BLOCKED unsupported frontal entry via '+method+' while '+d.arcaneFortress.pendingAction.blocker+' is active');
 return false;
}
function dbArcaneStrip(s){return String(s||'').replace(/\[DB_ARCANE\|target=[a-z_]+\|event=(?:revealed|spent|damaged|disabled|destroyed|exhausted)\]/gi,'').trim();}
// Reconcile the existing approach battery from witnessed equipment and
// completed physical events. A marker is corroboration, not a shot or hit.
function dbNetBallistaEvidence(d,raw){
 var a=d.arcaneFortress,x=a&&a.assets.net_ballista;
 var proof={observed:false,shots:0,terminal:''};
 if(!x||(d.fortress.zone!=='approach'&&d.fortress.zone!=='perimeter'))return proof;
 var prose=dbArcaneStrip(String(raw||'').replace(/"[^"]*"|“[^”]*”/g,' '));
 var lines=prose.split(/[.!?\n]+/);

 var hardware=/\b(?:ballistae?|net battery)\b/i;
 var blocked=/\b(?:no|not|never|fails?|unable|might|could|would|possibly|perhaps|imagines?|tries|attempts?)\b/i;
 var factual=lines.filter(function(line){return !blocked.test(line)&&!/\b(?:claims?|reports?|rumou?r)\b/i.test(line);}).join(' ');
 var named=/\b(?:net[- ]ballistae?|net battery|weighted (?:nets?|mesh))\b/i.test(factual)||/\bnet handler\b/i.test(factual)&&/\bbarbed metal[- ]weave\b/i.test(factual);
 proof.observed=named&&hardware.test(factual)&&/\b(?:winding frames?|wound|firing terraces?|winch|visible|you (?:see|spot|notice|inspect|observe))\b/i.test(factual);
 var underCover=/\bfrom behind (?:the |a )?(?:solid |sheltered )?(?:arch|wall|cover)\b/i.test(lines[0]||'');
 for(var i=0;i<lines.length;i++){
  var line=lines[i];
  if(blocked.test(line))continue;
  if(!underCover&&(named||x.observed)&&(
    /\b(?:net[- ]ballista|net battery)\s+(?:fires?|fired|launch(?:es|ed))\b/i.test(line)||
    /\b(?:the|a) net (?:sails|arcs|flies|shoots|launches|whips|passes)\b.{0,85}\b(?:air|past|across|toward|below|over|overhead)\b/i.test(line)))proof.shots=Math.max(proof.shots,1);
  if(!underCover&&proof.shots&&/\b(?:the|a) second net (?:sails|arcs|flies|shoots|launches|whips|passes)\b/i.test(line))proof.shots=2;
  if(x.observed&&hardware.test(line)&&/\b(?:shatter(?:s|ed)?|destroy(?:s|ed)?|splinter(?:s|ed)?)\b/i.test(line))proof.terminal='destroyed';
  else if(x.observed&&!proof.terminal&&hardware.test(line)&&/\b(?:snap(?:s|ped)?|sever(?:s|ed)?|break(?:s)?|broke|disabled?)\b/i.test(line)&&/\b(?:winch|rope|release|winding frame)\b/i.test(line))proof.terminal='disabled';
 }
 // The equipment may be established in one sentence and its broken
 // winding gear described in the next. Require both the link and the break.
 if(x.observed&&!proof.terminal&&hardware.test(factual)&&/\b(?:winch|winding mechanism|launch arm)\b/i.test(factual)&&lines.some(function(line){
  return !blocked.test(line)&&(/\brope\b.{0,45}\b(?:severed|snapped|cut through|rips? through it)\b/i.test(line)||
    /\b(?:severed|snapped|cut|broken)\s+(?:winch )?rope\b/i.test(line));
 }))proof.terminal='disabled';
 if(proof.shots)proof.observed=true;
 return proof;
}
function dbArcaneCatapultDischarged(raw){
 return dbArcaneStrip(String(raw||'').replace(/"[^"]*"|“[^”]*”/g,' ')).split(/[.!?\n]+/).some(function(line){
  return !/\b(?:no|not|never|if|would|could|might|aims?|prepares?|loads?|stops?|fails?|behind (?:solid cover|an? arch))\b/i.test(line)&&
   /\b(?:catapult|runestone sling)\b.{0,95}\b(?:fires?|fired|releases?|released|launch(?:es|ed)|hurls?|hurled|looses?)\b/i.test(line);
 });
}
function dbArcaneObserve(d,raw){
 var a=dbArcaneInit(d);if(!a)return;
 var net=dbNetBallistaEvidence(d,raw);
 var plan=a.pendingAction&&a.pendingAction.turn===d.turn?a.pendingAction:null;
 var catapult=!!(plan&&plan.response==='catapult'&&!plan.reactionUsed&&dbArcaneCatapultDischarged(raw));
 if(catapult)raw=String(raw||'')+' [DB_ARCANE|target=catapult|event=revealed][DB_ARCANE|target=catapult|event=spent]';
 raw=String(raw||'').replace(/\[DB_ARCANE\|target=net_ballista\|event=[a-z_]+\]/gi,'');
 if(net.observed)raw+=' [DB_ARCANE|target=net_ballista|event=revealed]';
 if(net.shots)raw+=' [DB_ARCANE|target=net_ballista|event=spent]';
 if(net.terminal)raw+=' [DB_ARCANE|target=net_ballista|event='+net.terminal+']';
 var pat=/\[DB_ARCANE\|target=([a-z_]+)\|event=(revealed|spent|damaged|disabled|destroyed|exhausted)\]/gi;
 var m,seen={},changes=[];
 while((m=pat.exec(String(raw||'')))!==null){
  var id=m[1].toLowerCase(),ev=m[2].toLowerCase(),x=a.assets[id],eventKey=id+'|'+ev;
  if(!x||seen[eventKey])continue;seen[eventKey]=true;
  if(ev==='revealed'){
   if(!x.observed){x.observed=true;changes.push(id+'=revealed');}continue;
  }
  if(x.status==='destroyed'||x.status==='disabled'||x.status==='exhausted')continue;
  if(id==='gate_anchor'&&(ev==='disabled'||ev==='destroyed')){
   var prose=dbArcaneStrip(String(raw||''));
   var evidence=/\b(?:keystone|runic anchor|gate anchor|power conduit)\b/i.test(prose)&&/\b(?:shatter(?:s|ed|ing)?|split|splits|snaps|breaks|broken|destroy(?:ed|s)?|disabl(?:ed|es)?|sever(?:ed|s)?|torn free|ripped free|overload(?:d|s)?)\b/i.test(prose);
   if(!x.observed||!evidence){console.log('[DB][ARCANE] rejected unconfirmed gate_anchor='+ev+' (must first observe anchor and narrate its destruction)');continue;}
  }
  // A bare claim that a blind frontal charge instantly destroyed the precommitted
  // aegis, seal, anchor or wall cannot delete the defense or award progression.
  if(dbArcaneFrontBlocked(d)&&['aegis','gate_seal','gate_anchor','enchanted_stone'].indexOf(id)>=0){
   console.log('[DB][ARCANE] rejected unsupported '+id+'='+ev+' (blind charge)');continue;
  }
  if(plan&&['net_ballista','catapult','elite_guard'].indexOf(id)>=0&&(ev==='spent'||ev==='exhausted')){
   if(ev!=='spent'||plan.response!==id||plan.reactionUsed||(id==='catapult'&&!catapult))continue;
  }
  if(ev==='spent'){
   if(x.charges===null||x.charges<=0||x.lastGeneration===dbGenerationKey(d))continue;
   x.charges-=id==='net_ballista'&&!plan?Math.min(net.shots,x.charges):1;if(plan&&plan.response===id)plan.reactionUsed=true;x.lastTurn=d.turn;x.lastGeneration=dbGenerationKey(d);
   if(x.charges===0)x.status='exhausted';changes.push(id+'=spent remaining='+x.charges);
  }else if(ev==='exhausted'){
   if(x.charges===null)continue;x.charges=0;x.status='exhausted';changes.push(id+'=exhausted');
  }else{
   x.status=ev;changes.push(id+'='+ev);
  }
  // A discovered destroyed power feed deactivates precisely its dependent assets.
  if((ev==='destroyed'||ev==='disabled'||ev==='exhausted')){
   Object.keys(a.assets).forEach(function(other){var y=a.assets[other];if(y.dependencies.indexOf(id)>=0&&dbArcaneActive(a,other)){
    y.status='disabled';changes.push(other+'=disabled (lost '+id+')');
   }});
  }
 }
 if(changes.length){a.lastEventTurn=d.turn;a.history.push({turn:d.turn,events:changes.join(' | ')});
  if(a.history.length>24)a.history.shift();console.log('[DB][ARCANE] '+changes.join(' | '));}
}
function dbArcaneCurrentArea(d){
 var area=DB_LADDER_AREA[d.fortress&&d.fortress.zone];
 if(area)return area;
 var stages=d.ladder&&d.ladder.stages||{};
 for(var i=DB_LADDER_IDS.length-1;i>=0;i--){var id=DB_LADDER_IDS[i];if(stages[id]&&stages[id].discovered&&!stages[id].solved)return id;}
 for(var j=DB_LADDER_IDS.length-1;j>=0;j--){var done=DB_LADDER_IDS[j];if(stages[done]&&stages[done].discovered)return done;}
 return 'approach';
}

function dbArcaneObserveDirect(d,visible){
 var a=d.arcaneFortress,x=a&&a.assets&&a.assets.gate_anchor;
 if(!x||x.observed||d.location!=='stronghold')return;
 var lines=String(visible||'').split(/[.!?\n]+/);
 for(var i=0;i<lines.length;i++){
  var t=lines[i].trim();
  if(!/\b(?:you (?:see|spot|notice|find|discover|trace)|your eyes (?:catch|find)|visible|clearly visible|you can see)\b/i.test(t))continue;
  if(/\b(?:maybe|perhaps|if|suppose|imagine|might|could|rumor|heard|someone says|cannot tell|can't tell|not sure|seems to)\b/i.test(t))continue;
  if(!/\b(?:runic|rune|enchanted|ward|power)\b.{0,55}\b(?:keystone|anchor|conduit)\b|\b(?:keystone|anchor|conduit)\b.{0,55}\b(?:rune|runic|ward|power)\b/i.test(t))continue;
  if(!/\b(?:gate|gatehouse|bridge|outer wall|service|underneath|beneath)\b/i.test(t))continue;
  x.observed=true;console.log('[DB][ARCANE] gate_anchor=revealed (direct narration)');break;
 }
}

function dbArcaneContext(d){
 var a=dbArcaneInit(d);if(!a)return [];
 var area=dbArcaneCurrentArea(d);
 var stages={approach:['approach'],entry:['approach','entry'],intelligence:['intelligence','entry'],wardwork:['wardwork','intelligence'],sanctum:['sanctum','wardwork'],captive:['captive','sanctum'],extraction:['extraction','captive']};
 var activeStages=stages[area]||[area];
 var lines=['[ARCHMAGE FORTRESS — PRECOMMITTED DEFENSIVE CANON, PRIVATE]',
  'A POWERFUL ESTABLISHED WIZARD has prepared an interlocked stronghold capable of REPELLING a powerful dragon that blindly charges the front. Possible families include guards, net ballistae, catapults, golems, undead, summons, spell-seals, enchanted masonry, sigils, counterspells, illusions, traps, dimensional corridors and contingencies. ONLY LISTED ASSETS EXIST in this area. No one-turn direct assault through an intact frontal aegis.',
  'THREAT MODEL: This dragon is a hired rescuer, not a rogue obliged to be stealthy. Killing hostile wizard troops, burning barracks and smashing this evil stronghold are valid, without invented royal outrage or automatic moral consequences. Powerful defenses must have physical placements, warnings, coverage, resources, counters and weaknesses. They are NOT invulnerable. Clever targeted attacks, true bypass, unusual authorized power and sustained adaptation are rewarding.',
  'PRECOMMITTED DEFENSES: Only the assets listed here may act in this area. No new defenses in previously explored space; all charge use and damage persistent. Troops require reports, travel and reaction time. Never teleport reinforcements or automatically hit, immobilize, kill or maim the dragon. At high alert, the wizard uses prepared counters only if plausibly informed.'];
 Object.keys(a.assets).forEach(function(id){var x=a.assets[id];if(activeStages.indexOf(x.stage)>=0){
  lines.push('DEF '+id+': '+x.name+' [status='+x.status+(x.charges===null?'':', finite uses='+x.charges)+']. Location '+x.placement+'. COVERAGE '+x.coverage+'. EFFECT '+x.effect+'. TELL '+x.tell+'. COUNTER '+x.counter+'.');
 }});
 if(a.pendingAction&&a.pendingAction.turn===d.turn){
  var p=a.pendingAction;
  lines.push('DEFENSE REACTION: '+(p.response&&!p.reactionUsed&&dbArcaneActive(a,p.response)?p.response+' eligible for one reaction if it has a clear shot and perceives the dragon. Confirm actual release in prose.':p.reactionUsed?'one reaction already used on this attack. Continue resolving it without another launch.':'no prepared response can activate for this action.'));
  lines.push('PROCEDURAL ASSAULT VERDICT: '+p.result+(p.blocker?' by '+a.assets[p.blocker].name:'')+'. '+(p.requiresPowerAuthorization?' Supernatural activation must FIRST be authorized by Surge Protector/MetaShift; this defense director never grants it. ':'')+(p.response&&!p.reactionUsed&&dbArcaneActive(a,p.response)?' If the guard crews can SEE the exposed dragon and react, first prepared response is '+a.assets[p.response].name+' (no automatic hit; emit spent only after it actually fires).':'')+' '+
   (p.result==='STOPPED'?'If the declared direct assault actually occurs and is authorized when supernatural, the ACTIVE frontal aegis/seal INTERCEPTS it BEFORE it destroys the gate. The gate does NOT fall; the dragon does NOT enter; no force-based entry or gate-destruction marker is valid. Telegraph the real shield and the nearby anchor/alternate routes; defenders have time to respond, with no guaranteed weapon hit.':p.result==='SEARCH_REQUIRED'?'The player has not yet personally discovered the specific gate keystone. First narrate searching, a real access route and possibly a visible clue. Do NOT immediately destroy an unknown hidden anchor. If physically spotted, emit its revealed marker; only a later verified strike can disable it.':'A targeted/contested action is possible; narrate its actual bounded outcome and only then report real changes. No automatic success.'));
 }
 lines.push('DIMENSIONAL GEOMETRY: '+a.routes.filter(function(r){return r.from===area||r.to===area;}).map(function(r){return r.kind+' '+r.from+' -> '+r.to+' via '+r.id+': '+r.condition;}).join(' | ')+'. A demolished EXTERIOR wall cannot automatically enter a pocket-dimension sanctum or reveal the captive. These are real navigational obstacles, not fake punishment for force.',
  'SPELL RULES: The counterspell lattice only counters eligible registered MAGIC in actual coverage; NEVER ordinary claws or weight. Your scenario does NOT grant this dragon a breath weapon, shapeshift, or spell the separate authorization engine did not register. Do not report character hit points or death not established by EnGuard or narration.',
  'OUTPUT EVENTS after truly observed outcomes: [DB_ARCANE|target=net_ballista|event=spent] for a fired shot (not an automatic hit); [DB_ARCANE|target=gate_anchor|event=destroyed] ONLY once a described, physically reached anchor is genuinely broken; [DB_ARCANE|target=gate_seal|event=revealed] after seeing the real seal. Targets are exact DEF IDs, events revealed/spent/damaged/disabled/destroyed/exhausted. For a successful bypass emit normal ladder markers separately. NO markers for intentions, speculation, hidden events or impossible one-turn frontal wins.',
  '[/ARCHMAGE FORTRESS]');
 return lines;
}
function dbArcaneCardText(d,id){
 var a=d.arcaneFortress;if(!a||!a.assets)return '';
 var list=Object.keys(a.assets).filter(function(k){return a.assets[k].stage===id&&a.assets[k].observed;});
 return list.slice(0,6).map(function(k){var x=a.assets[k];return ' Player-observed defense: '+x.name+' ('+x.status+(x.charges===null?'':', remaining activations '+x.charges)+').';}).join('');
}
function dbArcanePublicStatus(d){var a=d.arcaneFortress;if(!a)return '';
 var x=Object.keys(a.assets).filter(function(k){return a.assets[k].observed;});
 var finite=x.filter(function(k){return a.assets[k].charges!==null;});
 var resources=finite.map(function(k){return a.assets[k].name+'='+a.assets[k].charges;}).join('; ');
 return (resources?'\nKnown defense remaining uses: '+resources:'')+'\nConfirmed defenses observed: '+(x.length?x.map(function(k){return a.assets[k].name+' ('+a.assets[k].status+')';}).join('; '):'none identified in play');
}
function dbArcaneGuardNarration(d,visible){
 if(!dbArcaneFrontBlocked(d))return visible;
 var s=String(visible||'');
 // Only a strong assertion of already entering a smashed front gate is
 // contradictory enough to warrant a deterministic, diegetic replacement.
 if(/\b(?:you|the dragon)\s+(?:smash|crash|charge|burst|batter|tear|rip|break)\b.{0,80}\b(?:through|apart|open)\b.{0,110}\b(?:enter|inside|interior|courtyard|threshold|victorious)\b/i.test(s)||
    /\b(?:gates?|doors?|portcullis)\b.{0,75}\b(?:breaks? apart|buckle(?:s|d)? and break|breaks?|shatter(?:s|ed)?|collapses?|explodes?|is (?:destroyed|torn apart))\b.{0,100}\b(?:you|dragon)\b.{0,85}\b(?:enter|inside|cross|step through)\b/i.test(s)||
    /\b(?:the )?(?:(?:main|outer|iron-shod|reinforced) )?(?:gates?|doors?|portcullis)\s+(?:splinters?|fractures?|cracks?|buckles?|shatters?|collapses?|breaks?|bursts?)\b/i.test(s)||
    // A Continue may falsely recap the gate's destruction and then assert entry
    // without restating the original assault verb. Keep intact shields authoritative.
    /\b(?:gates?|doors?|gatehouse threshold)\b[\s\S]{0,200}\b(?:shattered|destroyed|twisted ruins|splintered|torn|yawns open)\b[\s\S]{0,240}\byou\b[^.!?\n]{0,95}\b(?:step|walk|stride|move|pass|enter)\b[^.!?\n]{0,40}\b(?:inside|into|through)\b/i.test(s)){
  var x=d.arcaneFortress.assets[d.arcaneFortress.pendingAction.blocker];
  console.log('[DB][ARCANE] narrative override: unsupported one-turn frontal breakthrough');
  return 'Your headlong impact strikes a prepared magical defense: '+x.name+'. The anchored ward catches the blow before the gate can be breached. You are still outside the fortress. '+x.tell+'. Its coverage is local, not absolute; the defenses have exploitable physical and magical dependencies, but they have not yet been overcome.';
 }
 return visible;
}

// CHALLENGE LADDER v0.4.0-alpha.2 — seven earned objectives, no forced linear routing.
// Can be solved by force, subterfuge, negotiation, magic authorized elsewhere, or bypass.
// Records only narrator-CONFIRMED discoveries and solutions; never infers outcomes from intent.
var DB_LADDER_STAGES=[
 {id:'approach',name:'The Veiled Approach',area:'approach',purpose:'Locate a viable approach without revealing every move to the wizard.',
  obstacles:[
   ['Skywatch triangulation','Signal mirrors or moving light points repeatedly track the sky.','Observe a recalibration gap, approach under cover, foil the scouts or openly negotiate passage.','A detected dragon gives the defenders a warning, not omniscient knowledge.'],
   ['The missing route','Three maps disagree about where the true entrance lies.','Consult a messenger, interrogate a guide, scout the surrounding terrain or test an apparent dead end.','Wrong routes cost time and may expose the dragon to patrols.'],
   ['Outer watcher','A sentry post controls the safe landing ground.','Use cover, draw it away, persuade the watch, or overwhelm the post.','A witnessed breach sends a report only as fast as communications permit.']],
  win:'A credible approach, opening, access arrangement or successful shortcut is established.'},
 {id:'entry',name:'The Threshold',area:'perimeter',purpose:'Overcome the defended outer boundary or find a real alternate entrance.',
  obstacles:[
   ['Two-part gate order','A gate winch requires a duty officer’s token and a physical brake release.','Bargain for a token, find the service mechanism, force the gate, or bypass the gate itself.','Smashing the gate may raise alert and damage a useful return route.'],
   ['Courier interchange','Entry traffic uses a guarded roster and timed deliveries.','Forge credentials, follow a legitimate courier, infiltrate a supply route or break the wall.','Missing personnel prompt a localized search if noticed.'],
   ['Reversible seal','A rune-painted sally port resets its latch after every cycle.','Find the reset lever, suppress its anchor, mimic the signal or enter elsewhere.','A failed timing attempt can isolate the current doorway.']],
  win:'A real passage into the fortress has been opened, traversed or credibly bypassed.'},
 {id:'intelligence',name:'The Living Fortress',area:'garrison',purpose:'Discover where the captive actually is and what protects her.',
  obstacles:[
   ['Custody ledger','The princess’s name is omitted from the public prisoner rolls.','Find delivery slips, question an escort, examine transfer timestamps or track ward service lines.','Rough interrogation may yield lies or trigger a guard report.'],
   ['Conflicting witnesses','Staff describe different prisoner locations for plausible reasons.','Cross-check routines, follow meals, verify signatures or negotiate with a sympathetic keeper.','A false lead costs time and may move the search into danger.'],
   ['Compartmentalized staff','The castellan and wardwright each know only part of the inner route.','Reconcile their information, spy on a handoff, seize a diagram or use supernatural sensing within its actual limits.','Threatened staff may warn their colleagues if they escape.']],
  win:'Enough reliable intelligence exists to locate or directly reach the real captive or objective.'},
 {id:'wardwork',name:'The Arcane Lock',area:'ward',purpose:'Solve the bounded protective magic barring the inner objective.',
  obstacles:[
   ['Three-node lattice','Ward power comes through distinct anchored conduits rather than every surface.','Map the circuit, sabotage a conduit, bargain with the wardwright, counterspell an active effect or physically bypass its coverage.','Breaking the wrong conduit can close one route or trip an alarm.'],
   ['Service-cycle ward','A sigil requires periodic manual recharging and opens a measurable service window.','Observe the cycle, acquire the service key, interrupt the anchor or find another route.','Careless interference may isolate the ward chamber.'],
   ['Oathbound threshold','A magical doorway obeys an exact, documented condition.','Read the oath text, exploit its exception, remove its physical anchor or bypass the threshold.','Violating the oath may summon a nearby guardian, not teleport an army.']],
  win:'The specific inner magical barrier has been defeated, disabled, negotiated or credibly bypassed.'},
 {id:'sanctum',name:'The Wizard’s Answer',area:'sanctum',purpose:'Neutralize, distract, bargain with or deliberately evade the wizard’s active opposition.',
  obstacles:[
   ['Prepared reception','The wizard has a limited prepared defense and a bargaining position.','Expose a false premise, force a costly spell, lure the wizard elsewhere, make a deal or ambush the preparation.','A failed challenge gives the wizard time to mobilize a real reserve.'],
   ['A dangerous choice','The wizard prioritizes a valuable ritual, research asset or political secret.','Threaten or protect the actual objective, uncover leverage, strike fast or bypass the confrontation.','Uncontrolled destruction can threaten prisoners and servants as well as enemies.'],
   ['Double command','Two lieutenants obey contradictory orders as the wizard pursues a separate aim.','Exploit the division, win one faction, isolate a message route or bypass command.','The wizard can retreat or retaliate but cannot know unreported events.']],
  win:'The wizard’s ability to prevent this specific rescue is credibly overcome; killing the wizard is not required.'},
 {id:'captive',name:'The True Prisoner',area:'custody',purpose:'Find out who is held, what they actually want, and how custody can be ended.',
  obstacles:[
   ['Anchor-linked custody','The prisoner room has two mundane safeguards and one finite magical binding.','Gain the escort’s authority, break or bypass the binding, use a prepared release, or rescue from a different direction.','A clumsy breach may put the captive at risk rather than instantly freeing her.'],
   ['Misleading cell','A decoy chamber convincingly imitates the captive’s quarters.','Verify identity through independent evidence, question attendants, observe delivery trails or pierce the disguise.','Following the decoy can cost time; never rewrite the established princess truth.'],
   ['The prisoner’s choice','The person held may refuse immediate flight for reasons tied to the secret plot.','Learn the reason, address real dangers, offer alternatives or reconsider the mission.','Securing access is not consent to carry an adult away against their will.']],
  win:'The true captive or objective is reached and the captivity problem is genuinely resolved, even if its moral answer is not a simple rescue.'},
 {id:'extraction',name:'The Last Passage',area:'escape',purpose:'Get the rescued person or agreed objective safely out without erasing prior progress.',
  obstacles:[
   ['Return route contested','The original entrance has become risky or guarded based on known events.','Use the cleared passage, negotiate an escort, open a service exit or fly out through a plausible breach.','Pursuers must travel; they never teleport directly to the party.'],
   ['Size and safety','A full-grown dragon can leave, but a human companion cannot always follow its path.','Arrange a secure carry, use a wider exit, assume an authorized smaller form or secure a mount.','An improvised departure may cost time or expose the passenger.'],
   ['Counteroffer on departure','A surviving defender offers information, a ceasefire or a bargain.','Accept, reject, expose the bluff, outmaneuver them or simply flee if possible.','A rejected deal may leave political consequences without automatically recapturing anyone.']],
  win:'The party or chosen rescued objective has verifiably left immediate fortress danger, or a credible negotiated release has taken effect.'}
];
var DB_LADDER_IDS=DB_LADDER_STAGES.map(function(x){return x.id;});
var DB_LADDER_METHODS=['force','stealth','diplomacy','magic','sabotage','trick','bypass','other'];
var DB_LADDER_AREA={approach:'approach',perimeter:'entry',garrison:'intelligence',ward:'wardwork',sanctum:'sanctum',custody:'captive',escape:'extraction'};
function dbLadderInit(d){
 if(d.ladder&&d.ladder.schema===1)return d.ladder;
 var stages={};for(var i=0;i<DB_LADDER_STAGES.length;i++){
  var spec=DB_LADDER_STAGES[i];
  stages[spec.id]={discovered:false,solved:false,method:null,variant:dbFortIndex(d,'ladder-'+spec.id,spec.obstacles.length)};
 }
 // In an upgraded v0.2 save, do not reimpose an already-cleared perimeter or ward.
 var pre=d.fortress&&d.fortress.cleared||{};
 var legacy={bypass:'bypass',disable:'sabotage',destroy:'force',negotiate:'diplomacy'};
 if(pre.perimeter){stages.entry.discovered=true;stages.entry.solved=true;stages.entry.method=legacy[pre.perimeter]||'other';}
 if(pre.ward){stages.wardwork.discovered=true;stages.wardwork.solved=true;stages.wardwork.method=legacy[pre.ward]||'other';}
 d.ladder={schema:1,siteId:d.plot.siteId,stages:stages,history:[],lastCommitTurn:-1};
 return d.ladder;
}
function dbLadderStrip(raw){return String(raw||'').replace(/\[DB_LADDER\|(?:discover=(?:approach|entry|intelligence|wardwork|sanctum|captive|extraction)|solve=(?:approach|entry|intelligence|wardwork|sanctum|captive|extraction)\|method=(?:force|stealth|diplomacy|magic|sabotage|trick|bypass|other))\]/gi,'').trim();}
function dbLadderObserve(d,raw){
 var l=dbLadderInit(d),m,changed=[],discover=/\[DB_LADDER\|discover=(approach|entry|intelligence|wardwork|sanctum|captive|extraction)\]/gi;
 if(l.lastCommitTurn===d.turn)return;
 while((m=discover.exec(raw))!==null){var a=l.stages[m[1].toLowerCase()];if(a&&!a.discovered){a.discovered=true;a.discoverySource='marker';changed.push('discovered='+m[1].toLowerCase());}}
 var solve=/\[DB_LADDER\|solve=(approach|entry|intelligence|wardwork|sanctum|captive|extraction)\|method=(force|stealth|diplomacy|magic|sabotage|trick|bypass|other)\]/gi;
 while((m=solve.exec(raw))!==null){var k=m[1].toLowerCase(),b=l.stages[k];if(b&&!b.solved&&!(k==='entry'&&!dbArcaneAllowEntry(d,m[2].toLowerCase()))){b.discovered=true;b.solved=true;b.discoverySource='marker';b.method=m[2].toLowerCase();changed.push('solved='+k+'/'+b.method);
   // Keep the v0.2 fortress status in sync with equivalent confirmed milestones.
   var oldLayer=k==='entry'?'perimeter':k==='wardwork'?'ward':null;
   if(oldLayer&&!d.fortress.cleared[oldLayer]){
    var legacyMethod={force:'destroy',diplomacy:'negotiate',sabotage:'disable'};
    d.fortress.cleared[oldLayer]=legacyMethod[b.method]||'bypass';
   }}}
 if(changed.length){l.lastCommitTurn=d.turn;l.history.push({turn:d.turn,updates:changed.join(' | ')});if(l.history.length>20)l.history.shift();console.log('[DB][LADDER] '+changed.join(' | '));}
}

// GENERATED DISCOVERY SIGNATURES v0.4.1-alpha.1.
// A saved, deterministic recognition vocabulary for each generated challenge.
// This is a low-risk FALLBACK for discovery only: never solves a stage, reports
// an alarm, changes authorization, or treats hidden context as player knowledge.
var DB_DISCOVERY_WINDOW=4;
var DB_DISCOVERY_STOPS={a:1,about:1,above:1,across:1,after:1,along:1,also:1,around:1,against:1,below:1,beyond:1,between:1,from:1,have:1,into:1,only:1,over:1,that:1,their:1,there:1,these:1,those:1,this:1,through:1,under:1,when:1,where:1,which:1,while:1,with:1,without:1,within:1,very:1,used:1,using:1,they:1,them:1,than:1,near:1,more:1,each:1,ever:1,other:1,some:1,into:1,keep:1,keeps:1,never:1,real:1,will:1,ward:1,wards:1,tower:1,fortress:1,dragon:1};
function dbDiscoveryWords(s){var words=String(s||'').toLowerCase().match(/[a-z]{4,}/g)||[],out=[];
 for(var i=0;i<words.length;i++)if(!DB_DISCOVERY_STOPS[words[i]]&&out.indexOf(words[i])<0)out.push(words[i]);
 return out.slice(0,36);
}
function dbDiscoveryBuildSignatures(d){
 if(!d.tower||d.tower.schema!==1)return null;
 var t=d.tower,result={};
 for(var i=0;i<DB_LADDER_IDS.length;i++){
  var id=DB_LADDER_IDS[i],n=t.challengeNodes[id];
  result[id]={tower:t.name,place:n.place,terrain:t.terrainName,material:t.materialName,
   obstacle:n.obstacle,tell:n.tell,
   terrainTerms:dbDiscoveryWords(t.terrainName+' '+t.approach+' '+t.alternate),
   securityTerms:dbDiscoveryWords(n.obstacle+' '+n.tell+' '+t.sky+' '+t.wardMedium)};
 }
 return result;
}
function dbDiscoveryInit(d){
 var l=dbLadderInit(d),t=d.tower;
 if(!l.discovery||l.discovery.schema!==1){
  l.discovery={schema:1,siteId:d.plot.siteId};
  DB_LADDER_IDS.forEach(function(id){l.discovery[id]={location:false,challenge:false,clues:{},recent:[],lastLocationTurn:-1};});
 }
 if(t&&t.schema===1&&!t.discoverySignatures)t.discoverySignatures=dbDiscoveryBuildSignatures(d);
 return l.discovery;
}
function dbDiscoveryContains(text,phrase){
 if(!phrase)return false;
 var clean=String(text||'').toLowerCase(),needle=String(phrase).toLowerCase();
 return clean.indexOf(needle)>=0;
}
function dbDiscoveryWordCount(text,terms){
 var hits=[],clean=' '+String(text||'').toLowerCase().replace(/[^a-z]+/g,' ')+' ';
 for(var i=0;i<terms.length;i++){
  var w=terms[i];if(clean.indexOf(' '+w+' ')>=0)hits.push(w);
 }
 return hits;
}
function dbDiscoveryObservedDirectly(d,visible){
 var input=String(d.lastInput||''),out=String(visible||'');
 if(!/\b(?:approach|arrive|reach|look|watch|study|observe|observing|identify|notice|detect|examine|inspect|survey|scout|circle|investigate|search|sweep|scan)\b/i.test(input))return false;
 if(/\b(?:ask|question|interview|inquire|imagine|suppose|dream|remember|recall|pretend|hypothetical)\b/i.test(input))return false;
 if(/\b(?:what if|might be|could be|perhaps|imagine|suppose|rumou?r|reportedly)\b/i.test(input))return false;
 if(/^\s*["“]/.test(out))return false;
 if(/\b(?:herald|messenger|rumou?r|reports? say|scout claims)\b/i.test(out)&&!(/\b(?:you (?:see|notice|watch|observe|identify|find)|from your vantage|before you)\b/i.test(out)))return false;
 return true;
}
function dbDiscoverySafeVisible(visible){
 // A negated or uncertain sentence supplies no positive evidence, but does
 // not erase separately observed facts from the same passage.
 return String(visible||'').split(/[.!?]+/).filter(function(s){
  return !/\b(?:cannot see|can't see|do not see|did not see|unable to see|nothing (?:new|of note) (?:is )?visible|failed to find|do not find|did not find|no (?:guards|sentries|patrols|defenses) (?:are )?visible|perhaps|supposedly|rumou?r has it|might be|could be)\b/i.test(s);
 }).join('. ');
}
function dbDiscoverySignal(d,id,visible){
 var t=d.tower,sig=t.discoverySignatures[id],lower=String(visible||'').toLowerCase(),found=[],part;
 var name=sig.tower.replace(/^The\s+/i,''),brief=name.split(/\s+/).slice(0,2).join(' ');
 if(dbDiscoveryContains(lower,sig.tower)||dbDiscoveryContains(lower,name)||brief.length>=8&&dbDiscoveryContains(lower,brief))found.push({key:'site',score:4});
 if(dbDiscoveryContains(lower,sig.place))found.push({key:'place',score:5});
 var environments=dbDiscoveryWordCount(lower,sig.terrainTerms);
 if(environments.length)found.push({key:'terrain:'+environments[0],score:1});
 // Site-derived defense vocabulary plus a narrow set of regular security synonyms.
 // Group variants into independent mechanisms so repeated synonyms never stack.
 var matched=dbDiscoveryWordCount(lower,sig.securityTerms);
 var groups={};
 if(/\b(?:watchboats?|patrol boats?|sentry boats?)\b/i.test(lower)&&(/watchboats?|boats?|patrol/i.test(t.sky)))groups.boats=true;
 if(/\b(?:mirrors?|mirror[- ]arrays?|reflective lenses?|scanning lenses?|beacons?)\b/i.test(lower)&&(/mirrors?|beacons?|lenses?|sight/i.test(t.wardMedium+' '+t.sky+' '+sig.tell+' '+t.materialLook)))groups.mirrors=true;
 if(/\b(?:guards?|sentries|watchmen|lookouts?|patrols?|watch posts?|checkpoints?)\b/i.test(lower))groups.watch=true;
 if(/\b(?:trip[- ]lines?|alarms?|signal bells?|warded paths?|ward lights?)\b/i.test(lower))groups.alarm=true;
 if(/\b(?:sweeps?|scans?|surveillance|triangulat|observation|watching the sky)\b/i.test(lower))groups.scanning=true;
 // Any distinct generated feature may support discovery even at a non-marsh tower.
 if(matched.length>=2)groups.generated=true;
 Object.keys(groups).forEach(function(k){found.push({key:'defense:'+k,score:2});});
 var independent=Object.keys(groups).length;
 // A clue is an affirmative, present-tense observation; never infer it from
 // requests or hypotheticals. It is not a successful traversal.
 var clue=/\b(?:blind spots?|gaps? (?:in|between|during)|less attention to|poorly (?:covered|watched|guarded)|unguarded (?:routes?|channels?|approaches?)|out of (?:sight|view)|beneath their (?:line of )?sight|unwatched (?:low|lower|reed|water)|low[- ]angle (?:coverage|approaches?))\b/i.test(lower);
 var timing=/\b(?:cycles?|intervals?|sweeps?|recalibration|scan(?:ning)? pattern)\b/i.test(lower)&&/\b(?:minutes?|hours?|timing|repeats?|regularly)\b/i.test(lower);
 if(clue&&(/\b(?:mirrors?|patrols?|watchboats?|guards?|surveillance|lookouts?|sky lanes|scanning|sight)\b/i.test(lower)||independent))found.push({key:'clue:surveillance_gap',score:4});
 else if(timing&&independent)found.push({key:'clue:patrol_timing',score:2});
 return found;
}
function dbDiscoveryObserve(d,visible){
 if(!d.tower||d.tower.schema!==1)return;
 var l=dbLadderInit(d),all=dbDiscoveryInit(d),t=d.tower;
 if(!dbDiscoveryObservedDirectly(d,visible))return;
 visible=dbDiscoverySafeVisible(visible);if(!visible.trim())return;
 var namedInOutput=dbDiscoveryContains(visible,t.name)||dbDiscoveryContains(visible,t.name.replace(/^The\s+/i,''))||dbDiscoveryContains(visible,t.name.replace(/^The\s+/i,'').split(/\s+/).slice(0,2).join(' '));
 var namedInInput=dbDiscoveryContains(d.lastInput,t.name);
 if(!(d.location==='stronghold'||namedInOutput&&namedInInput))return;
 // The active area alone controls fallback attribution. No hidden interior
 // challenge is revealed just because its vocabulary leaked into context.
 var active=DB_LADDER_AREA[d.fortress.zone]||'approach';
 var uniqueNamed=DB_LADDER_IDS.filter(function(id){return dbDiscoveryContains(visible,t.challengeNodes[id].place);});
 // One distinctive generated room name is enough to focus recognition there;
 // two or more names in a recap/list are ambiguous and are not used to jump.
 if(uniqueNamed.length===1)active=uniqueNamed[0];
 var profile=all[active],record=l.stages[active];
 if(!profile||!record||record.solved)return;
 var evidence=dbDiscoverySignal(d,active,visible);
 if(!evidence.length)return;
 profile.recent=profile.recent.filter(function(x){return x.turn>d.turn-DB_DISCOVERY_WINDOW;});
 var keys={};profile.recent.forEach(function(x){x.items.forEach(function(y){keys[y.key]=y.score;});});
 var fresh=[];evidence.forEach(function(x){if(!keys[x.key]&&!fresh.some(function(y){return y.key===x.key;}))fresh.push(x);});
 if(fresh.length)profile.recent.push({turn:d.turn,items:fresh});
 keys={};profile.recent.forEach(function(x){x.items.forEach(function(y){keys[y.key]=y.score;});});
 var hasName=!!keys.site||!!keys.place;
 // Existing adventures can already be at the tower before this upgrade.
 // Require multiple independent, generator-derived physical features before
 // establishing a location without its literal name in NEW narration.
 var grounded=!hasName&&d.location==='stronghold'&&dbDiscoveryWordCount(visible,t.discoverySignatures[active].terrainTerms).length>=1&&
  dbDiscoveryWordCount(visible,t.discoverySignatures[active].securityTerms).length>=2&&
  Object.keys(keys).filter(function(k){return k.indexOf('defense:')===0;}).length>=2;
 if(grounded&&!profile.location){profile.location=true;profile.lastLocationTurn=d.turn;console.log('[DB][DISCOVERY] location='+active+' (generated features)');}
 if(hasName){if(!profile.location){profile.location=true;console.log('[DB][DISCOVERY] location='+active+' (firsthand)');}profile.lastLocationTurn=d.turn;}
 var score=0,hasDefense=false;Object.keys(keys).forEach(function(k){score+=keys[k];if(k.indexOf('defense:')===0)hasDefense=true;});
 // A location may have been established in an earlier output, but must still
 // be fresh enough to justify attributing later evidence to this tower.
 var anchored=hasName||grounded||profile.location&&(profile.lastLocationTurn>=d.turn-DB_DISCOVERY_WINDOW||record.discovered&&d.location==='stronghold');
 if(!record.discovered&&anchored&&hasDefense&&(score>=7||grounded&&score>=5)){
  record.discovered=true;record.discoverySource='signature';profile.challenge=true;t.challengeNodes[active].discovered=true;
  profile.confirmedFeatures=Object.keys(keys).filter(function(k){return k.indexOf('defense:')===0;});
  l.history.push({turn:d.turn,updates:'discovered='+active+' (signature)'});if(l.history.length>20)l.history.shift();
  l.lastCommitTurn=d.turn;console.log('[DB][LADDER] discovered='+active+' (signature)');
 }else if(record.discovered)profile.challenge=true;
 if(anchored&&record.discovered){
  if(keys['clue:surveillance_gap']&&!profile.clues.surveillance_gap){profile.clues.surveillance_gap=true;console.log('[DB][DISCOVERY] clue='+active+'/surveillance_gap');}
  if(keys['clue:patrol_timing']&&!profile.clues.patrol_timing){profile.clues.patrol_timing=true;console.log('[DB][DISCOVERY] clue='+active+'/patrol_timing');}
 }
}


// CONFIRMED NARRATIVE OUTCOMES (retained v0.4.2-alpha.3 paths).
// Deliberately narrower than generated discovery recognition. The AI's explicit
// [DB_LADDER|solve=...] marker is still the general resolution interface.
// This fallback currently covers only the well-observed APPROACH traversal.
// It requires TWO independently completed actions in the SAME player-facing
// narration: an actual past-the-watch movement and a confirmed safe arrival.
// No rolling scores or player-input intentions can ever produce a victory.
function dbOutcomeSentenceReal(s){
 return !/\b(?:if you|if only|imagine|suppose|perhaps|maybe|might|could|would|should|whether|cannot\s+tell|can't\s+tell|unclear|uncertain|not\s+sure|attempt(?:ing)? to|intend(?:ing)? to|plan(?:ning)? to|hope(?:ing)? to|try(?:ing)? to|before you can|not yet|have not yet|haven't yet|fail(?:ed)? to|almost|nearly)\b/i.test(s);
}
function dbOutcomeObserve(d,visible){
 if(!d.tower||d.tower.schema!==1||d.location!=='stronghold')return;
 var l=dbLadderInit(d),a=l.stages.approach;
 if(!a||a.solved||!a.discovered)return;
 var narrative=String(visible||'');
 // No narrator-confirmed victory from remote reports or reported NPC success.
 var input=String(d.lastInput||'');
 if(/\b(?:ask|question|interview|inquire|imagine|suppose|dream|remember|recall|pretend)\b/i.test(input))return;
 var sentences=narrative.split(/[.!?\n]+/).map(function(x){return x.trim();}).filter(dbOutcomeSentenceReal);
 if(!sentences.length)return;
 // These signals are scoped to the player's own completed movement, not an
 // observer describing a scout or predicting what the dragon might achieve.
 var moved=sentences.some(function(s){
  return /^(?:(?:then|finally|now|afterwards|at last)[, ]+)?you\s+(?:slip|slide|move|pass|cross|sneak|crawl|glide|have\s+(?:slipped|passed|crossed|made\s+it))\b/i.test(s)&&
   /\b(?:boats?['’]s?\s+line\s+of\s+sight|watchboats?|patrols?|surveillance\s+perimeter|mirrors?|scanning|outer\s+watch|guards?|sentries|line\s+of\s+sight)\b/i.test(s)&&
   /\b(?:beneath|below|under|beyond|past|through|around|out\s+of|slip|undetected|unseen)\b/i.test(s);
 });
 var arrived=sentences.some(function(s){
  return (/^(?:(?:then|finally|now|afterwards|at last)[, ]+)?you\s+(?:pause|shelter|settle|arrive|reach|rest|hide|are|stand|crouch|remain|have\s+reached|now\s+shelter)\b/i.test(s)||/\band\s+now\s+(?:shelter|rest|hide)\b/i.test(s))&&
   /\b(?:beneath|under|below|inside|in\s+the\s+shadow\s+of|at\s+the\s+base\s+of)\b/i.test(s)&&
   /\b(?:bridge|bridge['’]s\s+arch|arch\s+of\s+the\s+bridge)\b/i.test(s);
 });
 // For existing saves already beneath the bridge at upgrade, an affirmative
 // CURRENT-STATE confirmation is equally authoritative. This is not a player
 // request, rumor, or cumulative scoring: both bridge location and the fact
 // that outer surveillance is BEHIND the player must be narrated this turn.
 var pastConfirmed=sentences.some(function(s){
  return /^(?:(?:then|finally|now|afterwards|at last)[, ]+)?you\s+(?:have\s+(?:passed|slipped|crossed)|are\s+(?:now\s+)?(?:safely\s+)?(?:past|beyond))\b/i.test(s)&&
   /\b(?:watchboats?|patrols?|surveillance\s+perimeter|mirrors?|outer\s+watch|guards?)\b/i.test(s);
 })||sentences.some(function(s){
  return /\b(?:watchboats?|patrols?|surveillance\s+perimeter|outer\s+watch)\b/i.test(s)&&
    /\b(?:behind\s+you|in\s+your\s+wake)\b/i.test(s)&&
    /^(?:you\s+(?:remain|are|rest|shelter|hide|have\s+reached)\b|the\s+(?:outer\s+)?(?:watchboats?|patrols?|surveillance\s+perimeter)\b)/i.test(s);
 });
 // The narrator can state a COMPLETED bypass directly without restating the
 // whole traversal in two separate clauses. Accept only an affirmative,
 // already-completed player event with explicit outer-perimeter identity AND
 // no-detection outcome; never accept the player's intention or a guess.
 // Example: "You have successfully passed the outer surveillance perimeter
 // of the watchboats ... without detection." (actual live turn 12).
 var directlyConfirmed=sentences.some(function(s){
  return /^you\s+(?:(?:have|had)\s+)?(?:successfully|safely|completely|quietly)\s+(?:passed|bypassed|crossed|slipped\s+past|made\s+it\s+past)\b/i.test(s)&&
    /\b(?:outer\s+(?:surveillance\s+)?perimeter|outer\s+(?:watchboats?|patrols?|watch)|watchboats?\s+(?:patrol|perimeter)|first\s+layer\s+of\s+defen[sc]e)\b/i.test(s)&&
    /\b(?:without\s+(?:(?:being\s+)?(?:seen|detected|noticed)|detection|raising\s+(?:an\s+)?alarm|alerting)|undetected|unnoticed|unseen)\b/i.test(s);
 });
 // A valid continuation of an existing save need not say "watchboats behind you"
 // verbatim. Some narrators situate the dragon by environmental relationships:
 // a bridge DIRECTLY OVERHEAD, a channel ALREADY TRAVERSED, and the known blind
 // corridor STILL HOLDING. Require all three independent facts in this ONE
 // player-facing narration, never in accumulated scores or player input.
 // "Bridge visible ahead" is deliberately insufficient.
 var clean=sentences.join('. ');
 var overheadBridge=sentences.some(function(s){
  return /\bbridge\b.{0,55}\bdirectly\s+above\s+you\b/i.test(s)||
   /\b(?:bridge['’]s?\s+(?:support\s+)?chains|bridge\s+(?:deck|arch|underside))\b.{0,60}\b(?:overhead|above\s+you)\b/i.test(s);
 });
 var traversedRoute=sentences.some(function(s){
  return /\b(?:reed[- ]?)?(?:channels?|route|path|passage)\s+you\s+(?:just\s+)?(?:traversed|crossed|followed|passed\s+through)\b/i.test(s);
 });
 var corridorHeld=sentences.some(function(s){
  return /\b(?:blind\s+corridor|surveillance\s+gap|blind\s+spot)\s+(?:has\s+)?(?:held|holds|remained\s+(?:open|stable))\b/i.test(s)||
    /\bnone\s+of\s+(?:them|the\s+(?:boats|watchboats|patrols))\s+(?:have\s+|are\s+)?(?:altered\s+course|turned\s+toward|turning\s+toward|reacted)\b/i.test(s);
 });
 // Override any affirmative-looking pattern when the narrator explicitly
 // states that an unfinished outer perimeter still lies between the dragon
 // and the objective. This is a completion check, not a keyword counter.
 var explicitlyUnfinished=/\b(?:perimeter|outer\s+(?:watchboats?|patrols?))\s+(?:still\s+)?(?:lie|lies|remain|remains|are|is|wait|waits)\s+(?:ahead|between\s+you)\b|\byou\s+(?:have|had)\s+not\s+(?:passed|crossed|cleared)\s+(?:the\s+)?(?:perimeter|outer\s+watch)\b/i.test(narrative);
 var positionReconfirmed=overheadBridge&&traversedRoute&&corridorHeld&&!explicitlyUnfinished;
 // A guard catching the dragon prevents confirmation of a *stealth* bypass.
 // Never infer a force/diplomacy victory from this guardrail; such methods
 // require explicit structured outcome markers.
 var detectionText=narrative.replace(/\b(?:no|not\s+a\s+single)\s+(?:guards?|sentries|lookouts?|watchboats?|patrols?)\s+(?:spots?|sees?|notices?|detects?|catches?)\s+you\b/gi,'');
 var exposed=/\b(?:guards?|sentries|watchboats?|lookouts?|patrols?|mirrors?)\s+(?:spot|spots|spotted|notice|notices|noticed|detect|detects|detected|catch|catches|caught|see|sees|saw)\s+you\b|\byou\s+(?:are|were|have\s+been)\s+(?:spotted|detected|caught|seen)\b|\b(?:the\s+alarm\s+(?:sounds|rings|is\s+raised)|an\s+alarm\s+is\s+(?:raised|triggered))\b/i.test(detectionText);
 if(exposed||/\b(?:lookout|guard|sentry|watcher|crew)\s+(?:catches?\s+sight\s+of|hears?|raises?\s+the\s+alarm|sounds?\s+the\s+alarm)\b/i.test(detectionText)||explicitlyUnfinished||!((moved||pastConfirmed)&&arrived||positionReconfirmed||directlyConfirmed))return;
 // Same reconciliation as the explicit ladder marker, but NO implicit zone,
 // alert, ward, captive, magic, or adjacent entry-stage side effects.
 a.discovered=true;a.solved=true;a.method='stealth';a.outcomeSource='narrative';a.resolvedTurn=d.turn;
 l.lastCommitTurn=d.turn;
 l.history.push({turn:d.turn,updates:'solved=approach/stealth (narrative)'});
 if(l.history.length>20)l.history.shift();
 console.log('[DB][LADDER] solved=approach/stealth (narrative)');
}


// PERSISTENT OBSERVATIONS AND SAFE PROGRESSION RECONCILIATION v0.4.5-alpha.5.
// Read ONLY the new, player-facing Output text. Facts are grounded in observed
// narration, not in the user's attempt, private context, or generated secrets.
// Unverified ideas stay separate from confirmed facts. Nothing in this layer
// grants magic, fires an alarm, opens a door or solves an inner challenge.
var DB_KNOWLEDGE_FACTS={
 service_access:'A narrow service entrance is visible near the gatehouse.',
 gate_operation:'The main gate is operated by guards using a wheel and lever.',
 bridge_winch:'Bridge chains connect to winch machinery at the gatehouse.',
 bell_curtain:'Silver bells hang by the service entrance.',
 dragon_clearance:'A full-sized dragon’s shoulders would be a tight squeeze in the narrow service passage.',
 moss_trace:'Wet moss surrounds the service entrance and may show disturbance.',
 generated_obstacle:'The location\'s generated obstacle has been directly observed.',
 alternate_access:'A physical alternate access route has been observed.',
 control_mechanism:'A specific physical control mechanism has been observed.',
 guard_routine:'Staffed security routines have been directly observed.',
 confirmed_weakness:'A bounded weakness or gap has been observed in the local defenses.'
};
var DB_KNOWLEDGE_HYPOTHESES={
 bell_alarm:'The silver bells might be connected to an alarm or vibration detector; not confirmed.',
 possible_hazard:'A possible defensive hazard is suspected, but its existence and operation are unverified.'
};
function dbKnowledgeInit(d){
 var l=dbLadderInit(d);
 if(!l.knowledge||l.knowledge.schema!==1||l.knowledge.siteId!==d.plot.siteId){
  l.knowledge={schema:1,siteId:d.plot.siteId,stages:{}};
 }
 DB_LADDER_IDS.forEach(function(id){
  if(!l.knowledge.stages[id])l.knowledge.stages[id]={facts:{},hypotheses:{}};
 });
 return l.knowledge;
}
function dbKnowledgeStage(d,visible){
 var t=d.tower,l=dbLadderInit(d),all=dbDiscoveryInit(d),names=[],i;
 for(i=0;i<DB_LADDER_IDS.length;i++){
  var id=DB_LADDER_IDS[i];
  if(dbDiscoveryContains(visible,t.challengeNodes[id].place))names.push(id);
 }
 if(names.length>1)return null; // ambiguous recaps are not eyewitness attribution
 if(names.length===1)return names[0];
 var candidates=DB_LADDER_IDS.filter(function(id){
  var a=all[id];return l.stages[id].discovered&&a.location&&a.lastLocationTurn>=d.turn-6;
 });
 if(!candidates.length)return null;
 // At an already discovered gatehouse, doors, winches and service ways are
 // stronger location anchors than the still-visible approach surveillance.
 if(candidates.indexOf('entry')>=0&&/\b(?:gatehouse|service entrance|service door|main (?:iron |gate )?doors|winch rooms?|silver bells|bridge chains)\b/i.test(visible))return 'entry';
 candidates.sort(function(a,b){return all[b].lastLocationTurn-all[a].lastLocationTurn;});
 if(candidates.length>1&&all[candidates[0]].lastLocationTurn===all[candidates[1]].lastLocationTurn)return null;
 return candidates[0];
}
function dbKnowledgeObserve(d,visible){
 if(!d.tower||d.tower.schema!==1||d.location!=='stronghold')return;
 if(!dbDiscoveryObservedDirectly(d,visible))return;
 var k=dbKnowledgeInit(d),stage=dbKnowledgeStage(d,visible),l=dbLadderInit(d);
 if(!stage||!l.stages[stage].discovered)return;
 var sentences=String(visible||'').split(/[.!?\n]+/).map(function(x){return x.trim();}).filter(Boolean);
 var factual=sentences.filter(function(x){
  return !/\b(?:perhaps|maybe|might|could|would|suspect|speculat|rumou?r|reportedly|allegedly|probably|possibly|can't tell|cannot tell|unclear|unknown|not sure|imagine|if there|if you|no evidence of|not found|did not find|failed to find|not yet)\b/i.test(x)
   && !/^\s*(?:the herald|a scout|the messenger|somebody|someone|a guard)\s+(?:says|claims|reports|tells|suggests)\b/i.test(x);
 }).join('. ');
 var whole=String(visible||''),confirmed={},suspected={};
 if(stage==='entry'){
  if(/\b(?:service entrance|service door|maintenance (?:entrance|door|hatch)|side door)\b/i.test(factual)&&
     /\b(?:low|narrow|hidden|visible|stand|stands|spot|spots|see|sees|notice|noticed|find|is|lies|ajar|partially)\b/i.test(factual))confirmed.service_access=true;
  if(/\b(?:gatehouse|main gate|main doors?|iron[- ](?:shod|ridged) doors?|doors of)\b/i.test(factual)&&
     /\b(?:wheel|winch|crank)\b/i.test(factual)&&/\b(?:lever|latch|brake)\b/i.test(factual))confirmed.gate_operation=true;
  if(/\bbridge\b/i.test(factual)&&/\b(?:chains?|winches?|counterweights?|pulley|pulleys)\b/i.test(factual)&&
     /\b(?:rooms?|gatehouse|mechanism|walls?)\b/i.test(factual))confirmed.bridge_winch=true;
  if(/\bbells?\b/i.test(factual)&&/\b(?:service entrance|service door|gatehouse|walls?|silver)\b/i.test(factual))confirmed.bell_curtain=true;
  if(/\b(?:service entrance|service door|doorway|passage)\b/i.test(factual)&&/\b(?:shoulders?|head|dragon|squeez|too (?:small|narrow)|wide enough for a man|tight fit)\b/i.test(factual))confirmed.dragon_clearance=true;
  if(sentences.some(function(x){return /\bmoss\b/i.test(x)&&/\b(?:service (?:entrance|door)|doorway|entrance|obsidian wall)\b/i.test(x)&&! /\b(?:perhaps|might|could|suspect|imagines?|rumou?r)\b/i.test(x);}))confirmed.moss_trace=true;
  if(/\bbells?\b/i.test(whole)&&/\b(?:suspect|perhaps|might|could|possible|possibly|uncertain|cannot (?:immediately )?determine)\b[^.!?\n]{0,110}\b(?:touch|trigger|alarm|pressure|vibrat|mechanism|warning|signal)\b/i.test(whole))suspected.bell_alarm=true;
 }
 // Portable vocabulary: generated obstacle identity and broad evidence types
 // are matched only AFTER this particular generated section was discovered.
 // Do not lift descriptions of other rooms or speculation from private context.
 var node=d.tower.challengeNodes[stage];
 if(node&&dbDiscoveryContains(factual,node.obstacle)&&
    (dbDiscoveryContains(factual,node.place)||/\b(?:you (?:see|find|notice|observe|inspect|examine)|visible|stands|protects)\b/i.test(factual)))confirmed.generated_obstacle=true;
 if(stage!=='entry'){
  if(/\b(?:service (?:entrance|door|tunnel|hatch)|side passage|maintenance shaft|alternate entrance|hidden passage)\b/i.test(factual)&&
     /\b(?:you (?:see|spot|notice|find)|there is|stands|visible|opened|leads)\b/i.test(factual))confirmed.alternate_access=true;
  if(/\b(?:winch|wheel|lever|valve|conduit|switch|pulley|latch|crank|anchor)\b/i.test(factual)&&
     /\b(?:you (?:see|spot|notice|find)|visible|operat|controls?|turns?|connects?|linked|mechanism)\b/i.test(factual))confirmed.control_mechanism=true;
  if(/\b(?:guards?|sentries|servants|engineers|wardwrights|patrols)\b/i.test(factual)&&
     /\b(?:shift|rotate|routine|operate|patrol|schedule|exchange|relief)\b/i.test(factual))confirmed.guard_routine=true;
  if(/\b(?:blind spots?|unguarded route|unwatched|exploitable gap|opening in the defense|disabled ward)\b/i.test(factual)&&
     /\b(?:you (?:see|spot|notice|find)|visible|observed|identified|has|have)\b/i.test(factual))confirmed.confirmed_weakness=true;
 }
 var dest=k.stages[stage],updates=[];
 Object.keys(confirmed).forEach(function(id){if(!dest.facts[id]){dest.facts[id]={turn:d.turn,source:'visible_narration'};updates.push('fact='+stage+'/'+id);}});
 Object.keys(suspected).forEach(function(id){if(!dest.hypotheses[id]&&!dest.facts[id]){dest.hypotheses[id]={turn:d.turn,source:'visible_narration'};updates.push('hypothesis='+stage+'/'+id);}});
 if(updates.length){console.log('[DB][KNOWLEDGE] '+updates.join(' | '));}
}
function dbKnowledgeCardText(d,id){
 var l=dbLadderInit(d),st=l.knowledge&&l.knowledge.stages&&l.knowledge.stages[id];
 if(!st)return '';
 var facts=Object.keys(st.facts||{}).filter(function(k){return !!DB_KNOWLEDGE_FACTS[k];}).slice(0,7).map(function(k){return k==='generated_obstacle'?'Observed challenge feature: '+d.tower.challengeNodes[id].obstacle+'.':DB_KNOWLEDGE_FACTS[k];});
 var ideas=Object.keys(st.hypotheses||{}).filter(function(k){return !!DB_KNOWLEDGE_HYPOTHESES[k]&&!st.facts[k];}).slice(0,2).map(function(k){return DB_KNOWLEDGE_HYPOTHESES[k];});
 return (facts.length?' Established observations: '+facts.join(' '):'')+(ideas.length?' Unverified suspicions: '+ideas.join(' '):'');
}
function dbKnowledgeContext(d){
 if(d.location!=='stronghold')return [];
 var l=dbLadderInit(d),k=dbKnowledgeInit(d),visible=DB_LADDER_IDS.filter(function(id){return l.stages[id].discovered&&(Object.keys(k.stages[id].facts).length||Object.keys(k.stages[id].hypotheses).length);});
 return visible.slice(-2).map(function(id){return 'OBSERVATIONS '+id+':'+dbKnowledgeCardText(d,id)+' Confirmed observations remain consistent until credible change. Unverified suspicions are NOT established mechanisms or permission to invent alarms.'+(id==='entry'&&k.stages.entry.facts.dragon_clearance?' PHYSICAL CLEARANCE: do not squeeze the player dragon through a person-sized service door by assertion; allow credible force, engineering, allies, alternate routes or separately authorized form changes.':'');});
}
// CONFIRMED ENTRY VIA A DESTROYED GATE — v0.4.5-alpha.6.
// Storyteller narration may require multiple Continue generations to establish
// movement: breaking a gate, touching the threshold, and truly stepping inside
// are three distinct events. Player intent alone is never a solved stage.
// This conservative direct fallback covers *only* an already-confirmed
// destroyed gate; alternate magical/stealth passage needs its own confirmed
// route/marker and is not invented here.
function dbEntryObserve(d,visible){
 if(!d||d.location!=='stronghold'||!d.tower||d.tower.schema!==1)return;
 var l=dbLadderInit(d),entry=l.stages.entry,gate=d.assault&&d.assault.assets&&d.assault.assets.gate;
 if(!entry||!entry.discovered||entry.solved||!gate||gate.status!=='destroyed')return;
 // An untouched front aegis or seal is mechanically authoritative even when
 // narration erroneously imagines the dragon walking through an open gate.
 if(dbArcaneBlocker(d.arcaneFortress))return;
 var narrative=String(visible||'');
 var place=/\b(?:gatehouse|shattered (?:gateway|gates?|doors?|threshold)|broken (?:gates?|doors?)|ruined (?:entrance|gateway)|main (?:gates?|entrance)|interior passage|corridor|antechamber|anteroom|stone floor|inside the fortress)\b/i.test(narrative);
 if(!place)return;
 var lines=narrative.split(/[.!?\n]+/).map(function(x){return x.trim();}).filter(Boolean);
 var entered=lines.some(function(line){
  if(/\b(?:attempt|try|trying|tried|might|could|would|if|perhaps|maybe|imagines?|pretend|hope|intend|plan|cannot|can't|do not|don't|not yet|fail(?:ed)?|prevented|stopped|blocked|before|almost|about to)\b/i.test(line))return false;
  if(/\b(?:from|remain|still|wait|stand|pause)\b[^.!?\n]{0,45}\boutside\b/i.test(line))return false;
  return /\byou\b[^.!?\n]{0,95}\b(?:step|walk|stride|move|pass|cross|duck|squeeze|enter|advance|proceed|slip|climb)\b[^.!?\n]{0,55}\b(?:inside|into|through)\b/i.test(line) ||
   /\byou\s+(?:are|stand|now stand|have arrived)\s+(?:now\s+)?(?:fully\s+)?inside\b/i.test(line) ||
   // Saves upgraded after the crossing should reconcile when the narrator
   // again establishes the dragon's *current* location inside, without
   // requiring the player to redo the gatehouse crossing.
   /\byou\s+(?:are|stand|wait|remain|pause|prowl|move|walk|advance|continue)\b[^.!?\n]{0,55}\b(?:inside|within|in)\s+(?:the\s+)?(?:gatehouse|fortress|antechamber|anteroom|interior|inner passage|inner corridor)\b/i.test(line) ||
   /\bfrom\s+(?:inside|within)\s+(?:the\s+)?(?:gatehouse|fortress|antechamber|anteroom|interior)\b[^.!?\n]{0,70}\byou\b/i.test(line);
 });
 // A later Continue might describe only continued interior travel, rather
 // than another 'step inside'. Require two independent spatial details.
 if(!entered&&/\byou\s+(?:round|rounded|follow|followed)\s+the\s+(?:bend|interior corridor|passage)\b/i.test(narrative)&&
    /\b(?:passage|corridor)\s+(?:opens|leads)\s+into\s+(?:a\s+)?(?:wide\s+)?antechamber\b/i.test(narrative)&&
    !/\b(?:outside|imagine|perhaps|might|could|if you)\b/i.test(narrative))entered=true;
 if(!entered)return;
 entry.discovered=true;entry.solved=true;entry.method='force';entry.outcomeSource='narrative';entry.resolvedTurn=d.turn;
 d.fortress.cleared.perimeter='destroy';
 if(d.fortress.zone==='unknown'||d.fortress.zone==='approach')d.fortress.zone='perimeter';
 if(d.fortress.zonesSeen.indexOf('perimeter')<0)d.fortress.zonesSeen.push('perimeter');
 l.lastCommitTurn=d.turn;
 l.history.push({turn:d.turn,updates:'solved=entry/force (narrative)'});
 if(l.history.length>20)l.history.shift();
 console.log('[DB][LADDER] solved=entry/force (narrative)');
}

function dbProgressReconcile(d,visible){
 // Conservative existing-save reconciliation, NOT generic automatic progression.
 // Earlier discovery of a true surveillance gap plus a first-hand, hidden
 // position beneath the bridge looking at the next gatehouse establishes the
 // already-earned stealth approach. A later stage's name alone never does.
 if(!d.tower||d.tower.schema!==1||d.location!=='stronghold')return;
 var l=dbLadderInit(d),a=l.stages.approach,b=l.stages.entry,disc=l.discovery&&l.discovery.approach;
 if(!a||a.solved||!a.discovered||!b||!b.discovered||!disc||!disc.clues||!disc.clues.surveillance_gap)return;
 if(d.fortress.alert!==0||!dbDiscoveryObservedDirectly(d,visible))return;
 var t=String(visible||'');
 // Never infer from a quoted report, a speculative position or a defeat.
 if(/\b(?:perhaps|maybe|might|could|unclear|cannot tell|can't tell|uncertain|not sure|if you|if only|imagine|suppose|captured|captive|prisoner|escorted|under arrest|chains? around (?:your|the dragon)|guards? (?:caught|spotted|detected|seized|escorted)|the alarm (?:sounds|rings)|an alarm is raised|perimeter still (?:lies|remains) ahead)\b/i.test(t))return;
 var sentences=t.split(/[.!?\n]+/).map(function(s){return s.trim();}).filter(Boolean);
 var grounded=sentences.some(function(s){return /\b(?:beneath|under|below)\b.{0,65}\b(?:western (?:obsidian )?bridge|obsidian bridge|bridge|obsidian arch)\b/i.test(s)&&
    /\b(?:you|your|position|from your)\b/i.test(s)&&/\b(?:hidden|concealed|unseen|undetected|shelter|remain|rest|crouch)\b/i.test(s);});
 var nextStage=sentences.some(function(s){return dbDiscoveryContains(s,d.tower.challengeNodes.entry.place)||/\bgatehouse\b/i.test(s);});
 var stillSafe=(/\b(?:watchboats?|patrols?|mirrors?|surveillance|blind corridor)\b/i.test(t)&&
   /\b(?:no sign of alarm|without detection|undetected|unnoticed|regular patrol|normal patrol|established pattern|no (?:guards?|boats?) (?:have|has) (?:reacted|noticed|altered))\b/i.test(t))||
   !!disc.clues.patrol_timing; // two separately established, saved clues plus current hidden bridge observation
 if(!grounded||!nextStage||!stillSafe)return;
 a.discovered=true;a.solved=true;a.method='stealth';a.outcomeSource='reconciled';a.resolvedTurn=d.turn;
 l.lastCommitTurn=d.turn;l.history.push({turn:d.turn,updates:'solved=approach/stealth (reconciled)'});
 if(l.history.length>20)l.history.shift();
 console.log('[DB][LADDER] solved=approach/stealth (reconciled)');
}

function dbLadderPublicStatus(d){
 var l=dbLadderInit(d),known=d.location==='stronghold'||d.fortress.zonesSeen.length>0;
 if(!known)return '[TOWER CHALLENGES]\nThe stronghold has not yet been investigated. No inner layout or challenge secrets are known.';
 var seen=DB_LADDER_STAGES.map(function(s,i){var a=l.stages[s.id];return (i+1)+'. '+s.name+': '+(a.solved?'overcome ('+a.method+')':a.discovered?'investigating':'unresolved / not confirmed');});
 var count=DB_LADDER_IDS.filter(function(k){return l.stages[k].solved;}).length;
 return '[TOWER CHALLENGES] '+count+'/7 confirmed milestones\n'+seen.join('\n')+'\nStages are objectives, not mandatory rooms. A credible shortcut can solve or bypass several at once.';
}
function dbLadderDebug(d){
 var l=dbLadderInit(d),p=d.plot,t=dbGetFortProfile(d),lines=['[AUTHOR TOWER DEBUG — SPOILERS]',p.siteName,'Wizard: '+p.wizardName+' / '+p.wizardAim,'Facility: '+t.terrain];
 DB_LADDER_STAGES.forEach(function(s){var a=l.stages[s.id],o=dbGetLadderObstacle(d,s);lines.push(s.id+': '+o[0]+'; clue: '+o[1]+'; routes: '+o[2]+'; risk: '+o[3]+'; solved='+a.solved);});
 return lines.join('\n');
}
function dbLadderContext(d){
 var l=dbLadderInit(d),f=dbFortInit(d),area=DB_LADDER_AREA[f.zone]||'approach';
 var spec=DB_LADDER_STAGES.filter(function(s){return s.id===area;})[0]||DB_LADDER_STAGES[0];
 if(DB_LADDER_STAGES.every(function(s){return l.stages[s.id].solved;}))return ['ALL TOWER MILESTONES RESOLVED. Honor earned success; do not invent another barrier.'];
 if(l.stages[spec.id].solved){
  var current=DB_LADDER_IDS.indexOf(spec.id);
  var unsolved=DB_LADDER_STAGES.filter(function(s,i){return i>current && !l.stages[s.id].solved;});
  if(unsolved.length)spec=unsolved[0];
  else return ['CURRENT AREA SUCCESS ALREADY CONFIRMED. Do not repeat or revive its obstacle; honor the player’s progress and focus on the next natural objective.'];
 }
 var data=l.stages[spec.id],o=dbGetLadderObstacle(d,spec),site=dbGetFortProfile(d);
 return ['CHALLENGE LADDER: Seven concrete milestones across scouting, entry, intelligence, wardwork, opposing wizard, true captive and exit. Their order is FLEXIBLE. Neither an easy two-sentence rescue nor an arbitrary mandatory seven-room railroad. Do not invent extra barriers after legitimate success.',
  'FOCUS '+spec.name+' ['+spec.id+'] — '+spec.purpose+' Local obstacle: '+o[0]+'. Observable tell: '+o[1]+' Possible strategies: '+o[2]+' Consequence of failure: '+o[3]+' Resolution standard: '+spec.win,
  'SITE ADAPTATION: '+site.tell+' '+site.flaw+' Use these as specific evidence, not automatic exemptions or hidden counters. Defenders respond through the existing alert state. A stage may be solved early, out of order or by a compelling bypass; record it only AFTER a narrated confirmed success.',
  'DRAGON ASSAULT ROUTE: '+DB_LADDER_ASSAULT[spec.id],
  (spec.id==='approach'?'APPROACH SUCCESS STANDARD: If the dragon actually crosses the outer surveillance perimeter to safe cover at the site, the approach milestone is completed even if the gatehouse has NOT been entered. Honor this earned progress and emit the solved=approach marker. Merely spotting or approaching the perimeter is not success.':''),
  'PROGRESS: '+DB_LADDER_STAGES.map(function(s){return s.id+'='+ (l.stages[s.id].solved?'SOLVED':l.stages[s.id].discovered?'DISCOVERED':'UNCONFIRMED');}).join(', ')+'. Never reimpose a solved milestone without an explicitly established new counteraction.',
  'AFTER DISCOVERY only, output this exact marker: [DB_LADDER|discover='+spec.id+']. AFTER unequivocal solution, output ONE exact marker such as [DB_LADDER|solve='+spec.id+'|method=stealth]. Replace stealth with ONE actual method from force, stealth, diplomacy, magic, sabotage, trick, bypass, other. Multiple resolved stages can have separate markers. Never report attempts or hypothetical successes.'];
}

