 if(/\b(?:guards?|sentries?|defenders?)\b[^.!?\n]{0,130}\b(?:shout|shouts|yell|yells|cry|cries|sound|sounds)\b[^.!?\n]{0,100}\b(?:dragon|alarm|breach)\b|\b(?:SIGHTING! DRAGON|DRAGON AT THE MAIN GATE|a horn blares|the alarm sounds)\b/i.test(s)){
