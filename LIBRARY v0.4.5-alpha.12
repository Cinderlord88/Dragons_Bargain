function dbAssaultContext(d){
 var a=dbAssaultInit(d);if(!a)return [];
 var lines=['[DRAGON ASSAULT DEFENSES — generated at adventure creation or deterministically on existing-save upgrade; PRIVATE]',
  'MISSION: A king paid a DRAGON to recover the apparently kidnapped princess. A violent assault against the wizard and his hired fighters is a normal legitimate solution, not an automatic moral scandal. The fortress is defended because the wizard anticipates a dragon, not because the story requires stealth. No plot armor or infinitely respawning guards.'];
 DB_ASSAULT_KEYS.forEach(function(id){var x=a.assets[id];lines.push('PRESET '+id.toUpperCase()+': '+x.name+' at '+x.placement+'. Status='+x.status+(x.charges===null?'':'; remaining committed uses='+x.charges)+'. Coverage: '+x.coverage+'. Weakness: '+x.weakness+'. No effect outside coverage; a disabled, destroyed or exhausted asset CANNOT counter again.');});
 lines=lines.concat(dbThreatContext(d));
 lines.push('RESOLVE DIRECT ASSAULT: FIRST honor the actual registered dragon strength, breath and other powers; ordinary claws, teeth, mass and wings are physical anatomy. Describe real resistance and possible counterfire from PRESET equipment only if staffed, in range, ready and given time to act. A previously unseen weapon MUST have a visible or audible tell and a realistic opportunity to respond before it attacks; never retrofit a newly named weapon onto already observed personnel. Damage, casualties, breach and victory require an ACTUAL narrated outcome; no guaranteed hit, immunity, death or success from declared intent. A sufficient attack may destroy a door, guards, projector or whole wall. Never add a new anti-dragon force field after the hit.',
 'ESCALATION: Witnessed violence can trigger [DB_FORT|incident=dragon_sighted/breached_gate/major_attack]; reports and responding teams require credible time and routes. Only the wizard cares about his tower. Do not invent royal outrage, moral punishment or inevitable captive harm. If a real collapse threatens nearby people, describe the concrete danger and chance to act.',
 'AFTER clearly narrating an actual defense firing or its damage, append ONE marker per target as applicable: [DB_ASSAULT|target=sky|event=spent] or [DB_ASSAULT|target=gate|event=damaged/disabled/destroyed]. Use targets sky, breath, gate, reserve, wizard; events spent, damaged, disabled, destroyed, exhausted. spent consumes ONE charge for that target this action; never for aim, intent, threat or unrealized preparations. Do not assert damage to the dragon or casualties with these asset markers: no HP/combat resolution exists here.',
 '[/DRAGON ASSAULT DEFENSES]');
 return lines;
}
function dbAssaultCardText(d,id){
 var a=d.assault;if(!a||!a.assets)return '';
 var linked=id==='approach'?['sky']:id==='entry'?['gate','breath']:id==='intelligence'?['reserve']:id==='wardwork'?['breath']:id==='sanctum'?['wizard']:[];
 return linked.map(function(k){var x=a.assets[k];return x.status==='ready'&& (x.charges===null || x.charges===(k==='sky'?3:2))?'':' Previously engaged defense '+x.name+': '+x.status+(x.charges===null?'':', remaining uses '+x.charges)+'.';}).join('');
}

// ARCHMAGE FORTRESS v0.4.5-alpha.5: deterministic layered defenses.
// This module models *prepared objects and architecture*, not player powers,
// hit points, enemy attack rolls, or unconscious/captured player states.
// Mechanics > procedural narration. All defenses preexist; no retroactive
// counters to the player's successful actions and no omniscient response.
var DB_ARCANE_VERSION='1.0.0';
var DB_ARCANE_SPECIALTIES={
 archmage:{ward:'Sevenfold',trap:'Gravity Snare',construct:'Aegis-Golem',seal:'Circle of Seven Seals'},
 necromancer:{ward:'Ossuary',trap:'Life-Binding',construct:'Crypt-Golem',seal:'Mortuary Edict'},
 illusionist:{ward:'Mirror-Heart',trap:'False-Floor',construct:'Looking-Glass Golem',seal:'Prismatic Contract'},
 stormbinder:{ward:'Stormglass',trap:'Thunderbind',construct:'Tempest Golem',seal:'Storm Sigil'},
 fey_warlock:{ward:'Oathbound',trap:'Name-Binding',construct:'Thorn-Iron Golem',seal:'Hospitality Interdict'},
 alchemist:{ward:'Alchemical',trap:'Petrifying Vapor',construct:'Crucible Golem',seal:'Hermetic Lock'},
 oracle:{ward:'Star-Lens',trap:'Fate-Snare',construct:'Oracular Golem',seal:'Prophetic Threshold'},
 runekeeper:{ward:'Runic',trap:'Rune-Chain',construct:'Basalt Rune Golem',seal:'Glyph-Locked Threshold'}
};
function dbArcaneInit(d){
 if(!d||!d.plot)return null;
 if(d.arcaneFortress&&d.arcaneFortress.schema===1&&d.arcaneFortress.siteId===d.plot.siteId)return d.arcaneFortress;
 var t=d.tower||{},spec=DB_ARCANE_SPECIALTIES[d.plot.wizardId]||DB_ARCANE_SPECIALTIES.archmage;
 var material=t.materialName||'fortress stone',terrain=t.terrainName||'outer approach';
 // Existing adventures have already observed architecture; never add hidden
 // new gate defenses to an area already surveyed. Unvisited sections may
 // have old preparations described for the first time without rewriting canon.
 var legacy=d.turn>0,visited={};
 if(legacy&&d.ladder&&d.ladder.stages)Object.keys(d.ladder.stages).forEach(function(id){
  if(d.ladder.stages[id]&&(d.ladder.stages[id].discovered||d.ladder.stages[id].solved))visited[id]=true;
 });
 if(legacy&&d.fortress){
  var oldZone=DB_LADDER_AREA[d.fortress.zone];if(oldZone)visited[oldZone]=true;
 }
 function asset(id,stage,family,name,placement,coverage,effect,tell,counter,charges,dependencies){
  if(legacy&&(visited[stage]||stage==='approach'&&visited.entry))return;
  var a={id:id,stage:stage,family:family,name:name,placement:placement,coverage:coverage,effect:effect,tell:tell,counter:counter,
   weakness:counter,charges:charges,status:'ready',observed:false,dependencies:dependencies||[],lastTurn:-1};
  res.assets[id]=a;
 }
 var res={schema:1,version:DB_ARCANE_VERSION,siteId:d.plot.siteId,legacyUpgrade:legacy,
  doctrine:'formidable',assets:{},history:[],lastEventTurn:-1,pendingAction:null,
  routes:[
   {id:'threshold',from:'outside',to:'entry',kind:'physical',condition:'Braced physical gate plus localized magical seals; breaking the visible exterior wall is not automatically an interior doorway'},
   {id:'provision_way',from:'entry',to:'intelligence',kind:'physical',condition:'Real guarded service route; large dragon clearance must be evaluated'},
   {id:'maintenance_bypass',from:'entry',to:'wardwork',kind:'physical',condition:'Hidden service works; discover and reach a plausible opening before using'},
