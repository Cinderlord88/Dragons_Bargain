      ||/\byou\s+(?:are|'re)\s+(?:already\s+)?(?:well\s+)?clear\s+of\b[^;]{0,85}\b(?:bridge|causeway|span)\b/i.test(b)
      ||/\b(?:you|your dragon)\b[^;]{0,105}\b(?:fly|flies|flew|soar|soared|leap|leapt|jump|jumped|escape|escaped)\b[^;]{0,95}\b(?:clear of|away from|out of|off|above)\b[^;]{0,70}\b(?:bridge|causeway|span|collapsing|dropping)\b/i.test(b))result='escaped';
   else if(/\b(?:you|your dragon)\b[^;]{0,72}\b(?:skid|skids|fell|fall|falls|plunge|plunges|plunged|tumbled|tumbles|slip|slips)\b[^;]{0,75}\b(?:off|from|into)\b[^;]{0,75}\b(?:bridge|causeway|span|marsh|water)\b/i.test(b))result='fell';
   else if(/\b(?:winch|counterweight|tilting bridge|bridge|causeway)\b[^;]{0,110}\b(?:jams?|jammed|locks? in place|locked in place|stops? descending|stabilizes?|stabilized)\b/i.test(b))result='stabilized';
   if(result){bridge.status='resolved';bridge.outcome=result;bridge.resolvedGeneration=dbGenerationKey(d);
