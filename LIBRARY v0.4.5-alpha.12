// THE DRAGON'S BARGAIN — LIBRARY v0.4.5-alpha.12
// A standalone, dragon-protagonist spiritual companion to The Dragon's Due.
// v0.4.5-alpha.9: royal contract acceptance reconciliation across Do/Continue.
// v0.4.5-alpha.8: 30 wizard-captor plot twists, rescue stakes and tower hooks; 20 independent personality profiles.
// Existing Princess Valerie Story Card updated in place; existing princess roll preserved.
// API Advertisement (IMPLEMENTED):
//   Transport: local JS Library functions + state.dragonsBargain (schema 1).
//   API version: DB/1.0. Calls: dbInit(), dbInput(text), dbContext(text), dbOutput(text),
//   dbStatus(), dbReadCreation(text), dbGetPublicPlot(), dbFortPublicStatus(d),
//   dbTowerGenerate(d,princess,wizard), dbTowerCardList(d), dbTowerSyncCards(d).
//   Data: state.dragonsBargain.plot (private, stable per adventure), .character,
//   .clock, .outcomes, .revealed, .pending, .reply, .fluff.
//   Narrator -> script: [DB_TIME|hours=N|confidence=high],
//   [DB_REVEAL|princess], [DB_REVEAL|wizard], [DB_REVEAL|bargain],
//   [DB_OUTCOME|princess=missing/free/safe/dead],
//   [DB_OUTCOME|wizard=active/escaped/defeated/negotiated],
//   [DB_OUTCOME|bargain=pending/agreed/honored/disputed/renounced].
//   Archmage: dbArcaneInit(d), dbArcanePrepare(d,raw), dbArcaneContext(d),
//   dbArcaneObserve(d,raw), dbArcaneCurrentArea(d); [DB_ARCANE|target=ASSET_ID|event=...].
//   16 committed assets, layered gate wards, regional coverage, finite units, spatial routes.
//   Dragon assault: dbAssaultInit(d), dbAssaultContext(d), dbAssaultObserve(d,raw),
//   [DB_ASSAULT|target=sky/breath/gate/reserve/wizard|event=spent/damaged/disabled/destroyed/exhausted].
//   Fortress signals: [DB_FORT|zone=...], [DB_FORT|clear=...|method=...],
//   [DB_FORT|incident=...], [DB_FORT|standdown].
//   Inputs: #FORTRESS STATUS, #FORTRESS HELP; spoilers via #FORTRESS DEBUG.
//   Challenge ladder: #TOWER STATUS; [DB_LADDER|discover=...],
//   [DB_LADDER|solve=...|method=...]; optional #TOWER DEBUG.
//   Inputs: #BARGAIN STATUS, #BARGAIN HELP; spoilers via #BARGAIN DEBUG
//   only when DB_SETTINGS.allowSpoilerDebug is manually enabled.
//   Fluffiness: dbFluffInit(d), dbFluffAppearance(d), dbFluffMaybeSeed(d),
//   dbFluffContext(d). Cosmetic description and optional humor only.
//   ScriptBridge: PLANNED, NOT IMPLEMENTED. No cross-script private calls.
// Surge Protector alone registers and enforces supernatural abilities; optional
// MindRift remains independent. Scenario neither edits their registries nor state.

var DB_VERSION = '0.4.5-alpha.12';
var DB_SETTINGS = {allowSpoilerDebug:false, ambientInterval:4, ambientChance:0.34, fortressDifficulty:'challenging'};

// Thirty wizard-captor rescue twists. First 20 IDs and zero-based indices are
// retained for older adventure saves; the last ten are new. All are PRIVATE.
// The dragon is the hired rescuer, not the villain or presumed object of affection.
var DB_PRINCESS = [
  {
    "id": "secret_love",
    "label": "Secretly loved the wizard before the abduction",
    "truth": "Long before her disappearance, Valerie privately loved the celebrated court scholar who is now revealed as her captor. His betrayal wounded her deeply: he took her to force the king to surrender an old magical debt. She can still feel love and still reject his imprisonment; neither emotion cancels the other.",
    "cue": "A treasured letter to the former court scholar is hidden among sealed palace correspondence.",
    "stance": "Hurt and guarded toward the wizard; her prior affection makes his betrayal unusually personal.",
    "wizardAim": "The wizard holds Valerie as security for the Crown's disputed magical debt and will not release her until he gains payment or leverage."
  },
  {
    "id": "romance_open",
    "label": "Intrigued by the wizard, but held unwillingly",
    "truth": "Valerie was taken by a powerful wizard who claims an ancient bargain with the Crown. She finds his intellect and some of his arguments intriguing, and might eventually choose a personal relationship, but she never agreed to abduction or loss of liberty. His claim that she is a willing guest is an interested assertion, not settled truth.",
    "cue": "Her notes distinguish fascination with the wizard's scholarship from objections to his locked doors and guards.",
    "stance": "Curious and willing to listen, yet firm that she must be free to accept or reject the wizard's offer.",
    "wizardAim": "The wizard has seized Valerie to enforce a contested ancient covenant with the Crown, using her as collateral while negotiating its terms."
  },
  {
    "id": "dragon_fascination",
    "label": "Fascinated by the wizard's forbidden research",
    "truth": "Valerie spent years studying reports of the wizard's impossible experiments. After she discovered evidence that his work was powered by stolen minds, he abducted her to recover a copied research ledger and prevent the Crown from investigating. Her curiosity is about dangerous magic, not romantic interest in her captor.",
    "cue": "Her annotated treatise contains a missing appendix and references to subjects who were never released.",
    "stance": "Intellectually fearless but disgusted by the wizard's exploitation; she seeks proof that survives his attempts to erase it.",
    "wizardAim": "The wizard holds Valerie to reclaim an incriminating record of his forbidden experiments and silence a royal investigation."
  },
  {
    "id": "dragon_terror",
    "label": "Terrified of the wizard who took her",
    "truth": "Valerie witnessed the wizard turn royal guards into salt statues during a failed negotiation. He then abducted her and used controlled visions of that massacre to keep her terrified and compliant. His exterior courtesy cannot undo what she has seen, and her fear may complicate any attempt to negotiate safe passage.",
    "cue": "A servant remembers guards vanishing after the failed audience and identical salt deposits at the scene.",
    "stance": "Frightened of the wizard but determined not to abandon others; she needs patient, verifiable reassurance.",
    "wizardAim": "The wizard uses terror and captive witnesses to make the Crown relinquish its control of a strategic border seal."
