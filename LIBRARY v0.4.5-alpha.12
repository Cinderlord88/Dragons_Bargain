  }
 }
}
function dbThreatContext(d){
 var a=d.assault;if(!a||!a.threats)return [];
 var result=[],shot=a.threats.skyShot,bridge=a.threats.bridgeDrop;
 if(shot&&shot.status==='incoming')result.push(shot.volley?('PARTLY RESOLVED HARPOON VOLLEY: A previously fired harpoon cluster is still being resolved, NOT a fresh volley; ammo was spent only at its launch. Confirmed prior partial outcomes: hit='+!!shot.observedHit+', miss='+!!shot.observedMiss+'.'+(shot.injuryRegion==='wing'?' A wing '+(shot.injuryDescription||'strike')+' was already narrated; do not repeat or escalate this wound without a new, demonstrated hit.':'')+' Resolve only any still-undescribed projectiles. Do not invent extra bolts, injuries, HP loss, paralysis, or new shots. The bridge and gate are separate persistent objects.'): 'IN-FLIGHT DEFENSIVE SHOT: One defensive projectile was ALREADY FIRED and is traveling toward the dragon. It has already spent its launch resource. This is NOT a new shot: NEVER launch, reload, or spend it again on Continue. Resolve its trajectory by the dragon’s actual defense, terrain and narration: miss, deflection, or confirmed hit. No automatic injury, impalement, HP, paralysis or escape. The player must have a genuine chance to respond.');
 if(bridge&&bridge.status==='active')result.push('ACTIVE BRIDGE COLLAPSE: The established counterweight trap has ALREADY caused the causeway to tilt. The bridge is still dangerous and does not automatically reset on Continue. Let the dragon try to fly, cling, jump, jam the mechanism or fall. Close this immediate hazard ONLY when narration really confirms escape, fall, or stabilization; do not infer injuries. The bridge mechanism remains triggered even if the dragon escapes.');
 return result;
}
function dbAssaultStrip(s){return String(s||'').replace(/\[DB_ASSAULT\|target=(?:sky|breath|gate|reserve|wizard)\|event=(?:spent|damaged|disabled|destroyed|exhausted)\]/gi,'').trim();}
function dbAssaultObserve(d,raw){
 var a=dbAssaultInit(d);if(!a)return;
 var pat=/\[DB_ASSAULT\|target=(sky|breath|gate|reserve|wizard)\|event=(spent|damaged|disabled|destroyed|exhausted)\]/gi;
 var m,seen={},changes=[];
 while((m=pat.exec(String(raw||'')))!==null){
  var id=m[1].toLowerCase(),ev=m[2].toLowerCase(),k=id+'|'+ev,asset=a.assets[id];
  if(!asset||seen[k])continue;seen[k]=true;
  if(id==='gate'&&(ev==='damaged'||ev==='disabled'||ev==='destroyed')&&!dbArcaneAllowEntry(d,'force')){console.log('[DB][ASSAULT] rejected gate='+ev+' (intact frontal shield)');continue;}
  if(asset.status==='destroyed'||asset.status==='disabled'||asset.status==='exhausted')continue;
  if(ev==='spent'){
   if(asset.charges===null||asset.charges<=0||asset.lastGeneration===dbGenerationKey(d))continue;
   asset.charges--;asset.lastTurn=d.turn;asset.lastGeneration=dbGenerationKey(d);if(id==='sky'){asset.lastNarratedFiringInput=d.turn;dbThreatBeginShot(d,a,'explicit shot marker');}
   if(asset.charges===0)asset.status='exhausted';
   changes.push(id+'=spent remaining='+asset.charges);
  }else if(ev==='exhausted'){
   if(asset.charges===null)continue;
   asset.charges=0;asset.status='exhausted';changes.push(id+'=exhausted');
  }else{
   // Damage is not automatically destruction. Destroyed/disabled are persistent.
   asset.status=ev;changes.push(id+'='+ev);
  }
 }
 if(changes.length){
  a.lastEventTurn=d.turn;a.history.push({turn:d.turn,events:changes.join(' | ')});
  if(a.history.length>20)a.history.shift();console.log('[DB][ASSAULT] '+changes.join(' | '));
