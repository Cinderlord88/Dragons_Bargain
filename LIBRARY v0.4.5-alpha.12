// Private rescue stakes are independent of Valerie's randomized personality.
var DB_RESCUE_STAKES = {
  "secret_love": "Her former affection offers no safe way out: the wizard controls the wards, demands the king's relic, and has threatened consequences if she leaves. The dragon must secure her freedom or expose a way to invalidate the debt without treating her feelings as consent.",
  "romance_open": "A credible ancient debt could make negotiation meaningful, but the wizard still holds the princess against her will and can enforce his claim with guards and wards. The dragon must establish the covenant's real terms and win her actual freedom, not mistake polite conversation for an agreed release.",
  "dragon_fascination": "The captive possesses evidence of a dangerous magical crime, and the wizard plans to destroy it and alter her memories. Rescue requires freeing Valerie and preserving enough proof to stop further victims; her intellectual curiosity cannot make forced imprisonment harmless.",
  "dragon_terror": "Valerie remains a hostage to a mage who has demonstrated lethal power and used fear magic to restrain her. The dragon must counter the real coercion and get her clear before more royal subjects become bargaining demonstrations, not simply demand that she overcome her terror.",
  "all_dragons_evil": "She has been manipulated into distrusting the one creature hired to save her. The rescue remains urgent because the wizard holds her in custody and is preparing to fabricate royal abandonment; the dragon must expose the deception or offer independent proof without overriding her judgment by force.",
  "pragmatic_ally": "The princess can negotiate but cannot leave freely, and the wizard threatens thousands beyond the fortress. The dragon must secure Valerie's liberty and address the threatened villages or credible military leverage; simply winning the Warden's goodwill cannot end the hostage crisis.",
  "bloodline_sorceress": "The wizard cannot complete his planned ritual without Valerie's magical cooperation, but captivity and threats endanger her and the region. The dragon must break the coercion and prevent the nexus from opening under false conditions; no romantic or dynastic obligation to the wizard is implied.",
  "prince_charming": "The princess was deceived by a sorcerous impostor and imprisoned when she rejected him. A forged oath threatens both her freedom and the succession; the dragon must free her and neutralize the false betrothal rather than assume an apparently romantic history makes the wizard welcome.",
  "spoiled": "Valerie's unpleasant manners have no bearing on the severity of her captivity. The wizard holds her for royal concessions and is planning to move her; the dragon must find and extract her before the useful guard routines are lost, whether or not her temperament makes the rescue convenient.",
  "princess_mastermind": "Valerie engineered the first deception, but the wizard has betrayed her and established real coercive custody. The dragon must uncover both layers, prevent the wizard from taking the royal ward network, and offer the princess a genuine exit despite her responsibility for the crisis.",
  "dragon_mother": "Valerie is an adult dragon capable of flight in principle, but the wizard has magically bound her transformation and threatens her mother's secret. The rescue requires bypassing those seals and defusing blackmail; a second dragon's arrival does not automatically defeat the wizard's preparations.",
  "werewolf": "The wizard's extraction of power places Valerie in escalating danger, but a careless rescue could also expose innocents during a transformation. The dragon must break the siphon and arrange safe freedom rather than treating the wizard's fraudulent care as a benefit.",
  "power_behind_throne": "Valerie's earlier manipulation does not entitle the wizard to hold her and dismantle the Crown. The dragon must locate her, expose the betrayal, and protect the kingdom from fraudulent orders; success need not mean that Valerie escapes accountability for her own political decisions.",
  "fey_changeling": "The wizard's binding contract prevents Valerie leaving by her own choice despite the language of hospitality. The dragon must expose an actual loophole, reclaim the name, or break the pact's power source rather than accept the captor's claim of voluntary residence.",
  "self_rescue": "Valerie has a credible chance of freeing herself, but the wizard can move her beyond ordinary access at any time. The dragon still has a mission to reach, support, or safeguard her escape, and a fully earned independent escape should be honored rather than undone for the plot.",
  "body_double": "The actual captive is an innocent woman in immediate danger, and the real Valerie is risking herself to help. The dragon must identify and save the hostage, then clarify the deception with Aldric; the mistaken identity does not eliminate the rescue obligation or grant automatic completion.",
  "wizard_romance": "Valerie may choose whom she loves, but her wizard captor still controls her exit and demands a binding royal oath. The dragon must offer her a genuine safe choice and stop the coercive covenant; neither rescue nor romance compels her to return to the king against her informed wishes.",
  "apocalypse_infiltration": "A rescue that only removes Valerie while leaving a hostile-god summoning intact would abandon a catastrophic threat. The dragon must reach her and help stop the ritual, while preserving her ability to decide how she participates in confronting the wizard.",
  "rival_dragon_wizard": "The true antagonist is a powerful rival dragon who considers the princess property and has prepared counter-dragon wards. The hired rescuer must overcome or negotiate past a dangerous peer and restore the captive's freedom, not automatically win her affection or ownership.",
  "isekai_student": "The victim is an adult displaced into a royal body and now imprisoned by a wizard who intends dangerous experiments. Rescue requires stopping the soul-binding and investigating the identity of the original princess rather than assuming the present captive can be treated as a simple substitute.",
  "borrowed_years": "Valerie can appear physically unharmed while losing decades of life to the wizard's ritual. The dragon must reach her and halt or reverse the transfer before the last cycle, not accept the wizard's evidence that she is a comfortable and willing guest.",
  "shattered_timeline": "A endlessly repeated day is not release even if the princess appears well cared for. The dragon must identify the repeating interval and disable the anchor, securing Valerie's freedom without assuming that resetting the room resets consequences elsewhere.",
  "living_seal": "Valerie's captivity is real, yet an impulsive extraction could release a creature that threatens everyone. The dragon must learn how the seal works and substitute or destroy its source safely; the wizard's claim of necessity is not proof that permanent imprisonment is justified.",
  "reflection_decoy": "The wizard can manufacture convincing consent through a magical duplicate, while the actual princess is locked away. The dragon must detect the substitution and free the real captive before the false return deceives the Crown; the duplicate's own fate need not be reduced to a disposable prop.",
  "crown_plague": "The princess is genuinely ill and unable to leave safely, but the wizard caused the disease and controls the cure. The dragon must recover a real remedy and free her without spreading infection; destroying the tower without understanding the plague may worsen the crisis.",
  "dream_prison": "An apparently satisfied dream-ruler cannot consent to imprisonment she does not know exists. The dragon must reach her consciousness, reveal the waking world, and break the siphon so she can choose freely whether to wake and depart.",
  "stolen_true_name": "The wizard has stolen Valerie's means to identify and speak for herself while forging her agreement to captivity. The dragon must recover the two spell vessels and expose the false testimony; an apparently voluntary document cannot settle the matter.",
  "hostage_exchange": "Valerie may reject a rescue that abandons the other hostages, and she has an entirely reasonable motive. The dragon must find a way to free or protect the villagers and then escort the princess safely; no amount of rhetoric can turn a threat-backed exchange into voluntary captivity.",
  "sentient_tower_heir": "The princess has been selected by a magical structure but has not chosen to remain in its custody or obey the wizard. The dragon must free her and resolve the tower's claims without accidentally unleashing lethal structural changes on those inside.",
  "false_prophecy": "Valerie has been seized for something she has not done, based on a manipulated future prediction. The dragon must free her and uncover the forgery before the wizard commits irreversible violence, while keeping the story open to the princess's choices rather than a predetermined prophecy."
};

// Independent, public-facing temperament profiles (approximately 300 characters each).
// These do NOT select or reveal the secret princess twist. Stable in existing saves.
var DB_VALERIE_PERSONALITIES = [
  {
    "id": "measured",
    "text": "Valerie considers a problem before speaking, measuring the interests of everyone involved. She rarely raises her voice, but once committed she can be remarkably stubborn. Formal courtesy comes easily; trusting strangers does not. She remembers promises precisely and quietly notices when words and actions diverge."
  },
  {
    "id": "spirited",
    "text": "Valerie is energetic, outspoken, and quick to challenge anyone who treats her as ornamental. Her courage occasionally runs ahead of good judgment. She warms to candid people, despises condescension, and hates wasted time. When frightened she becomes brisk and practical rather than confessing how afraid she feels."
  },
  {
    "id": "compassionate",
    "text": "Valerie notices discomfort other people overlook and instinctively tries to reduce it. She listens carefully, even to people she distrusts, but her compassion is not gullibility. She can refuse a cruel bargain firmly and will take personal risks for someone vulnerable. Under pressure, her kindness becomes focused resolve."
  },
  {
    "id": "dry_witted",
    "text": "Valerie meets discomfort with a sharp, understated wit. Her humor is often a test of whether someone can tolerate being challenged. She dislikes grandstanding, values practical competence, and has little patience for flattery. Behind an amused expression she watches details closely and forms conclusions she seldom announces immediately."
  },
  {
    "id": "scholarly",
    "text": "Valerie approaches the world with an investigator’s curiosity. She asks precise questions, recalls obscure details, and dislikes explanations that collapse under scrutiny. Reading and discussion comfort her, but she is capable of decisive action when facts demand it. She knows that knowledge and judgment are not always the same thing."
  },
  {
    "id": "courtly",
    "text": "Valerie was trained to read a room before taking a position. She is gracious, perceptive, and very difficult to embarrass, using etiquette as both courtesy and defense. She may appear compliant while negotiating for room to maneuver. Her deepest loyalties are chosen privately, and she dislikes making promises she cannot keep."
  },
  {
    "id": "fiery",
    "text": "Valerie has a fierce sense of fairness and reacts quickly when someone abuses power. Her anger is vivid but seldom lasting; she apologizes when proved wrong. She prefers clear choices to evasive politics and respects people who stand by their principles. Patience is difficult for her, especially when others are endangered."
  },
  {
    "id": "guarded",
    "text": "Valerie gives away little until she understands who stands before her. She is observant, skeptical of easy assurances, and protective of her private life. Once trust is earned she shows quiet loyalty and occasional unexpected warmth. She dislikes being cornered emotionally and will ask for time rather than offer a false answer."
  },
  {
    "id": "inventive",
    "text": "Valerie instinctively looks for a third option when presented with two bad choices. She improvises, tinkers, and sees useful connections between unrelated things. Her enthusiasm can distract her from immediate dangers, though she learns quickly from mistakes. She respects resourcefulness far more than wealth or lofty titles."
  },
  {
    "id": "steadfast",
    "text": "Valerie is dependable and slow to abandon a person or cause once she has accepted responsibility for it. She faces discomfort without much complaint and expects others to do their share. Sudden change unsettles her, but she adapts through preparation and steady effort. Her calm should not be mistaken for submission."
  },
  {
    "id": "curious",
    "text": "Valerie is fascinated by unfamiliar customs, creatures, and ideas. She asks more questions than courtiers consider proper, often discovering truths through simple interest. Curiosity does not imply recklessness: she likes to understand risks before accepting them. Her delight in discovery survives even difficult circumstances."
  },
  {
    "id": "pragmatic",
    "text": "Valerie judges plans by their likely consequences rather than their elegance. She prefers useful allies, reliable information, and exits that actually work. Sentiment matters to her, but it rarely overrides immediate danger. She is candid about costs and can make unpopular decisions without pretending they are painless."
  },
  {
    "id": "idealistic",
    "text": "Valerie believes people can choose better than their reputations suggest. She responds strongly to courage and sincere principle, while hypocrisy disappoints her deeply. She sometimes grants second chances too easily, yet can become unexpectedly formidable when someone exploits her goodwill. She wants her actions to mean something."
  },
  {
    "id": "independent",
    "text": "Valerie insists on understanding and choosing her own course, even when others offer help with good intentions. She dislikes being treated as a prize, a bargaining chip, or someone else’s responsibility. She can cooperate generously when consulted honestly. Commands usually stiffen her resistance; reasons may persuade her."
  },
  {
    "id": "mischievous",
    "text": "Valerie enjoys harmless misdirection, private jokes, and finding small ways around excessive ceremony. Her playful manner hides a keen awareness of social power. She can turn serious in an instant when someone may be hurt. She admires quick thinking but loses respect for people whose cleverness is merely cruelty."
  },
  {
    "id": "deliberate",
    "text": "Valerie speaks slowly when choices carry consequences, preferring silence to a hasty promise. She organizes information carefully and dislikes being rushed into commitments. Her restraint can look like coldness, but she feels intensely and takes her responsibilities seriously. Once decided, she acts with striking persistence."
  },
  {
    "id": "bold",
    "text": "Valerie has a taste for difficult challenges and a tendency to stand her ground when others retreat. She enjoys testing her abilities and dislikes pity. That confidence can blind her to subtle danger, though she is capable of learning humility. She respects courage in many forms, including the courage to admit a mistake."
  },
  {
    "id": "sensitive",
    "text": "Valerie notices shifts in tone, expressions, and atmosphere that others miss. Praise and criticism affect her more than she lets on, but she will not trade her judgment for approval. She is drawn to music, stories, and quiet places. In a crisis her attention to people’s feelings can reveal motives others overlook."
  },
  {
    "id": "skeptical",
    "text": "Valerie believes remarkable claims deserve evidence, especially when made by powerful people. She is neither cynical nor closed-minded; good proof can change her mind quickly. She asks pointed questions and dislikes ceremonial evasions. Once someone earns her confidence, she will defend them against unfair suspicion."
  },
  {
    "id": "dutiful",
    "text": "Valerie takes obligations seriously but distinguishes duty from blind obedience. She worries about the consequences her choices have for servants, family, and ordinary citizens. Privately she envies people who seem free to act without consequence. When competing duties collide, she struggles openly before making her decision."
  }
];
var DB_VALERIE_CARD_BASE = 'Princess Valerie is Aldric’s adult daughter, publicly believed held by a dangerous wizard. She makes her own choices. Her true circumstances and even the identity of the captive depend on the hidden scenario; do not assume romance, obedience, or willingness to stay.';
var DB_VALERIE_STOCK_TEXTS = ["Princess Valerie is King Aldric's adult daughter, publicly reported as a wizard's captive. Her apparent identity, motives, species, abilities, disposition toward the dragon, and even whether the captive is truly Valerie depend on the scenario's privately saved princess roll. She may be resourceful, frightened, politically calculating, loving, deceptive, or something stranger. Reveal only credible clues in play. Rescue does not imply romance, gratitude, obedience, or marriage.", "Valerie is Aldric's adult daughter, publicly believed captive to a dangerous wizard. She has intelligence, preferences, ambitions and a life independent of the dragon. Her true situation and disposition are rolled privately once by the scenario director, not fixed by this Story Card. Never assume she is helpless, romantically attracted, human, cooperative or even the real captive until evidence establishes it. Her outward behavior must remain consistent with the hidden procedural truth.", "Princess Valerie is Aldric's adult daughter, publicly believed held by a dangerous wizard. She makes her own choices. Her true situation depends on the hidden scenario; a dragon's rescue never guarantees obedience, romance, or return.\nPersonality: A stable independent temperament is selected at initialization and inserted here by the director; do not treat this placeholder as a personality.", "Princess Valerie is Aldric’s adult daughter, publicly believed held by a dangerous wizard. She makes her own choices. Her true circumstances and even the identity of the captive depend on the hidden scenario; do not assume romance, obedience, or willingness to stay."];
function dbValerieProfile(d){
 var p=d.plot||(d.plot={}),list=DB_VALERIE_PERSONALITIES;
 var found=list.filter(function(x){return x.id===p.personalityId;})[0];
 if(!found){
  // Stable hash; unlike dbPick, it does not consume the generator's RNG or reroll anything.
  var h=((d.seed>>>0)^0x6a09e667)>>>0;
  h=Math.imul((h^(h>>>16)),0x7feb352d)>>>0;
  h=Math.imul((h^(h>>>15)),0x846ca68b)>>>0;
  h=(h^(h>>>16))>>>0;
  found=list[h%list.length];p.personalityId=found.id;
 }
 p.personalityText=found.text;
 if(!p.princessRescue||typeof p.princessRescue!=='string')p.princessRescue=DB_RESCUE_STAKES[p.princessId]||'The Crown still needs the captive located, her real situation verified, and any coercion or danger addressed.';
 return found;
}
function dbValerieCardSync(d){
 if(typeof storyCards==='undefined'||!Array.isArray(storyCards)||typeof updateStoryCard!=='function')return {status:'unavailable'};
 var v=dbValerieProfile(d),index=-1;
 for(var i=0;i<storyCards.length;i++)if(storyCards[i]&&String(storyCards[i].title||'').trim().toLowerCase()==='princess valerie'){index=i;break;}
 if(index<0)return {status:'missing'}; // never create a duplicate princess card
 var old=storyCards[index];
 var prior=typeof old.entry==='string'?old.entry:typeof old.value==='string'?old.value:'';
 var originalBase=prior.replace(/\n?Personality \(director-selected\):[^\n]*/g,'').trim();
 // Match the two shipped default cards and the new template; preserve user additions.
 var template=null;for(var j=0;j<DB_VALERIE_STOCK_TEXTS.length;j++){
  if(originalBase.indexOf(DB_VALERIE_STOCK_TEXTS[j])===0){template=DB_VALERIE_STOCK_TEXTS[j];break;}
 }
 if(!template)return {status:'custom-preserved'};
 var userAddition=originalBase.slice(template.length).trim();
 var desired=DB_VALERIE_CARD_BASE+(userAddition?'\n'+userAddition:'')+'\nPersonality (director-selected): '+v.text;
 if(prior===desired)return {status:'unchanged'};
 var keys=old.keys||'Princess Valerie, Valerie';
 var description=old.description===prior?desired:(old.description||desired);
 try{
  var result=updateStoryCard(index,keys,desired,old.type||'character',old.title||'Princess Valerie',description);
  if(result===false)return {status:'failed'};
  console.log('[DB][PRINCESS CARD] personality='+v.id+' updated');
  return {status:'updated',id:v.id};
 }catch(err){console.log('[DB][PRINCESS CARD] update failed '+String(err));return {status:'failed'};}
}

