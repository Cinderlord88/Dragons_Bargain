    /\b(?:you|your (?:massive )?(?:form|body))\s+(?:enter|slip|slide|squeeze|crawl|step|move|pass|stand|are)\w*\s+(?:into|inside|through|within)\b/i.test(line);
 });
 if(!confirmed&&!(/\byou (?:halt|stop|stand|move) (?:just )?inside the (?:tunnel )?entrance\b/i.test(prose)&&/\b(?:maintenance (?:ladder|accessway)|tunnel)\b/i.test(prose)&&/\bbridge\b/i.test(prose)))return;
 f.zone='perimeter';d.location='stronghold';
 if(f.zonesSeen.indexOf('perimeter')<0)f.zonesSeen.push('perimeter');
