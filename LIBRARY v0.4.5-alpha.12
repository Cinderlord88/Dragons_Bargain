 }
 if(!f.knownBridgeService||!route.test(input)||!/\b(?:enter|slip|squeeze|move|crawl|step|follow)\b/i.test(input))return;
 if(/\b(?:back out|retreat|(?:still|remain) outside (?:the (?:fortress|bridge|tunnel(?: mouth| entrance)?))|cannot fit|can't fit|too narrow for you|shoulders jam)\b/i.test(prose))return;
 var confirmed=prose.split(/[.!?\n]+/).some(function(line){
