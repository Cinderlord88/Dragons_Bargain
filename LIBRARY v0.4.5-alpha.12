    "custody": "The ritual archive contains hidden copied chants and an active containment circle nearing its appointed hour.",
    "thread": "Valerie entered to expose the wizard, but an independent genuine magical prison now blocks her exit.",
    "pressure": "The summoning approaches completion, and the wizard plans to force the captive to authorize the final invocation."
  },
  "rival_dragon_wizard": {
    "custody": "Hoard inventories and oversized dragon marks reveal that the supposed mage is a rival draconic captor.",
    "thread": "The wizard's identity and dragon-proofed defenses are linked; a rescue may become dragon against dragon.",
    "pressure": "The rival threatens to seal the princess deeper in a hoard pocket if the intruding dragon approaches."
  },
  "isekai_student": {
    "custody": "A hidden notebook contains modern technical sketches and evidence that the wizard is probing the captive's memories.",
    "thread": "A displaced soul is inhabiting the princess, and the wizard is preparing an involuntary magical experiment.",
    "pressure": "The wizard's next examination may destroy evidence of where Valerie's original consciousness went."
  },
  "borrowed_years": {
    "custody": "A silent life-clock and sealed treatment records measure years stolen without requiring visible wounds.",
    "thread": "The captive's future lifespan, not her present blood, is being harvested to sustain the archmage.",
    "pressure": "The wizard accelerates the siphon when he fears the dragon will reach the custody chamber."
  },
  "shattered_timeline": {
    "custody": "The princess's chamber contains scratched calendars and a temporal anchor hidden behind the same morning scene.",
    "thread": "The wizard can repeat the interrogation while the real outside world continues toward its deadline.",
    "pressure": "If the dragon is pulled into the loop, the wizard can interrogate both indefinitely unless the anchor is broken."
  },
  "living_seal": {
    "custody": "A royal-sigil dais sits above the prison chamber with sockets for a concealed replacement focus.",
    "thread": "Removing the prisoner before replacing the living seal would release a dangerous trapped entity.",
    "pressure": "The wizard threatens to loosen the seal if anyone questions his need to keep Valerie confined."
  },
  "reflection_decoy": {
    "custody": "A gallery of reflective custody chambers contains one living captive and one fabricated royal double.",
    "thread": "The apparently willing princess is a manufactured double, not reliable testimony about the original woman's wishes.",
    "pressure": "The wizard intends to deliver the simulacrum to Aldric and leave the real Valerie permanently behind glass."
  },
  "crown_plague": {
    "custody": "A quarantined suite adjoins protected reagent stores, with diagnostic notes contradicting the wizard's public account.",
    "thread": "The wizard's quarantine sounds protective but his own agents introduced the dangerous contagion.",
    "pressure": "The wizard threatens to withdraw medicine unless Aldric signs away the royal healing relic."
  },
  "dream_prison": {
    "custody": "The custody room holds a protected sleeper and a scrying window onto a counterfeit royal palace.",
    "thread": "The princess seems happy inside a world assembled by the wizard, but her memories and freedom were stolen.",
    "pressure": "The dream kingdom shifts its rules when the captive begins to suspect the truth, concealing her exit."
  },
  "stolen_true_name": {
    "custody": "Two separate warded reliquaries hold the victim's voice and name beside a forged consent record.",
    "thread": "The prisoner cannot speak freely and the apparent declaration of willingness is manufactured.",
    "pressure": "The wizard will complete the false deposition at the next ritual hearing unless both vessels are reclaimed."
  },
  "hostage_exchange": {
    "custody": "An overlooked prison annex holds villagers whose lives were traded for the princess's alleged hospitality.",
    "thread": "The princess's refusal to leave is a deliberate attempt to protect other prisoners, not endorsement of her captor.",
    "pressure": "The wizard will retaliate against villagers if the dragon extracts Valerie without securing them first."
  },
  "sentient_tower_heir": {
    "custody": "A shifting custody wing bears the princess's seal beside abandoned succession tablets for the living tower.",
    "thread": "The tower chose her, but the wizard kidnapped her to usurp a role he cannot claim by force.",
    "pressure": "The tower may seal routes and the wizard may threaten its heart if Valerie resists the transfer of control."
  },
  "false_prophecy": {
    "custody": "A prophecy archive contains a forged first edition and an older authentic omen that contradicts it.",
    "thread": "The wizard's supposed certainty rests on a manipulated prediction rather than reliable knowledge.",
    "pressure": "The wizard prepares a preemptive binding or sacrifice before the foretold date even though the omen is false."
  }
};
var DB_TOWER_WIZARD_HOOKS={
 archmage:'Concentric war sigils and finite spell reservoirs support the command center.',
 necromancer:'Mortuary labels and guarded ossuary passages reveal undead servicing routines.',
 illusionist:'Painted perspective lines and imperfect doubles betray the false corridors.',
 stormbinder:'Stormglass capacitor housings discharge after a predictable sequence.',
 fey_warlock:'Guest lists and oath plaques define who is admitted through certain doors.',
 alchemist:'Vent pipes and sealed reagent carts connect the experiments to service halls.',
 oracle:'Rotating divination lenses require periodic realignment and human attendants.',
 runekeeper:'Inscribed keystones and service runes connect guardian constructs to the ward network.'
};
function dbTowerException(material,terrain,shape){
 var cases={
  'wood|volcano':'Cooling runes and a water-fed root cistern keep the living wood from burning; their water supply is finite.',
  'ice|volcano':'A maintained inversion enchantment preserves the ice over volcanic heat; its rune anchors and power reserve can fail.',
  'ice|desert':'Night-charged cold crystals preserve the ice under desert sun; prolonged sunlight drains their stored power.',
  'wood|desert':'Deep aquifer wells supply the living roots beneath the dunes; damaged pumps jeopardize the tower’s regrowth.',
  'iron|swamp':'Alchemical varnish protects the iron from marsh corrosion; the coating must be renewed at exposed joints.',
  'crystal|forest':'Foresters regularly prune canopy openings to maintain the prism sightlines; the lenses are vulnerable when overgrown.'
 };
 var contradiction=cases[material.id+'|'+terrain.id]||'';
 if(shape.id==='floating')contradiction+=(contradiction?' ':'')+'Anchoring pylons maintain the levitation; they are physical, limited and serviceable.';
 return contradiction;
}
function dbTowerPickUnique(d,items){var a=dbPick(d,items),b=dbPick(d,items);if(a===b)b=items[(items.indexOf(a)+1)%items.length];return [a,b];}
function dbTowerGenerate(d,princess,wizard){
 // Called only AFTER the princess roll, and only for a freshly generated plot.
 var pre=dbPick(d,DB_TOWER_PREFIX),noun=dbPick(d,DB_TOWER_NOUN),suf=dbPick(d,DB_TOWER_SUFFIX);
 var pattern=Math.floor(dbNextRandom(d)*3);
 var name=pattern===0?'The '+pre+' '+noun:pattern===1?'The '+noun+' of '+suf:'The '+pre+' '+noun+' of '+suf;
 var material=dbPick(d,DB_TOWER_MATERIALS),terrain=dbPick(d,DB_TOWER_TERRAINS),shape=dbPick(d,DB_TOWER_SHAPES),origin=dbPick(d,DB_TOWER_ORIGINS);
 var decor=dbTowerPickUnique(d,DB_TOWER_DECOR),twist=DB_TOWER_TWISTS[princess.id],exception=dbTowerException(material,terrain,shape);
 var nodes={};var stageKeys=['approach','entry','intelligence','wardwork','sanctum','captive','extraction'];
 var sigils=['Oth','Veyn','Kyr','Mora','Thael','Iss','Fen','Var','Eld','Sarn','Quen','Draal'];
 for(var i=0;i<stageKeys.length;i++){
  var id=stageKeys[i],variants=DB_TOWER_STAGE_VARIANTS[id],chosen=dbPick(d,variants),token=sigils[(dbHash(d.seed+'|'+id+'|'+name)+i)%sigils.length];
  var place=token+' '+DB_TOWER_STAGE_LABELS[id];
  var deps=id==='approach'?[]:id==='entry'?['approach']:id==='intelligence'?['entry']:id==='wardwork'?['entry','intelligence']:id==='sanctum'?['wardwork','intelligence']:id==='captive'?['intelligence','wardwork']:['captive'];
  nodes[id]={id:id,place:place,obstacle:chosen[0],tell:chosen[1],approaches:chosen[2],risk:chosen[3],dependencies:deps,discovered:false};
 }
 // Structural solutions stay possible regardless of princess plot. Plot hooks add
 // strategic context; they never silently make rescue physically impossible.
 nodes.approach.tell+=' Setting: '+terrain.approach+'.';
 nodes.entry.tell+=' Construction: '+material.look+'.';
 nodes.wardwork.tell+=' Power medium: '+material.ward+'.';
 nodes.extraction.approaches+=' Terrain alternative: '+terrain.route+'.';
 nodes.captive.tell+=' Privately controlled custody procedures differ from visitor routes.';
 nodes.wardwork.tell+=' '+(DB_TOWER_WIZARD_HOOKS[wizard.id]||'Guarded arcane equipment requires maintenance.');
 nodes.sanctum.tell+=' '+(DB_TOWER_WIZARD_HOOKS[wizard.id]||'The wizard’s finite preparations leave evidence.');
 if(princess.id==='apocalypse_infiltration')nodes.sanctum.tell+=' An unusual alignment engine is running near the private study.';
 if(princess.id==='rival_dragon_wizard')nodes.approach.tell+=' Some scoring on the stone suggests unusually massive claws.';
 if(princess.id==='self_rescue')nodes.captive.tell+=' Minor evidence suggests someone inside has already been testing the locks.';
 if(princess.id==='princess_mastermind')nodes.intelligence.tell+=' Several sealed orders appear to come from sources outside the wizard’s staff.';
 var schema=1;
 return {schema:schema,name:name,material:material.id,materialName:material.name,materialLook:material.look,
  terrain:terrain.id,terrainName:terrain.name,shape:shape.id,shapeName:shape.name,
  decorations:decor,origin:origin.name,history:origin.detail,feature:shape.feature,routes:shape.routes,exception:exception,
  strongpoint:material.property,wardMedium:material.ward,weakness:shape.id==='floating'?'anchoring pylons and suspended-service couplings; '+material.flaw:material.flaw,
  approach:terrain.approach,sky:terrain.threat,alternate:terrain.route,
  wizardId:wizard.id,twistId:princess.id,plotHooks:{custody:twist.custody,thread:twist.thread,pressure:twist.pressure},
  challengeNodes:nodes,alternatePaths:[{from:'approach',to:'intelligence',route:terrain.route,approach:'Discovery of service access'},{from:'entry',to:'wardwork',route:shape.routes,approach:'Learning the tower’s internal maintenance scheme'}],cardSync:{attempted:{},confirmed:{},lastAttemptTurn:-1}};
}
function dbGetFortProfile(d){
 if(!d.tower||d.tower.schema!==1)return DB_FORT_PROFILES[d.plot.siteId]||DB_FORT_PROFILES.glass_tower;
 var t=d.tower,n=t.challengeNodes;
 return {terrain:t.name+' '+t.terrainName+'. '+t.approach+'. '+t.shapeName+' rises from '+t.materialName+'.',
  sky:t.sky,perimeter:n.entry.obstacle+': '+n.entry.tell,
  garrison:'Living staff, guards, ward technicians and servants use '+n.intelligence.place+'. '+n.intelligence.tell,
  ward:n.wardwork.obstacle+': '+n.wardwork.tell+' '+t.wardMedium+'.',
  custody:'The prisoner’s accommodations are in '+n.captive.place+' beyond '+n.captive.obstacle+'. '+n.captive.tell,
  escape:n.extraction.obstacle+'. '+t.alternate+'. '+n.extraction.approaches,
  flaw:t.weakness+'; '+n.wardwork.approaches,
  tell:t.decorations.join(' and ')+' mark '+t.name+'. '+n.entry.tell};
}
function dbGetFortTrap(d){
 if(!d.tower||d.tower.schema!==1)return DB_FORT_TRAPS[d.plot.siteId]||DB_FORT_TRAPS.glass_tower;
 var t=d.tower,n=t.challengeNodes;
 return {name:n.entry.obstacle,zone:'perimeter',tell:n.entry.tell,effect:n.entry.risk,counter:n.entry.approaches};
}
function dbGetLadderObstacle(d,spec){
 if(!d.tower||d.tower.schema!==1)return spec.obstacles[d.ladder.stages[spec.id].variant];
 var n=d.tower.challengeNodes[spec.id];return [n.obstacle,n.tell,n.approaches,n.risk];
}
function dbTowerCardList(d){
 if(!d.tower||d.tower.schema!==1)return [];
 var t=d.tower,f=d.fortress||{zone:'unknown'},l=d.ladder,stageOrder=['approach','entry','intelligence','wardwork','sanctum','captive','extraction'];
 var cards=[],siteKey=t.name.replace(/^The /,'');
 function add(id,title,keys,entry){cards.push({id:id,title:'DB Tower: '+title,keys:keys,entry:entry,type:'DBTower',marker:'DB_TOWER_1|'+d.seed+'|'+id});}
 add('overview',t.name,t.name,'The fortress is '+t.shapeName+' constructed mainly of '+t.materialName+' ('+t.materialLook+'), '+t.terrainName+'. Decorations: '+t.decorations.join(' and ')+'. Origin: '+t.origin+'. '+t.history+'. '+(t.exception||'')+' A real staffed stronghold; old work and newer wards share the structure.');
 stageOrder.forEach(function(id){var n=t.challengeNodes[id],stage=l&&l.stages[id],known=stage&&stage.discovered,solved=stage&&stage.solved;
  var knownProfile=l.discovery&&l.discovery[id],clue=knownProfile&&knownProfile.clues.surveillance_gap?' Player-observed clue: some surveillance angles have exploitable gaps.':'';
  var observed=knownProfile&&knownProfile.confirmedFeatures||[];
  var knownDetails=observed.map(function(x){return {boats:'watchboats',mirrors:'reflective surveillance equipment',watch:'guards and patrols',alarm:'visible alarm measures',scanning:'organized scanning',generated:'generated tower-specific defenses'}[x.slice(8)]||'';}).filter(Boolean).join(', ');
  var current=solved?'The known obstacle has already been overcome by '+stage.method+'. Do not restore it without an established repair.':known?(stage.discoverySource==='signature'?'The observed security feature includes '+(knownDetails||'defended exterior approaches')+'. Further hidden mechanisms remain unknown.':'The observed security feature is '+n.obstacle+'. '+n.tell)+clue:(id==='approach'?'The exterior route is visible from afar.':'Only the external character of this section is known before exploration.');
  add(id,n.place,n.place,'A part of '+t.name+'. Architectural setting: '+(id==='approach'?t.approach:id==='entry'?t.materialLook:id==='extraction'?t.alternate:t.feature)+'. '+current+dbKnowledgeCardText(d,id)+dbAssaultCardText(d,id)+dbArcaneCardText(d,id));
 });
 add('garrison','Tower Personnel of '+siteKey,'the '+siteKey+' watch roster', 'The tower employs guards, specialists, cooks, couriers, and servants with distinct responsibilities and finite information. Reports travel via messengers and signal relays; no defender is omniscient. Staff retain independent motives.');
 add('machinery','Works of '+siteKey,'the '+siteKey+' maintenance works','The tower’s infrastructure depends on '+t.wardMedium+'. Real maintenance crews use '+t.routes+'. Repair requires time, parts, and access. An earned disabled defense stays out of service until repairs are actually established.');
 return cards;
}
function dbTowerSyncCards(d){
 // Story Cards are an optional persistence/readability mirror, never the authority.
 // Safety: no mass mutation, no reuse of untrusted indices, no retries on stale snapshots.
 if(!d.tower||d.tower.schema!==1)return {status:'legacy',created:0,updated:0};
 var t=d.tower,s=t.cardSync||(t.cardSync={attempted:{},confirmed:{},lastAttemptTurn:-1});
 if(typeof storyCards==='undefined'||!Array.isArray(storyCards)||typeof addStoryCard!=='function')return {status:'unavailable',created:0,updated:0};
 var cards=dbTowerCardList(d),created=0,updated=0,failed=0;
 for(var i=0;i<cards.length;i++){
  var c=cards[i],idx=-1;
  for(var j=0;j<storyCards.length;j++){var sc=storyCards[j];if(sc&&sc.type==='DBTower'&&sc.description===c.marker){idx=j;break;}}
  if(idx>=0){
   s.confirmed[c.id]=true;
   var prior=storyCards[idx];
   var priorText=typeof prior.entry==='string'?prior.entry:prior.value;
   if((priorText!==c.entry||prior.keys!==c.keys)&&typeof updateStoryCard==='function'){
    try{updateStoryCard(idx,c.keys,c.entry,c.type,c.title,c.marker);updated++;}catch(err){failed++;console.log('[DB][TOWER CARDS] update '+c.id+' failed '+String(err));}
   }
  }else if(!s.attempted[c.id]){
   // Mark before API call to ensure one attempt, even if card list updates late.
   s.attempted[c.id]=true;
   try{var result=addStoryCard(c.keys,c.entry,c.type,c.title,c.marker);if(result===false)failed++;else created++;}
   catch(err){failed++;console.log('[DB][TOWER CARDS] add '+c.id+' failed '+String(err));}
  }
 }
 return {status:failed?'partial':'ok',created:created,updated:updated,failed:failed,total:cards.length};
}

function dbTowerLivingEvents(d){
 if(!d.tower||d.tower.schema!==1)return DB_AMBIENT.stronghold;
 var t=d.tower;
 return [
  ['twr-shift','A watch shift changes near '+t.challengeNodes.entry.place+'; the relief squad knows only its recent reports.'],
  ['twr-repairs','A maintenance crew carries supplies for the '+t.wardMedium+' near '+t.challengeNodes.wardwork.place+'.'],
  ['twr-custody','A food steward brings a sealed tray toward '+t.challengeNodes.captive.place+' under ordinary guard supervision.'],
  ['twr-experiment','A controlled magical experiment produces an unexpected sound and a visible plume above '+t.challengeNodes.sanctum.place+'.'],
  ['twr-terrain','A mundane shift in the terrain changes visibility: '+t.approach+'.'],
  ['twr-supply','A cargo delivery must navigate '+t.routes+'; its workers argue about missed schedules.'],
  ['twr-signal','An ordinary staff dispute sends a messenger between '+t.challengeNodes.intelligence.place+' and '+t.challengeNodes.entry.place+'.']
 ];
}
function dbTowerCardStatus(d){
 if(!d.tower)return '[TOWER CARDS] Legacy stronghold: no procedural cards required.';
 var s=d.tower.cardSync,attempted=Object.keys(s.attempted||{}).length;
 var confirmed=0;if(typeof storyCards!=='undefined'&&Array.isArray(storyCards)){
  var arr=dbTowerCardList(d);for(var i=0;i<arr.length;i++)if(storyCards.some(function(x){return x&&x.type==='DBTower'&&x.description===arr[i].marker;}))confirmed++;
 }
 return '[TOWER CARDS] Generated '+dbTowerCardList(d).length+' records; attempted creation '+attempted+'; currently visible in script snapshot '+confirmed+'. The generator stays authoritative even if AI Dungeon does not expose cards to this script. No automatic duplicate-creation retries.';
}

function dbTowerContext(d){
 if(!d.tower||d.tower.schema!==1)return [];
 var t=d.tower,f=dbFortInit(d),zone=DB_LADDER_AREA[f.zone]||'approach',n=t.challengeNodes[zone]||t.challengeNodes.approach;
 var lines=['GENERATED TOWER CANON: '+t.name+', '+t.shapeName+' of '+t.materialName+' '+t.terrainName+'. '+t.materialLook+'; '+t.decorations.join(', ')+'. History: '+t.history+'. '+(t.exception||'')+' Build coherent descriptions; do not substitute one of the old preset sites.',
 'CURRENT GENERATED FEATURE: '+n.place+'. Obstacle '+n.obstacle+'. Observable tell '+n.tell+'. Possible methods '+n.approaches+'. Risk '+n.risk+'. The challenge exists from creation, not improvised on demand.',
 'HIDDEN RESCUE MOTIVE: '+(d.plot&&d.plot.princessRescue||'Find the captive and resolve the danger without taking her agency away.'),
 'HIDDEN PRINCESS-DEPENDENT FORTRESS THREAD: '+t.plotHooks.thread+' Custody details: '+t.plotHooks.custody+' Opponent pressure: '+t.plotHooks.pressure+' Provide discoverable clues, never automatically disclose or declare her wishes.',
 'OPTIONAL CONNECTORS (not automatic shortcuts): '+t.alternatePaths.map(function(x){return x.from+' to '+x.to+' via '+x.route;}).join(' | ')+'. Discover their physical access before use.',
 'Generated sections have unique names for targeted Story Card retrieval. Use '+n.place+' naturally when actually near it; do not enumerate all seven names in player dialogue. Story Cards are a mirror; saved state is authoritative.'];
 return lines;
}

function dbGenerate(d){
  var princess=dbPick(d,DB_PRINCESS),wizard=dbPick(d,DB_WIZARDS),aim=dbPick(d,DB_AIMS),comp=dbPick(d,DB_COMPLICATIONS),territory=dbPick(d,DB_TERRITORIES),ally=dbPick(d,DB_COURT);
  // Princess is authoritative BEFORE tower construction; its selected twist influences
  // initial challenges and custody. The generated tower is stored once on this save.
  d.tower=dbTowerGenerate(d,princess,wizard);
  var site={id:'procedural_'+d.seed,name:d.tower.name,approach:d.tower.approach,
   defenses:d.tower.sky+'; '+d.tower.wardMedium,weakness:d.tower.weakness};
  var gold=10000+Math.floor(dbNextRandom(d)*9)*2500; // 10,000–30,000 crowns
  var days=12+Math.floor(dbNextRandom(d)*19); // 12–30 day threat horizon
  var objective=princess.wizardAim||aim.label,identity=wizard.name,means=wizard.method;
  // The wizard's motive MUST match this princess scenario. A fully random,
  // unrelated aim used to contradict the chosen secret plot.
  if(princess.id==='rival_dragon_wizard'){
    identity='a rival dragon masquerading as '+wizard.name;
    means='draconic shapeshifting, hoard wards and '+wizard.method;
  }
  d.plot={princessScenarioRevision:3,princessId:princess.id,princessLabel:princess.label,princessTruth:princess.truth,princessCue:princess.cue,princessStance:princess.stance,
    wizardId:wizard.id,wizardName:wizard.name,wizardIdentity:identity,wizardStyle:wizard.style,wizardMethod:means,wizardAim:objective,
    siteId:site.id,siteName:site.name,siteApproach:site.approach,siteDefenses:site.defenses,siteWeakness:site.weakness,
    complicationId:comp.id,complication:comp.label,territoryName:territory.name,territoryDescription:territory.description,
    territoryFriction:territory.friction,treasureCrowns:gold,treasureExtra:'six chests of cut gems and two ancient curios',deadlineDays:days,
    courtAlly:ally.name,courtAllyRole:ally.role,courtAllyAngle:ally.angle};
  dbValerieProfile(d);
}
// COSMETIC FLUFFINESS v0.4.0-alpha.2 — appearance and situational humor only.
// This module must never change skills, spell registration, wounds, alerts,
// fortress challenges, detection, timelines, NPC decisions, or story outcomes.
// Source of truth: character-creation DRAGON_FLUFFINESS (0..10 integer).
function dbFluffParse(value){
  var m=/^\s*(10|[0-9])(?:\s*\/\s*10)?(?:\s*[-–—]\s*[^\r\n]{0,100})?\s*$/.exec(String(value==null?'':value));
  return m?Number(m[1]):null;
}
function dbFluffInit(d){
  if(!d.fluff||d.fluff.schema!==1){
    var parsed=dbFluffParse(d.character&&d.character.DRAGON_FLUFFINESS);
    d.fluff={schema:1,level:parsed===null?0:parsed,lastCueTurn:-99,recent:[],pending:null};
  }
  if(!Array.isArray(d.fluff.recent))d.fluff.recent=[];
  if(!Number.isInteger(d.fluff.level)||d.fluff.level<0||d.fluff.level>10)d.fluff.level=0;
  return d.fluff;
}
function dbFluffAppearance(d){
  var n=dbFluffInit(d).level;
  if(n===0)return ''; // no cosmetic change to the player's authored dragon
  if(n<=2)return 'A faint hint of softness: a few fine tufts, downy accents or a small ruff where compatible with the dragon\'s described anatomy. Dragon identity and silhouette remain unchanged.';
  if(n<=4)return 'Noticeably plush details: soft edging near the crest or neck, a modest ruff or tufts among otherwise prominent natural draconic features.';
  if(n<=6)return 'Substantial fluff: a thick soft mane/ruff and plush accents over parts of the body, with the dragon\'s stated scales, claws, horns and other anatomy still clearly recognizable.';
  if(n<=8)return 'Magnificently shaggy: dense fur-like softness or down around much of the body, dramatic ruff and tail accents when anatomically appropriate; still unmistakably a formidable dragon.';
  return 'Spectacularly, extravagantly fluffy: a mountainous cloud of soft fur/down framing the powerful dragon form. Keep the player-defined coloration, horns, jaws, wings if any, claws and abilities intact; fluff is an aesthetic, not a species rewrite.';
}
function dbFluffTone(level){
  if(level===0)return '';
  if(level<=2)return 'Almost entirely serious; very rare, understated observational humor.';
  if(level<=4)return 'Mostly serious fantasy with occasional gentle comic contrast about the dragon\'s incongruously plush appearance.';
  if(level<=6)return 'Regular light situational wit and affectionate visual incongruity; danger and character dignity remain intact.';
  if(level<=8)return 'Frequent but brief, lively situational comedy; guards and nobles can react believably to a terrifyingly fluffy dragon without becoming incompetent.';
  return 'Strong whimsical comic contrast, dry reactions, physical-comedy opportunities and playful dialogue woven into a genuinely dangerous heroic adventure; never turn threats into harmless jokes.';
}
// Independent, optional scene seeds. No game outcomes, time, or alert changes.
// The probability grows linearly from 0% at level 0 to 55% at level 10,
// with cooldown and only one cue per eligible scene. Seeds are not guaranteed.
var DB_FLUFF_SCENES={
  lair:[
    ['tribute_ribbon','A herald has brought an unnecessarily elaborate ceremonial ribbon intended for the dragon\'s hoard.'],
    ['jewel_rake','A nervous appraiser politely wonders whether the dragon uses a special comb for retrieving coins caught in its ruff.'],
    ['court_artist','A commissioned court artist is struggling to paint an appropriately terrifying portrait without omitting the impressive fluff.'],
    ['formal_title','A royal scribe hesitates over whether “the Magnificent” is a title of power or a reference to the dragon\'s coat.']
  ],
  court:[
    ['velvet_throne','The court has produced a velvet cushion intended to be impressive; it looks rather unnecessary beside the dragon.'],
    ['herald_voice','A herald practices a solemn introduction and keeps stumbling over an absurdly long honorific.'],
    ['tapestry','A royal tapestry depicts dragons as sleek and serpentine; a scholar is suddenly reconsidering the illustrations.'],
    ['ceremonial_groomer','A palace groom mistakenly brings out a ceremonial horse brush and freezes on realizing the mix-up.']
  ],
  road:[
    ['traveler_hair','A traveler experiences a moment of cognitive dissonance upon seeing a fluffy dragon loom out of the mist.'],
    ['loose_down','An isolated tuft floats past an astonished passerby, who cannot decide whether to be frightened or enchanted.'],
    ['roadside_sign','A rustic sign warns of monsters; its pictogram bears absolutely no resemblance to this dragon.'],
    ['wind_ruff','A gust lifts the dragon\'s ruff into a spectacular silhouette precisely as someone tries to look dignified.']
  ],
  wilderness:[
    ['woodland_stare','The local wildlife watches the dragon with a degree of curiosity that feels faintly unprofessional.'],
    ['wildflower','A stray wildflower becomes entangled in the dragon\'s coat without making the creature any less dangerous.'],
    ['mist_coat','Mountain mist briefly beads on the dragon\'s soft outer coat like pearls, to the admiration of an overly earnest naturalist.'],
    ['bird_rumor','A traveler repeats an absurd rumor about a dragon so fluffy it was mistaken for weather.']
  ],
  stronghold:[
    ['guard_report','A sentry struggles to phrase “enormous fluffy dragon” in a report without sounding ridiculous. Their report is otherwise accurate.'],
    ['arcane_portrait','An apprentice\'s official dragon identification sketch depicts no fluff at all, leading to a brief awkward correction.'],
    ['robe_stare','An overworked wardwright catches themself staring at the dragon\'s ruff for half a second before returning to the very real danger.'],
    ['dramatic_shadow','A menacing shadow falls across a wall; one inconveniently distinctive tuft ruins its otherwise perfect symmetry.']
  ]
};
function dbFluffMaybeSeed(d){
  var f=dbFluffInit(d),n=f.level;
  f.pending=null;
  if(n===0)return null;
  var gap=n<=3?4:n<=7?3:2;
  if(d.turn-f.lastCueTurn<gap || dbRoll(d,'fluff-chance')>=0.055*n)return null;
  var pool=DB_FLUFF_SCENES[d.location]||DB_FLUFF_SCENES.road;
  var available=pool.filter(function(e){return f.recent.indexOf(e[0])<0;});
  if(!available.length)available=pool;
  var chosen=available[Math.floor(dbRoll(d,'fluff-pick')*available.length)];
  f.pending={id:chosen[0],prompt:chosen[1]};
  f.lastCueTurn=d.turn;f.recent.push(chosen[0]);
  if(f.recent.length>6)f.recent.shift();
  return f.pending;
}
function dbFluffContext(d){
  var f=dbFluffInit(d),n=f.level;
  if(n===0)return []; // truly zero added humor at fluffiness zero
  var lines=['COSMETIC DRAGON FLUFF '+n+'/10. APPEARANCE: '+dbFluffAppearance(d),
    'HUMOR POLICY: '+dbFluffTone(n)+' Treat all fluff as aesthetic only; no alteration to danger, power, stealth, armor, movement, wards, alert, puzzles, or romance. Humor must be optional, situational and brief. Never force the dragon to groom, shed, purr, react or feel anything; never interrupt tragedy, high-stakes choices or urgent combat for a joke.'];
  if(f.pending)lines.push('OPTIONAL FLUFF HUMOR SEED '+f.pending.id+': '+f.pending.prompt+' Use only if naturally compatible with this scene, never as a required action, security effect or mechanical outcome.');
  return lines;
}

function dbInit(){
  if(typeof state==='undefined')return null;
  var d=state.dragonsBargain;
  if(!d||d.schema!==1){
    d={schema:1,version:DB_VERSION,seed:Math.floor(Math.random()*4294967296)>>>0,rng:0,turn:0,lastInput:'',
      character:{},plot:null,clock:{elapsedHours:0,ledger:[]},location:'lair',outcomes:{princess:'missing',wizard:'active',bargain:'pending'},
      revealed:{princess:false,wizard:false,bargain:false},recent:[],lastEventTurn:-99,pending:null,skip:false,reply:null,lastResolvedTurn:-1,
      initialCaptureDone:false};
    d.rng=d.seed||1;dbGenerate(d);state.dragonsBargain=d;
    console.log('[DB][INIT] v='+DB_VERSION+' seed='+d.seed+' princessRoll='+DB_PRINCESS.findIndex(function(x){return x.id===d.plot.princessId;})+' (private)');
  }
  if(d.plot){
    // Migration of private canon for older saves. Preserve the SAME selected
    // ID/zero-based roll, seed, RNG, tower, wizard's already-established
    // objective, elapsed time, discoveries and player choices.
    if(d.plot.princessScenarioRevision!==3){
      var revisedPrincess=null;
      for(var pi=0;pi<DB_PRINCESS.length;pi++)if(DB_PRINCESS[pi].id===d.plot.princessId){revisedPrincess=DB_PRINCESS[pi];break;}
      if(revisedPrincess){
        d.plot.princessLabel=revisedPrincess.label;
        d.plot.princessTruth=revisedPrincess.truth;
        d.plot.princessCue=revisedPrincess.cue;
        d.plot.princessStance=revisedPrincess.stance;
        d.plot.princessRescue=DB_RESCUE_STAKES[revisedPrincess.id];
        if(d.tower&&d.tower.schema===1&&d.tower.twistId===revisedPrincess.id){
          // Only update PRIVATE hooks, never the generated physical tower,
          // challenge states, existing cards, or established public facts.
          d.tower.plotHooks={custody:DB_TOWER_TWISTS[revisedPrincess.id].custody,
            thread:DB_TOWER_TWISTS[revisedPrincess.id].thread,
            pressure:DB_TOWER_TWISTS[revisedPrincess.id].pressure};
        }
        d.plot.princessScenarioRevision=3;
        console.log('[DB][PRINCESS] scenario canon upgraded id='+revisedPrincess.id+' (roll preserved)');
      }
    }
    dbValerieProfile(d);
  }
  if(!d.clock)d.clock={elapsedHours:0,ledger:[]};
  if(!d.revealed)d.revealed={princess:false,wizard:false,bargain:false};
  dbFortInit(d);dbLadderInit(d);dbDiscoveryInit(d);dbKnowledgeInit(d);dbAssaultInit(d);dbArcaneInit(d);dbFluffInit(d);d.version=DB_VERSION;return d;
}
var DB_CC_FIELDS=['DRAGON_NAME','DRAGON_SEX','DRAGON_KIND','DRAGON_AGE','DRAGON_SIZE','DRAGON_APPEARANCE','DRAGON_LAIR','DRAGON_TEMPERAMENT','DRAGON_FLUFFINESS'];
function dbReadCreation(raw){
  var d=dbInit();if(!d)return null;
  var s=String(raw||'');var b=/\[DRAGON_CC_BEGIN\]/i.exec(s);if(!b)return d.character;
  var offset=b.index+b[0].length;var e=/\[DRAGON_CC_END\]/i.exec(s.slice(offset));if(!e)return d.character;
  var body=s.slice(offset,offset+e.index);var re=new RegExp('(?:^|\\s)('+DB_CC_FIELDS.join('|')+')\\s*:', 'gi');
  var hits=[],m;while((m=re.exec(body))!==null)hits.push({key:m[1].toUpperCase(),start:m.index,end:re.lastIndex});
  var updates={};for(var i=0;i<hits.length;i++){
    var h=hits[i],stop=i+1<hits.length?hits[i+1].start:body.length;
    var value=body.slice(h.end,stop).trim();if(value&&value.length<600)updates[h.key]=value;
  }
  // Only the two character-creation selections are accepted for new characters.
  // Existing saved DRAGON_PRONOUNS fields are left untouched for save compatibility.
  if(Object.prototype.hasOwnProperty.call(updates,'DRAGON_SEX')){
    var sex=String(updates.DRAGON_SEX).trim().toLowerCase();
    if(sex==='male'||sex==='female')updates.DRAGON_SEX=sex==='male'?'Male':'Female';
    else {delete updates.DRAGON_SEX;console.log('[DB][CC] Invalid DRAGON_SEX; select Male or Female');}
  }
  for(var j=0;j<DB_CC_FIELDS.length;j++){
    var k=DB_CC_FIELDS[j];if(updates[k])d.character[k]=updates[k];
  }
  if(Object.prototype.hasOwnProperty.call(updates,'DRAGON_FLUFFINESS')){
    var fluffLevel=dbFluffParse(updates.DRAGON_FLUFFINESS);
    if(fluffLevel===null){
      fluffLevel=0;
      console.log('[DB][FLUFF] Invalid entry; defaulting to level 0');
    }
    d.character.DRAGON_FLUFFINESS=String(fluffLevel);
    dbFluffInit(d).level=fluffLevel;
    d.fluff.pending=null;
  }
  d.initialCaptureDone=true;
  console.log('[DB][CC] captured='+Object.keys(updates).length+' fields');
  return d.character;
}
function dbTimeHours(value,unit){var n=Number(value);if(!isFinite(n)||n<=0)return 0;return n*(/^day/i.test(unit)?24:/^week/i.test(unit)?168:/^hour/i.test(unit)?1:1/60);}
function dbTimeNonCurrent(s){return /\b(?:if I|if we|would have|could have|might have|imagine|suppose|dreamed|remembered|recall|flashback|in a dream)\b/i.test(s)||/^\s*[>\"“]/.test(s);}
function dbTimeEvidence(s){
  s=String(s||'').replace(/\[[A-Z_]+(?:\|[^\]]*)?\]/g,'');if(dbTimeNonCurrent(s))return null;
  s=s.replace(/\b(one|two|three|four|five|six|seven|eight|nine|ten|seventeen)\b/gi,function(w){return {one:1,two:2,three:3,four:4,five:5,six:6,seven:7,eight:8,nine:9,ten:10,seventeen:17}[w.toLowerCase()];});
  var m=s.match(/\b(?:spent|passed|waited|traveled|travelled|journeyed|rested|researched|trained|slept|studied|worked|after|for|over|during)\s+(?:the\s+)?(\d{1,3})\s*(days?|weeks?|hours?|minutes?)\b/i);
  if(m)return {hours:dbTimeHours(m[1],m[2]),reason:'completed_narration'};
  m=s.match(/\b(?:after\s+)?(\d{1,3})\s*(days?|weeks?|hours?|minutes?)\s+(?:later|passed|elapsed|went by|of travel|of research)\b/i);
  if(m)return {hours:dbTimeHours(m[1],m[2]),reason:'elapsed_narration'};
  if(/\b(?:next morning|following morning|slept through the night|woke (?:up )?(?:the )?next day)\b/i.test(s))return {hours:24,reason:'overnight_transition'};
  return null;
}
function dbTimeSignal(s){var m=String(s||'').match(/\[DB_TIME\|hours=(\d{1,3})(?:\|confidence=(high|medium|low))?\]/i);if(!m)return null;return {hours:Number(m[1]),confidence:m[2]||'medium',reason:'narrator_signal'};}
function dbStripMarkers(s){return dbArcaneStrip(dbAssaultStrip(dbLadderStrip(dbFortStrip(String(s||'').replace(/\[DB_TIME\|hours=\d{1,3}(?:\|confidence=(?:high|medium|low))?\]/gi,'').replace(/\[DB_REVEAL\|(?:princess|wizard|bargain)\]/gi,'').replace(/\[DB_OUTCOME\|(?:princess=(?:missing|free|safe|dead)|wizard=(?:active|escaped|defeated|negotiated)|bargain=(?:pending|agreed|honored|disputed|renounced))\]/gi,'').trim()))));}
function dbTimeObserve(d,raw,visible){
  var sig=dbTimeSignal(raw),narr=dbTimeEvidence(visible),chosen=narr;
  if(sig&&sig.hours>0&&sig.hours<=720&&sig.confidence==='high'&&!dbTimeNonCurrent(visible)&&(!narr||Math.abs(sig.hours-narr.hours)<0.01))chosen=sig;
  if(!chosen||chosen.hours<=0)return null;
  var h=Math.min(720,chosen.hours);d.clock.elapsedHours+=h;
  var entry={turn:d.turn,hours:h,reason:chosen.reason};d.clock.ledger.push(entry);if(d.clock.ledger.length>24)d.clock.ledger.shift();
  console.log('[DB][TIME] +'+h+' hours; total='+d.clock.elapsedHours);return entry;
}
function dbPublicPlot(d){var p=d.plot;return {treasureCrowns:p.treasureCrowns,treasureExtra:p.treasureExtra,territory:p.territoryName,territoryDescription:p.territoryDescription,territoryFriction:p.territoryFriction,deadlineDays:p.deadlineDays,wizardPublicName:p.wizardName,sitePublicName:p.siteName};}
function dbGetPublicPlot(){var d=dbInit();return d?dbPublicPlot(d):null;}
function dbStatus(){
  var d=dbInit(),p=d.plot,c=d.character;
  return '[THE DRAGON\'S BARGAIN]\nDragon: '+(c.DRAGON_NAME||'unnamed')+' ('+(c.DRAGON_KIND||'kind unspecified')+')\nFluffiness: '+dbFluffInit(d).level+'/10 (cosmetic and humor only)\n'+
    'Days elapsed: '+Math.floor(d.clock.elapsedHours/24)+'; days until stated deadline: '+Math.max(0,p.deadlineDays-Math.floor(d.clock.elapsedHours/24))+'.\n'+
    'Abductor: '+(d.revealed.wizard?p.wizardIdentity:'alleged wizard; full identity unconfirmed')+'. Stronghold: '+(d.location==='stronghold'?p.siteName:'not yet independently confirmed')+'.\n'+
    'Offer: '+p.treasureCrowns+' gold crowns, '+p.treasureExtra+', feeding rights in '+p.territoryName+'.\n'+
    'Princess: '+d.outcomes.princess+'; Wizard: '+d.outcomes.wizard+'; Bargain: '+d.outcomes.bargain+'.\n'+
    'Revealed secrets: '+Object.keys(d.revealed).filter(function(k){return d.revealed[k];}).join(', ')+'.';
}
// Royal commission: player consent is an INTENT; contract agreement requires
// actual narrated acceptance by the Crown's representative. Check across Do
// and successive Continue generations through persistent d.lastInput.
// This deliberately does not infer gold transfers, land-title execution,
// princess release, or any additional agreement from a single dialogue beat.
function dbContractPlayerAccepted(input){
 var s=String(input||'').replace(/^\s*>\s*(?:You\s+)?/i,'').replace(/[’]/g,"'");
 if(/\b(?:would|could|might|should|perhaps|maybe|if|unless|only if|provided that|subject to|on condition|considering|thinking about|suppose|imagine)\b/i.test(s))return false;
 if(/\b(?:refuse|reject|decline|won't|will not|don't|do not|cannot|can't|not yet|without accepting|without agreeing|no deal)\b/i.test(s))return false;
 if(/\b(?:accept|agree)\b[^.!?\n]{0,75}\b(?:to\s+(?:speak|talk|meet|hear|discuss|consider)|(?:an?|the)\s+audience)\b/i.test(s))return false;
 var proper=/\b(?:offer|terms|rescue|retrieve|princess|valerie|king|aldric|tribute|reward|commission|bargain|contract|charter|undertaking|quest|mission)\b/i.test(s);
 if(!proper)return false;
 return /\b(?:I|we)\s+(?:(?:do|hereby|now|willingly|gladly|formally|will|shall)\s+)?(?:accept|agree\s+to|undertake|take\s+on|take\s+up|commit\s+to|pledge\s+to)\b/i.test(s)||
   /\b(?:I|we)\s+(?:will|shall)\s+(?:rescue|retrieve|save|bring\s+(?:her|valerie|the princess)\s+home)\b/i.test(s)||
   /\b(?:I|we)\s+(?:give\s+(?:you|the king)\s+my\s+word|have\s+a\s+deal)\b/i.test(s);
}
function dbContractRoyalAcceptance(visible){
 var s=String(visible||'').replace(/[’]/g,"'").replace(/[“”]/g,'"').replace(/…/g,' ').replace(/\s+/g,' ');
 // Confirmation must concern the actual king's commission, not a separate
 // meeting, offer to negotiate, unrelated third-party agreement, or rumor.
 if(!/\b(?:herald|envoy|emissary|messenger|royal representative|king aldric|his majesty|the king|your agreement|your bargain|your undertaking|your contract|your offer)\b/i.test(s))return false;
 var patterns=[
  /\b(?:your|our|this|the|the dragon's)\s+(?:agreement|undertaking|bargain|contract|commission|offer|terms)\b.{0,95}?\b(?:accepted|ratified|confirmed|concluded|sealed|finalized)\b/gi,
  /\b(?:the\s+)?(?:herald|envoy|messenger|emissary|royal representative|king aldric|the king|his majesty)\b.{0,75}?\b(?:accepts?|agrees\s+to|ratifies|confirms|seals|approves)\s+(?:(?:your|the|this|our)\s+)?(?:terms|agreement|bargain|contract|commission|offer|rescue\s+(?:mission|contract|bargain))\b/gi,
  /\b(?:the\s+)?(?:herald|envoy|messenger|emissary|royal representative|king aldric|the king|his majesty)\b.{0,70}?\b(?:says?|declares?|announces?)\b.{0,30}?\b(?:it's a deal|we have a bargain|the king accepts|agreed|accepted)\b/gi
 ];
 for(var i=0;i<patterns.length;i++){
  var m;while((m=patterns[i].exec(s))!==null){
   var phrase=m[0],before=s.slice(Math.max(0,m.index-32),m.index),after=s.slice(m.index+m[0].length,m.index+m[0].length+50);
   // Reject negations, future/conditional agreements, and immediately revoked deals.
   if(/\b(?:not|never|would|could|might|should|will|may|if|whether|unless|until|perhaps|maybe|tentatively|pending)\b/i.test(phrase))continue;
   if(/\b(?:if|whether|unless|until|should|when|once)\s*[,:'"-]*\s*$/i.test(before))continue;
   if(/\b(?:revoked|withdrawn|rejected|rescinded|cancelled|canceled)\b/i.test(after))continue;
   return true;
  }
 }
 return false;
}
function dbContractObserve(d,visible){
 if(!d||!d.outcomes||d.outcomes.bargain!=='pending')return false;
 if(!dbContractPlayerAccepted(d.lastInput)||!dbContractRoyalAcceptance(visible))return false;
 d.outcomes.bargain='agreed';
 console.log('[DB][BARGAIN] agreed (confirmed mutual acceptance)');
 return true;
}
function dbSpoilerStatus(){var d=dbInit(),p=d.plot;return '[AUTHOR DEBUG — SPOILERS]\nPrincess roll: '+p.princessId+' — '+p.princessTruth+'\nWizard: '+p.wizardIdentity+'; objective: '+p.wizardAim+'\nStronghold: '+p.siteName+'; weakness: '+p.siteWeakness+'\nComplication: '+p.complication+'\nCourt contact: '+p.courtAlly+' ('+p.courtAllyAngle+')';}
function dbSurgeManagement(s){return /^\s*(?:>\s*(?:You\s+)?)?#(?:POWER|SPELL|GAME|DEBUG|HELP)\b/i.test(s)||/\[(?:SURGE|SCP)_CC_BEGIN\]/i.test(s);}
function dbRegion(s,old){s=s.toLowerCase();if(!/\b(?:go|head|journey|ride|travel|fly|soar|walk|enter|approach|arrive|return|leave|land|reach|move|cross)\b/.test(s))return old;if(/\b(sanctum|fortress|stronghold|tower|archive|keep|observatory|crypt|wizard's palace|wizard’s palace|prison)\b/.test(s))return 'stronghold';if(/\b(royal court|king's palace|king’s palace|queen's palace|queen’s palace|castle|throne room|capital)\b/.test(s))return 'court';if(/\b(forest|mountain|wilderness|marsh|pass|wilds)\b/.test(s))return 'wilderness';if(/\b(road|journey|ride|travel|flight toward|fly toward)\b/.test(s))return 'road';if(/\b(lair|hoard|cavern|den)\b/.test(s))return 'lair';return old;}
// AID Continue causes another Context -> Output generation without a new Input.
// Keep the older d.turn as the PLAYER-INPUT counter, and track narrator
// generations separately. Stable actionCount/history slots prevent duplicate
// commits when the platform reruns a context or retries the same slot.
function dbGenerationContext(d){
 var slot=null,meta=typeof info!=='undefined'&&info&&typeof info.actionCount==='number'&&isFinite(info.actionCount)?info.actionCount:null;
 var len=typeof history!=='undefined'&&history&&typeof history.length==='number'?history.length:null;
 if(meta!==null||len!==null)slot='aid:'+String(meta===null?'?':meta)+':'+String(len===null?'?':len);
 if(typeof d.generationSerial!=='number')d.generationSerial=0;
 if(slot===null||slot!==d.lastContextSlot||d.lastResolvedTurn!==d.turn){
  d.generationSerial++;d.lastContextSlot=slot;
 }
 d.generationKey='gen:'+d.generationSerial;
 d.generatingContinue=d.lastResolvedTurn===d.turn;
 return d.generationKey;
}
function dbGenerationKey(d){return (d.generationKey||'gen:unspecified')+'|input:'+d.turn;}
function dbInput(text){
  var d=dbInit();if(!d)return text;var raw=String(text==null?'':text);
  // Must run before attached Surge Protector consumes the full setup block.
  dbReadCreation(raw);
  dbTowerSyncCards(d);
  dbValerieCardSync(d);
  d.skip=dbSurgeManagement(raw);d.pending=null;
  if(d.skip)return raw;
  // AI Dungeon Do/Say actions can arrive as "> You #TOWER STATUS.".
  // Normalize only the command lookup; preserve the raw text for Surge Protector.
  var cmd=raw.trim().replace(/^>\s*(?:You\s+)?/i,'').replace(/[.!?]\s*$/,'').trim().toUpperCase();
  if(cmd==='#TOWER CARDS STATUS'){d.reply=dbTowerCardStatus(d);return '[SYSTEM: Display exact tower card diagnostics; do not advance story.]';}
  if(cmd==='#FORTRESS STATUS'){d.reply=dbFortPublicStatus(d);return '[SYSTEM: Display the exact fortress status; do not advance story.]';}
  if(cmd==='#TOWER STATUS'){d.reply=dbLadderPublicStatus(d);return '[SYSTEM: Display the exact tower challenge status; do not advance story.]';}
  if(cmd==='#TOWER DEBUG'){d.reply=DB_SETTINGS.allowSpoilerDebug?dbLadderDebug(d):'[TOWER DEBUG] Disabled in Library settings to avoid spoilers.';return '[SYSTEM: Display exact tower debug; do not advance story.]';}
  if(cmd==='#FORTRESS HELP'){d.reply='[FORTRESS COMMANDS]\n#FORTRESS STATUS — known position, alert and obstacles\n#FORTRESS HELP — help\n#FORTRESS DEBUG — author-only details when enabled';return '[SYSTEM: Display exact fortress help; do not advance story.]';}
  if(cmd==='#FORTRESS DEBUG'){d.reply=DB_SETTINGS.allowSpoilerDebug?dbFortDebug(d):'[FORTRESS DEBUG] Disabled in Library settings to avoid spoilers.';return '[SYSTEM: Display exact fortress debug response; do not advance story.]';}
  // Author-only recovery for agreements confirmed in OLD narration before
  // the acceptance observer was installed. Requires a prior player-authored
  // acceptance in saved d.lastInput. No plot revelation or reward grant.
  if(cmd==='#BARGAIN RECONCILE AGREED'){
    if(d.outcomes.bargain==='agreed')d.reply='[BARGAIN RECOVERY] Already agreed; no state change.';
    else if(d.outcomes.bargain!=='pending')d.reply='[BARGAIN RECOVERY] Current state is '+d.outcomes.bargain+'; refusing to override.';
    else if(!dbContractPlayerAccepted(d.lastInput))d.reply='[BARGAIN RECOVERY] Not applied. Last saved player action does not contain an explicit royal commission acceptance.';
    else{d.outcomes.bargain='agreed';console.log('[DB][BARGAIN] agreed (author recovery; previous scene confirmed)');d.reply='[BARGAIN RECOVERY] Saved contract state: agreed. Author-confirmed previous herald acceptance; no reward or additional plot state changed.';}
    return '[SYSTEM: Display the bargain recovery result; do not advance story.]';
  }
  if(cmd==='#BARGAIN STATUS'){d.reply=dbStatus();return '[SYSTEM: Display the exact bargain status; do not advance story.]';}
  if(cmd==='#BARGAIN HELP'){d.reply='[BARGAIN COMMANDS]\n#BARGAIN STATUS — public quest and contract state\n#BARGAIN HELP — this help\n#BARGAIN RECONCILE AGREED — author recovery only, for previously confirmed mutual agreement missed by old code';return '[SYSTEM: Display the exact command list; do not advance story.]';}
  if(cmd==='#BARGAIN DEBUG'){
    d.reply=DB_SETTINGS.allowSpoilerDebug?dbSpoilerStatus():'[BARGAIN DEBUG] Disabled in Library settings to prevent spoilers.';
    return '[SYSTEM: Display this diagnostic response without advancing story.]';
  }
  // Avoid repeated processing of identical input on a retry before output.
  if(raw===d.lastInput && d.lastResolvedTurn!==d.turn)return raw;
  d.turn++;d.lastInput=raw;d.location=dbRegion(raw,d.location);
  var arrival=d.fortress.zone==='unknown'?dbFortPendingApproach(raw,d.turn):null;
  if(arrival)d.fortress.pendingArrival=arrival;
  else if(d.fortress.pendingArrival)delete d.fortress.pendingArrival;
  if(d.tower&&/\b(?:go|head|journey|travel|fly|soar|enter|approach|arrive|reach)\b/i.test(raw)&&raw.toLowerCase().indexOf(d.tower.name.toLowerCase())>=0)d.location='stronghold';
  if(d.turn-d.lastEventTurn>=DB_SETTINGS.ambientInterval&&dbRoll(d,'event')<DB_SETTINGS.ambientChance){
    var pool=d.location==='stronghold'?dbTowerLivingEvents(d):(DB_AMBIENT[d.location]||DB_AMBIENT.road);
    var available=pool.filter(function(x){return d.recent.indexOf(x[0])<0;});
    var choices=available.length?available:pool;var e=choices[Math.floor(dbRoll(d,'pick')*choices.length)];
    d.pending={id:'db-'+d.turn+'-'+e[0],prompt:e[1]};d.recent.push(e[0]);if(d.recent.length>5)d.recent.shift();d.lastEventTurn=d.turn;
  }
  dbFluffMaybeSeed(d);
  dbArcanePrepare(d,raw);
  return raw;
}
function dbContext(text){
  var d=dbInit();if(!d||d.skip)return text;
  dbGenerationContext(d);
  var p=d.plot,c=d.character;
  var lines=['[DRAGON BARGAIN DIRECTOR — PRIVATE; NEVER PRINT]',
    'CANON: Dragon PC '+(c.DRAGON_NAME||'player-defined')+'; '+(c.DRAGON_KIND||'species undecided')+'. Never assume the dragon accepts the king’s offer. Player owns their decisions.',
    'PUBLIC CONTRACT: King Aldric offers '+p.treasureCrowns+' gold crowns, '+p.treasureExtra+', and feeding rights in '+p.territoryName+' ('+p.territoryDescription+'). The right is politically disputed: '+p.territoryFriction+'. People are NOT automatically legal prey. Clarify terms in play.',
    'CLOCK: '+Math.floor(d.clock.elapsedHours/24)+' days elapsed of '+p.deadlineDays+'-day public deadline. Advance only for completed time, never for plans or uncompleted travel.',
    'WIZARD: Public name '+p.wizardName+'. Private true identity: '+p.wizardIdentity+'. Style: '+p.wizardStyle+'. Methods: '+p.wizardMethod+'. Real agenda: '+p.wizardAim+'.',
    'STRONGHOLD: '+p.siteName+'. Approach '+p.siteApproach+'. Defenses: '+p.siteDefenses+'. Discoverable weakness: '+p.siteWeakness+'. Give clues; never auto-cancel player success.',
    'PRINCESS — SECRET ROLL '+p.princessId+': '+p.princessTruth+' Personality: '+p.personalityId+'. Her behavior: '+p.princessStance+' Clue to seed before revelation: '+p.princessCue+' Do not expose the secret until credible in-story discovery. Her actions and feelings are independent of the player.',
    'RESCUE STAKES (PRIVATE): '+p.princessRescue+' Ordinary persuasion cannot erase real custody, coercion, or the wizard’s objective; genuine leverage, negotiation, and the princess’s informed choices may resolve them. No automatic release or compulsory forced return.',
    'SECONDARY PRESSURE: '+p.complication+'. Court contact '+p.courtAlly+' ('+p.courtAllyRole+'): '+p.courtAllyAngle+'.',
    'CURRENT: region='+d.location+' princess='+d.outcomes.princess+' wizard='+d.outcomes.wizard+' contract='+d.outcomes.bargain+'. Revealed to player: princess='+d.revealed.princess+' wizard='+d.revealed.wizard+' bargain='+d.revealed.bargain+'.',
    'CONTRACT CONSISTENCY: Royal commission remains pending until the dragon explicitly accepts its terms AND the herald or king confirms mutual agreement. If both are confirmed in the story, append [DB_OUTCOME|bargain=agreed]. A mere offer, question, counteroffer, future promise or one-sided intention is NOT agreement. The deposit, final reward and hunting-rights execution are separate from acceptance.',
    'NARRATIVE AUTHORITY: Surge Protector alone decides registered magic and supernatural effect limits; MindRift alone decides its psychological mechanics. Biological teeth, scales and wing movement are ordinary anatomy, but supernatural powers require authorization. Do not decide the PC’s speech, motives or voluntary actions.'];
  // The timeline creates pressure, but never assumes success or failure before narration confirms it.
  var daysLeft=p.deadlineDays-Math.floor(d.clock.elapsedHours/24);
  if(daysLeft<=0 && d.outcomes.wizard==='active')
    lines.push('DEADLINE REACHED: the wizard now attempts the promised scheme. Show concrete consequences or an unfolding confrontation; do not silently kill the captive, end the adventure or declare a completed ritual without a narrated outcome.');
  else if(daysLeft<=3 && d.outcomes.wizard==='active')
    lines.push('DEADLINE PRESSURE: '+Math.max(0,daysLeft)+' days remain. The wizard and court become more urgent and active. Let the player respond to observable signs.');
  // One princess variant specifically requires an active escape plan rather than passive captivity.
  if(p.princessId==='self_rescue' && d.outcomes.princess==='missing'){
    var elapsed=Math.floor(d.clock.elapsedHours/24);
    if(elapsed>=6)lines.push('SELF-RESCUE PRIORITY: Princess Valerie has finished preparing. Unless the story has already established a concrete obstacle or prior capture preventing it, she now SUCCESSFULLY escapes under her own initiative, without requiring the dragon. Narrate how and emit [DB_OUTCOME|princess=free] only once her escape has actually been described. Do not retroactively deny a successful player rescue.');
    else if(elapsed>=3)lines.push('SELF-RESCUE DEVELOPMENT: the princess has gathered tools and intelligence and tests an escape route. Leave discoverable evidence and allow the attempt to unfold.');
    else lines.push('SELF-RESCUE SETUP: the princess secretly observes routines, collects tools and tests the guards rather than waiting helplessly.');
  }
  if(p.princessId==='body_double')lines.push('IDENTITY CONSISTENCY: outcome princess=missing/free/safe refers to the abducted SERVING-WOMAN DOUBLE; the real princess remains free unless separately established otherwise.');
  if(p.princessId==='wizard_romance')lines.push('ROMANCE PACING: any attachment to the wizard emerges gradually and does not erase or excuse the coercion of kidnapping.');
  lines=lines.concat(dbFluffContext(d));
  lines=lines.concat(dbFortContext(d));
  if(d.fortress.serviceBoltRemoved)lines.push('CONFIRMED SERVICE ROUTE CHANGE: The exposed lower bolt of the iron inner door has been removed. Other fastenings remain unresolved; the bridge was not damaged by this act.');
  if(d.fortress.pendingArrival&&!d.fortress.pendingArrival.resolved&&d.fortress.pendingArrival.turn===d.turn)lines.push('PENDING FORTRESS LANDING: Resolve the attempted landing normally. If the dragon actually lands outside on the outer approach, state the touchdown and name the outer approach together. If the landing is interrupted or is elsewhere, describe what actually happens.');
  if(d.location==='stronghold'||d.fortress.zonesSeen.length>0)lines=lines.concat(dbTowerContext(d));
  if(d.location==='stronghold')lines=lines.concat(dbLadderContext(d));
  if(d.location==='stronghold')lines=lines.concat(dbAssaultContext(d));
  if(d.location==='stronghold')lines=lines.concat(dbArcaneContext(d));
  lines=lines.concat(dbKnowledgeContext(d));
  if(d.generatingContinue)lines.push('CONTINUE GENERATION: This is ongoing narration from the PREVIOUS player action, NOT a fresh attempt at that action. Resolve previously started threats, projectile flight, alarms, falling structures and consequences over successive passages. Never automatically repeat the dragon attack, create extra defender volleys, or reset a previously broken gate. Aimed/loaded harpoons are NOT shots fired; fired shots, a genuinely tilting bridge and shattered doors are distinct confirmed events.');
  if(d.pending)lines.push('OPTIONAL LIVING WORLD SEED '+d.pending.id+': '+d.pending.prompt+' Use only if plausible; never derail a decisive player action.');
  lines.push('Only AFTER narration CONFIRMS a relevant event, append optional hidden markers: [DB_TIME|hours=N|confidence=high] for 1–720 COMPLETED hours; [DB_REVEAL|princess] after the princess truth is genuinely found; [DB_REVEAL|wizard] for true identity/plan; [DB_REVEAL|bargain] for the offer’s concealed implications; [DB_OUTCOME|princess=free] etc. Never append for mere intent or speculation.',
    '[/DRAGON BARGAIN DIRECTOR]');
  return String(text||'')+'\n'+lines.join('\n');
}
function dbOutput(text){
  var d=dbInit();if(!d)return text;var raw=String(text||'');
  if(d.reply){var answer=d.reply;d.reply=null;d.skip=false;return answer;}
  if(d.skip){d.skip=false;return dbStripMarkers(raw);}
  var visible=dbStripMarkers(raw);
  var thisGeneration=dbGenerationKey(d);
  if(d.lastResolvedTurn!==d.turn||d.lastResolvedGeneration!==thisGeneration){
    dbTimeObserve(d,raw,visible);
    dbFortObserve(d,raw);
    dbArcaneObserve(d,raw);
    dbArcaneObserveDirect(d,visible);
    dbAssaultObserve(d,raw);
    dbAssaultObserveDirect(d,visible);
    dbThreatObserve(d,visible);
    dbFortObserveDirect(d,visible);
    dbLadderObserve(d,raw);
    dbEntryObserve(d,visible);
    dbDiscoveryObserve(d,visible);
    dbKnowledgeObserve(d,visible);
    dbOutcomeObserve(d,visible);
    dbProgressReconcile(d,visible);
    dbBridgeServiceObserve(d,visible);
    dbServiceBoltObserve(d,visible);
    var reveal= /\[DB_REVEAL\|(princess|wizard|bargain)\]/gi,m;
    while((m=reveal.exec(raw))!==null){d.revealed[m[1].toLowerCase()]=true;console.log('[DB][REVEAL] '+m[1]);}
    var outcomes=/\[DB_OUTCOME\|(princess=(?:missing|free|safe|dead)|wizard=(?:active|escaped|defeated|negotiated)|bargain=(?:pending|agreed|honored|disputed|renounced))\]/gi;
    var bargainMarkerSeen=false;
    while((m=outcomes.exec(raw))!==null){var bits=m[1].split('=');if(bits[0]==='bargain')bargainMarkerSeen=true;d.outcomes[bits[0]]=bits[1];console.log('[DB][OUTCOME] '+bits[0]+'='+bits[1]);}
    if(!bargainMarkerSeen)dbContractObserve(d,visible);
  }
  d.pending=null;dbFluffInit(d).pending=null;d.lastResolvedTurn=d.turn;d.lastResolvedGeneration=thisGeneration;return dbArcaneGuardNarration(d,visible);
}
