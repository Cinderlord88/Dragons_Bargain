var DB_FORT_ALERT_POSTURES=[
 'QUIET: ordinary shifts, patrol check-ins, private staff routines and maintained alarms.',
 'SUSPICIOUS: a watch sergeant verifies anomalies, questions witnesses and checks assigned posts.',
 'SEARCH: paired patrols search reported sectors, wardwright checks evidence, reinforcements move from barracks.',
 'LOCKDOWN: isolate specifically threatened passages and request wizard instructions; staff still require routes and time.',
 'FULL RESPONSE: command coordinates reserve units and prepared defenses around the known threat, with negotiation or retreat still possible.'
];
var DB_FORT_DIFFICULTIES={cinematic:'One serious defensive challenge at a time; significant but forgiving danger and several obvious openings.',challenging:'Intelligent coordinated defense; at least three meaningful layers, clear clues, alternate strategies and lasting consequences.',ruthless:'Disciplined patrols, faster local response and serious logistical setbacks, but no impossible defenses or instant unavoidable defeat.'};
var DB_FORT_INCIDENTS={probe:1,missing_guard:1,sensor_trigger:1,breached_gate:2,dragon_sighted:2,ward_overload:2,major_attack:3,hostage_alarm:3};
function dbFortIndex(d,salt,length){return dbHash('db-fort|'+d.seed+'|'+d.plot.siteId+'|'+salt)%length;}
function dbFortInit(d){
 if(!d||!d.plot)return null;
 if(d.fortress&&d.fortress.schema===1){if(!d.fortress.trapStatus)d.fortress.trapStatus='armed';if(typeof d.fortress.trapSeen!=='boolean')d.fortress.trapSeen=false;return d.fortress;}
 var profile=dbGetFortProfile(d);
 d.fortress={schema:1,siteId:d.plot.siteId,alert:0,zone:'unknown',zonesSeen:[],cleared:{},lastIncident:'',lastIncidentTurn:-1,
  watch:DB_FORT_PATROLS[dbFortIndex(d,'watch',DB_FORT_PATROLS.length)],
  custodyPattern:DB_FORT_HOSTAGE[dbFortIndex(d,'custody',DB_FORT_HOSTAGE.length)],
  response:DB_FORT_RESPONSES[dbFortIndex(d,'response',DB_FORT_RESPONSES.length)],
  profile:profile.id||d.plot.siteId,trapStatus:'armed',trapSeen:false,
  activity:[],lastConfirmedTurn:-1};
 console.log('[DB][FORT] initialized site='+d.plot.siteId+' (existing plot preserved)');
 return d.fortress;
}
function dbFortStrip(s){return String(s||'').replace(/\[DB_FORT\|(?:zone=(?:approach|perimeter|garrison|ward|sanctum|custody|escape)|clear=(?:perimeter|ward|custody)\|method=(?:bypass|disable|destroy|negotiate)|incident=(?:probe|missing_guard|sensor_trigger|breached_gate|dragon_sighted|ward_overload|major_attack|hostage_alarm)|standdown|trap=(?:found|disabled|triggered))\]/gi,'').trim();}
function dbFortPublicStatus(d){
 var f=dbFortInit(d),p=d.plot,known=f.zone!=='unknown';
 var seen=f.zonesSeen.length?f.zonesSeen.join(', '):'none confirmed';
 var layers=DB_FORT_LAYERS.map(function(id){return id+': '+(f.cleared[id]||'unresolved / not confirmed');}).join('; ');
 return '[FORTRESS STATUS]'+(f.knownBridgeService?'\nKnown access: bridge service route'+(f.serviceBoltRemoved?'; exposed lower bolt removed':''):'')+'\nLocation: '+(known?p.siteName:'not confirmed in play')+'\nAlert: '+f.alert+'/4 ('+['quiet','suspicious','searching','lockdown','full response'][f.alert]+')\nConfirmed area: '+(known?f.zone:'unconfirmed')+'\nVisited: '+seen+'\nTrap: '+(f.trapSeen?f.trapStatus:'not identified')+'\nObstacles: '+(known?layers:'not yet assessed')+'\nA guard, ward or locked route may be bypassed, negotiated with, disabled or destroyed. No rigid room order.'+dbArcanePublicStatus(d);
}
function dbFortDebug(d){var f=dbFortInit(d),p=d.plot,t=dbGetFortProfile(d);
 return '[AUTHOR FORTRESS DEBUG — SPOILERS]\nSite: '+p.siteName+'\nWatch: '+f.watch+'\nCustody: '+f.custodyPattern+'\nResponse: '+f.response+'\nTrap: '+dbGetFortTrap(d).name+' ('+f.trapStatus+')\nSky: '+t.sky+'\nPerimeter: '+t.perimeter+'\nGarrison: '+t.garrison+'\nWard: '+t.ward+'\nCustody: '+t.custody+'\nEscape: '+t.escape+'\nWeakness: '+t.flaw+'\n'+dbFortPublicStatus(d);}
function dbFortContext(d){
 var f=dbFortInit(d),p=d.plot,t=dbGetFortProfile(d);
 var active=d.location==='stronghold';
 if(!active)return ['FORTRESS POSTURE: '+p.siteName+' is occupied, layered and watchful, not an empty tower. Before arrival, reveal scouting clues, witnesses and approaches rather than exposing its internal blueprint.'];
 var trap=dbGetFortTrap(d);
 var lineByZone={approach:t.terrain+' AERIAL THREAT: '+t.sky,perimeter:t.perimeter,garrison:t.garrison,ward:t.ward,sanctum:'The wizard’s private command chamber; '+p.wizardName+' uses '+DB_FORT_WIZARD_PLANS[p.wizardId],custody:t.custody,escape:t.escape};
 var local=f.zone==='unknown'?'approach':f.zone;
 var lines=['[FORTRESS DIRECTOR — PRIVATE; NEVER PRINT]',
  'SITE '+p.siteName+' / '+p.siteId+'. Difficulty '+DB_SETTINGS.fortressDifficulty+': '+(DB_FORT_DIFFICULTIES[DB_SETTINGS.fortressDifficulty]||DB_FORT_DIFFICULTIES.challenging)+' Occupied fortress. Dragon scale matters: some routes too narrow for large bodies; siege attacks can succeed but attract defenders and risk the captive. There are multiple avenues, not a mandatory ordered dungeon.',
  'SECURITY RESPONSE: '+f.alert+'/4. '+DB_FORT_ALERT_POSTURES[f.alert]+' '+f.response+' Watch roster: '+f.watch+' Each enemy acts on knowledge they plausibly received. Guard shifts, couriers, food deliveries and sleeping staff continue.',
  'CURRENT AREA: '+local+'. '+lineByZone[local],
  'BARRIERS: Outer access / perimeter '+(f.cleared.perimeter||'unresolved')+'; ward network '+(f.cleared.ward||'unresolved')+'; captive protection '+(f.cleared.custody||'unresolved')+'. These are THREE meaningful interlocking challenges, NOT absolute prerequisites. Show a concrete obstacle before narrating an easy bypass; do not undo established player success.',
  'CUSTODY: '+f.custodyPattern+' Even a smashed wall does not grant knowledge of the captive’s exact location. Investigate delivery logs, informants, ward links, prisoner transfers or witnesses. Do not secretly teleport the captive each time the dragon succeeds.',
  'DISCOVERABLE WEAKNESS: '+t.flaw+' FORESHADOW WITH: '+t.tell+' Reward clever exploitation; no omniscient universal anti-dragon negation.',
  'BREACH CONSEQUENCES: direct assault, killing hired wizard guards and burning hostile defenses are VALID mission solutions. They may raise alert, move surviving patrols or destroy useful paths, but cause no invented moral or royal penalties. A threatened captive faces only specific established physical risks, never automatic punishment for the dragon’s aggression. Include plausible extraction, not forced stealth or forced combat to death.',
  'ESCAPE / EXTRACTION: '+t.escape+' Exiting with a captive is a second challenge, but a previously opened route stays open unless an observed action closes it.',
  'WIZARD: '+p.wizardName+' has an actual goal: '+p.wizardAim+'. Tactical specialty: '+DB_FORT_WIZARD_PLANS[p.wizardId]+' Acts rationally and may retreat, bargain, bluff or sacrifice equipment. Do not assume the wizard knows everything. Do not injure the captive automatically on breach.',
  'SITE TRAP: '+trap.name+' ('+f.trapStatus+'). In '+trap.zone+'. Warning: '+trap.tell+' Effect only if TRIGGERED: '+trap.effect+' Plausible counters: '+trap.counter+' Do not secretly rearm a disabled trap.',
  'AUTHORITATIVE OUTPUT MARKERS ONLY AFTER EXPLICITLY NARRATED EVENTS: [DB_FORT|zone=approach/perimeter/garrison/ward/custody/escape] for confirmed location; [DB_FORT|clear=perimeter/ward/custody|method=bypass/disable/destroy/negotiate] for resolved challenge; [DB_FORT|incident=probe/missing_guard/sensor_trigger/breached_gate/dragon_sighted/ward_overload/major_attack/hostage_alarm] only if defenders notice and an alarm/report can propagate; [DB_FORT|standdown] only after confirmed security de-escalation; [DB_FORT|trap=found/disabled/triggered] only after that trap is actually found, neutralized, or activated. Do NOT emit for player intent, purely hidden events, guesses, or nondefinitive outcomes. These markers are stripped from displayed prose.',
  '[/FORTRESS DIRECTOR]'];
 return lines;
}
function dbFortPendingApproach(raw,turn){
 var action=String(raw||'').replace(/"[^"]*"|“[^”]*”/g,' ');
 if(!/\b(?:land|touch down)\b/i.test(action)||
    !/\b(?:outer approach|(?:before|short of) the (?:[\w-]+ ){0,3}bridge|outside the (?:main )?(?:fortress )?gate)\b/i.test(action)||
    /\b(?:do not|don't|will not|won't|if|imagine|pretend|might|could|ask|tell|inside|beyond the bridge|cross the bridge)\b/i.test(action))return null;
 return {zone:'approach',turn:turn};
}
function dbFortApproachEvidence(raw){
 var prose=dbFortStrip(String(raw||'').replace(/"[^"]*"|“[^”]*”/g,' '));
 if(/\b(?:forces? you back|forced back|abort(?:s|ed)? (?:the|your) landing|back into the air|you take off again|you lift off again)\b/i.test(prose))return 'interrupted';
 var paragraphs=prose.split(/\n\s*\n/);
 for(var i=0;i<paragraphs.length;i++){
  var sentences=paragraphs[i].split(/[.!?\n]+/);
  for(var j=0;j<sentences.length;j++){
   var line=sentences[j];
   if(/\b(?:not|never|cannot|can't|might|would|could|may|if|almost|before you|try|tries|tried|trying|attempt\w*|fail\w*|instead|imagines?|suppose|perhaps|maybe|claims?|reports?|says?|said|tells?|told)\b/i.test(line))continue;
   if(/\byou settle(?: once again)? onto the outer approach\b/i.test(line))return 'explicit-approach';
   var arrival=/\byou (?:land(?:ed)?|touch(?:ed)? down)\b(.{0,135})/i.exec(line);
   if(!arrival)continue;
   if(/\b(?:past|across|beyond|inside|over the bridge)\b/i.test(arrival[1]))continue;
   if(/\b(?:outer approach|short of (?:the )?(?:[\w,-]+ ){0,5}bridge|outside the (?:main )?(?:fortress )?gate)\b/i.test(arrival[1]))return 'explicit-approach';
   if(/^\s+(?:just )?short of it\b/i.test(arrival[1])){
    var previous=sentences[j-1]||'';
    if(/^\s*the (?:[\w-]+ ){0,2}bridge\s+(?:looms|stands|spans)\b/i.test(previous)&&
       !/\b(?:and (?:a|an|the)|or|might|could|would|not|if)\b/i.test(previous))return 'bridge-in-previous-sentence';
   }
  }
 }
 return 'no-confirmed-approach';
}
function dbFortObserve(d,raw){
 var f=dbFortInit(d);if(f.lastConfirmedGeneration===dbGenerationKey(d))return;
 var m,changed=[];
 var pending=f.pendingArrival,arrival='';
 if(pending&&pending.turn===d.turn&&!pending.resolved){
  var evidence=dbFortApproachEvidence(raw);
  if(evidence==='explicit-approach'||evidence==='bridge-in-previous-sentence'){
   arrival=pending.zone;pending.resolved=true;
   console.log('[DB][FORT ARRIVAL] accepted zone='+arrival+' evidence='+evidence);
  }else{
   if(evidence==='interrupted')pending.resolved=true;
   console.log('[DB][FORT ARRIVAL] rejected zone='+pending.zone+' evidence='+evidence);
  }
 }
 var zone=/\[DB_FORT\|zone=(approach|perimeter|garrison|ward|sanctum|custody|escape)\]/gi;
 var zoneText=String(raw||'').replace(/"[^"]*"|“[^”]*”/g,' ');
 while((m=zone.exec(zoneText))!==null){
  if(pending&&pending.turn===d.turn)continue;
  f.zone=m[1].toLowerCase();
  if(f.zonesSeen.indexOf(f.zone)<0)f.zonesSeen.push(f.zone);
  d.location='stronghold';changed.push('zone='+f.zone);
 }
 if(arrival&&arrival!==f.zone){
  f.zone=arrival;if(f.zonesSeen.indexOf(arrival)<0)f.zonesSeen.push(arrival);
  d.location='stronghold';changed.push('zone='+arrival);
 }
 var clear=/\[DB_FORT\|clear=(perimeter|ward|custody)\|method=(bypass|disable|destroy|negotiate)\]/gi;
 while((m=clear.exec(raw))!==null){if(m[1].toLowerCase()==='perimeter'&&!dbArcaneAllowEntry(d,m[2].toLowerCase()))continue;f.cleared[m[1].toLowerCase()]=m[2].toLowerCase();changed.push('clear='+m[1]+':'+m[2]);}
 var trapSignal=/\[DB_FORT\|trap=(found|disabled|triggered)\]/i.exec(raw);
 if(trapSignal){f.trapSeen=true;if(trapSignal[1].toLowerCase()!=='found')f.trapStatus=trapSignal[1].toLowerCase();changed.push('trap='+trapSignal[1].toLowerCase());}
 // One noticed incident per narrated turn to prevent marker spam and retry escalation.
 var incident=/\[DB_FORT\|incident=(probe|missing_guard|sensor_trigger|breached_gate|dragon_sighted|ward_overload|major_attack|hostage_alarm)\]/i.exec(raw);
 if(incident){var kind=incident[1].toLowerCase();f.alert=Math.min(4,f.alert+DB_FORT_INCIDENTS[kind]);f.lastIncident=kind;f.lastIncidentTurn=d.turn;changed.push('incident='+kind+' alert='+f.alert);}
 if(!incident && /\[DB_FORT\|standdown\]/i.test(raw)){f.alert=Math.max(0,f.alert-1);changed.push('standdown alert='+f.alert);}
 if(changed.length){f.lastConfirmedTurn=d.turn;f.lastConfirmedGeneration=dbGenerationKey(d);f.activity.push({turn:d.turn,updates:changed.join(' | ')});if(f.activity.length>12)f.activity.shift();console.log('[DB][FORT] '+changed.join(' | '));}
}



// DRAGON ASSAULT DOCTRINE v0.4.5-alpha.5 — generated once, independent of player tactics.
// This is a defensive asset/status director, NOT a combat damage engine. The
// tower may injure or repel a dragon only through plausibly narrated, bounded
// equipment and magic; Surge Protector / MetaShift remain ability authorities.
var DB_ASSAULT_KEYS=['sky','breath','gate','reserve','wizard'];
var DB_ASSAULT_SKY={
 swamp:{name:'Mirror-guided bridge harpoons',placement:'bridge firing galleries cued by the existing watchboat mirrors',coverage:'exposed high-angle flight toward the gatehouse; cannot fire beneath the bridge, through reeds, walls or submerged channels',weakness:'Breakable mirror guidance, fixed firing arcs and vulnerable bridge winches',limit:3},
 cliff:{name:'Windward chain-harpoon battery',placement:'cliff ledges',coverage:'exposed flight between cliff and tower, not hidden sea caves',weakness:'Wind changes, fixed traverse and severable chain feeds',limit:3},
 forest:{name:'Canopy snare launchers',placement:'guarded treetop platforms',coverage:'clearings and the canopy line, not the forest floor',weakness:'Intervening trunks, exposed rope links and combustible platforms',limit:3},
 volcano:{name:'Ash-screened bolt engines',placement:'protected volcanic emplacements',coverage:'exposed landing terraces and caldera rim',weakness:'Heat haze limits aim and crews need time to reload',limit:3},
 mountain:{name:'Crosswind bolt throwers',placement:'upper mountain firing ledges',coverage:'exposed high passes and front-facing sky',weakness:'Blind lee slopes and destroyable pivot mounts',limit:3},
 desert:{name:'Sun-mirror tracking ballistae',placement:'dune-facing watchpoints',coverage:'sunlit exposed flight corridors',weakness:'Dust, shade and damaged reflector alignment',limit:3},
 island:{name:'Chain-boom harpoon launchers',placement:'lake docks and island towers',coverage:'open water approaches and low flight across docks',weakness:'A submerged or shore-hugging approach evades the firing arcs',limit:3},
 glacier:{name:'Frost-lens bolt arrays',placement:'ice-cut terraces',coverage:'clear sky approaches and the main ice bridge',weakness:'Lens calibration, whiteout and exposed mounting pins',limit:3},
 canyon:{name:'Overhead weighted net-casters',placement:'canyon rim towers',coverage:'upper canyon and main crossing',weakness:'Rock overhangs and severable net winches',limit:3},
 moor:{name:'Signal-guided sky harpoons',placement:'moorstone watchpoints',coverage:'open approach over sparse high moors',weakness:'Fog occludes targeting and signal cairns can be destroyed',limit:3}
};
var DB_ASSAULT_GATE={
 obsidian:{name:'Braced black-glass portcullis',placement:'gatehouse bridge and heavy doors',coverage:'main vehicle-sized entrance only; glass is vulnerable at stressed seams',weakness:'Counterweight winches, hinges, and fractured mirror backing'},
 iron:{name:'Rivet-bound lifting gate',placement:'primary ramp and entrance',coverage:'frontal passage only',weakness:'Exposed pins, winch bearings and chain tension'},
 wood:{name:'Root-laced gate wall',placement:'the main entry',coverage:'ordinary passage and nearby root defenses',weakness:'Irrigation connections, growth knots and prolonged heat'},
 ice:{name:'Runefrozen sliding doors',placement:'main threshold',coverage:'the gateway, not every wall',weakness:'Thermal seams, anchor runes and thaw channels'},
 default:{name:'Massive mechanically braced gate',placement:'main guarded entrance',coverage:'the main corridor and exposed entry, not all exterior walls',weakness:'Load-bearing hinges, counterweights, side masonry and service channels'}
};
var DB_ASSAULT_WIZARD={
 archmage:{name:'Layered battle-circle',effect:'Two prepared area wards or counterspells protect the sanctum while its anchors and caster remain intact',weakness:'Disrupt the circle, exhaust prepared charges or break line of sight'},
 necromancer:{name:'Ossuary guardian command',effect:'Two prepared waves of bound guardians can be raised from fixed grave anchors; no unlimited dead',weakness:'Destroy the anchor or isolate the caretaker'},
 illusionist:{name:'Decoy command gallery',effect:'Two planned false targets can misdirect a dragon, but illusions never physically stop claws or flame',weakness:'Physical contact, occluded projectors, conflicting sensory evidence'},
 stormbinder:{name:'Stormglass discharge lattice',effect:'Two charged electrical surges travel only through connected conductors',weakness:'Ground or sever the conductor; each discharge needs recharging'},
 fey_warlock:{name:'Oath and threshold lattice',effect:'Two contracted barriers respond only under clearly written guest-right conditions',weakness:'Find the exception, break the local anchor or refuse the bargain'},
 alchemist:{name:'Sealed reagent defenses',effect:'Two prepared alchemical blasts or binding clouds from real finite stores',weakness:'Ventilation, exposure of reagent storage or destroyed release valves'},
 oracle:{name:'Prepared divination counterplay',effect:'Two predicted attack lanes can be defended; the oracle cannot foresee every improvisation',weakness:'False information, feints and disrupted observatory lenses'},
 runekeeper:{name:'Rune-linked construct reserve',effect:'Two prepared rune activations command heavy guardians in marked zones',weakness:'Crack the runestone, disrupt inscription or escape its fixed coverage'}
};
var DB_LADDER_ASSAULT={
 approach:'The dragon may engage, break or simply survive and outrun the aerial watch. The watch has finite shots and blind angles. Crossing the actual outer security line completes approach even if defenders remain alive.',
 entry:'A dragon may smash the gate, rip its winches out, batter an exterior wall, or break in via a roof. Steel and stone can resist initial blows but are finite structures. A BREACH is not a full entry victory until the dragon gains a real route inside.',
 intelligence:'Threaten, defeat or seize actual staff, ledgers or couriers to find the real captive. Burning records or killing every knowledgeable servant can make the search harder; do not manufacture a new mandatory puzzle.',
 wardwork:'Find and wreck physical anchors, batter around localized ward coverage or exhaust bounded magical defenses. A magical shield is NOT automatically immune to overwhelming authorized force.',
 sanctum:'The dragon may kill, incapacitate or forcibly drive off the wizard if it can overcome his finite preparations; bargaining and stealth are optional. No substitute wizard or invincible final shield appears on demand.',
 captive:'The dragon can tear open custody barriers. The princess remains an individual with a distinct twist; do not automatically injure, move or kill her to punish a violent rescue.',
 extraction:'The dragon may carry the rescued person out through a physically opened breach, clear a route by force or fly away if capable. Enemy pursuit uses real survivors and remaining equipment.'
};
function dbAssaultInit(d){
 if(!d||!d.plot)return null;
 if(d.assault&&d.assault.schema===1&&d.assault.siteId===d.plot.siteId){
  // v0.4.5-alpha.5 additive migration: keep every existing asset, charge,
  // gate outcome and old save untouched while adding unresolved threats.
  if(!d.assault.threats)d.assault.threats={};
  if(!d.assault.environmental)d.assault.environmental={};
  if(d.assault.environmental.bridgeDrop&&d.assault.environmental.bridgeDrop.status==='triggered'&&!d.assault.threats.bridgeDrop){
   d.assault.threats.bridgeDrop={status:'active',source:'migrated prior bridge-drop state',startTurn:d.assault.environmental.bridgeDrop.turn};
  }
  return d.assault;
 }
 var t=d.tower||{},air=DB_ASSAULT_SKY[t.terrain]||DB_ASSAULT_SKY.moor,gate=DB_ASSAULT_GATE[t.material]||DB_ASSAULT_GATE.default;
 var spell=DB_ASSAULT_WIZARD[d.plot.wizardId]||DB_ASSAULT_WIZARD.archmage;
 function asset(id,name,placement,coverage,weakness,charges){return {id:id,name:name,placement:placement,coverage:coverage,weakness:weakness,status:'ready',charges:charges===null?null:charges,lastTurn:-1};}
 d.assault={schema:1,siteId:d.plot.siteId,assets:{
  sky:asset('sky',air.name,air.placement,air.coverage,air.weakness,air.limit),
  breath:asset('breath','Segmented blast baffles','guarded openings and exposed approach lanes','Two hinged barriers can shelter crews from DIRECT breath cones in their facing; NOT universal elemental immunity, full enclosure, or protection from repeated blasts','Break the exposed hinges, attack an uncovered angle, or force the panels to spend their two deployments',2),
  gate:asset('gate',gate.name,gate.placement,gate.coverage,gate.weakness,null),
  reserve:asset('reserve','Fortress heavy-response section','barracks and protected mustering routes','Two preassigned squads/construct teams can respond to a witnessed assault after messages travel; not instant reinforcements or infinite cannon fodder','Intercept the messengers, isolate the muster room, defeat the responders or cut their route',2),
  wizard:asset('wizard',spell.name,'sanctum and prepared anchor zones',spell.effect,spell.weakness,2)
 },history:[],lastEventTurn:-1,threats:{},environmental:{}};
 return d.assault;
}
// Threat lifecycle is deliberately separate from weapon expenditure and HP.
// The Output modifier can observe the trajectory over several Continue turns,
// but only an observed resolution closes it. No automatic hit or escape rolls.
function dbThreatBeginShot(d,a,source){
 if(!a.threats)a.threats={};
 var existing=a.threats.skyShot;
 if(existing&&existing.status==='incoming')return false;
 a.threats.skyShot={status:'incoming',source:source,turn:d.turn,generation:dbGenerationKey(d),outcome:null};
 console.log('[DB][THREAT] sky_shot=incoming ('+source+')');return true;
}
function dbThreatBeginBridge(d,a){
 if(!a.threats)a.threats={};
 if(a.threats.bridgeDrop)return false;
 a.threats.bridgeDrop={status:'active',turn:d.turn,generation:dbGenerationKey(d),outcome:null};
 console.log('[DB][THREAT] bridge_drop=active');return true;
}
function dbThreatObserve(d,visible){
 var a=d.assault;if(!a||!a.threats)return;
 var s=String(visible||'');if(!s.trim())return;
 // Detect player outcomes across multiple AI generations. Several sentences
 // can refer to the SAME projectile with 'one bolt', 'another', 'it', etc.
 // Threats are narrative state, not combat damage or independent HP rolls.
 var sentences=s.split(/[.!?\n]+/);
 var sky=a.threats.skyShot;
 if(sky&&sky.status==='incoming'){
  if(/\b(?:cluster|volley)\s+(?:of\s+)?three\b|\bthree\s+(?:harpoons?|bolts?|projectiles?)\b/i.test(s)){
   sky.volley=true;sky.volleyCount=3;
  }else if(/\b(?:cluster|volley)\s+(?:of\s+)?(?:two|multiple|several)\b|\b(?:another|second|third)\s+(?:harpoon|bolt|projectile)\b|\bharpoon\s+cluster\b/i.test(s)){
   sky.volley=true;
  }
  var eventHit=false,eventMiss=false,eventDeflected=false,finalMention=false;
  for(var i=0;i<sentences.length;i++){
   var t=sentences[i].trim();if(!t)continue;
   if(/\b(?:if|would|could|might|may|perhaps|almost|nearly|about to|attempt|try to|tries to|intend|imagine|suppose|whether|not yet|hasn't|has not|never)\b/i.test(t))continue;
   // A bolt of lightning is not one of the already flying harpoons.
   if(/\bbolt\s+of\s+(?:lightning|energy|fire|flame|magic|electricity|thunder)\b/i.test(t)&&!/\bharpoon\b/i.test(t))continue;
   // 'Another' or 'one' is permitted only when the harpoon volley is
   // explicitly established. No generic pronoun-based combat inference.
   var linked=/\b(?:harpoon|harpoons|bolt|bolts|projectile|projectiles)\b/i.test(t)
    ||(sky.volley&&/\b(?:one|another|first|second|third|last|final)\b/i.test(t));
   if(!linked)continue;
   if(/\b(?:harpoon|bolt|projectile|one|another|first|second|third)\b[^;]{0,115}\b(?:clips?|clipped|rakes?|raked|raking|tears?|tore|strikes?|struck|hits?|hit|pierces?|pierced|impales?|impaled|pins?|pinned|gouges?|gouged|lodges?|lodged)\b[^;]{0,105}\b(?:you|your|wings?|membrane|scales?|shoulder|flank|body|hide|belly|armor|armour)\b/i.test(t)
      ||/\b(?:harpoon|bolt|projectile)\b[^;]{0,110}\b(?:buries? itself|buried itself)\b[^;]{0,100}\b(?:your|you|wing|scales|shoulder)\b/i.test(t)){
    eventHit=true;
    if(/\b(?:wing|membrane)\b/i.test(t)){sky.injuryRegion='wing';sky.injuryDescription=/\b(?:shallow|small|minor|light)\b/i.test(t)?'shallow gash':'wing struck by harpoon';}
   }
   if(/\b(?:harpoon|bolt|projectile|one|another|first|second|third)\b[^;]{0,115}\b(?:whistles? past|flies? past|streaks? past|sails? past|passes? (?:beneath|past|above|over|beside|beyond)|misses?|missed|plunges? (?:into|past|beside)|splashes? into|burying itself in (?:the )?(?:bridge|marsh|water|obsidian))\b/i.test(t))eventMiss=true;
   if(/\b(?:harpoon|bolt|projectile)\b[^;]{0,115}\b(?:glances? off|ricochets?|deflects?|rebounds?|bounces? off)\b/i.test(t))eventDeflected=true;
   if(/\b(?:final|last|remaining|all|third)\s+(?:harpoon|harpoons|bolt|bolts|projectile|projectiles)\b/i.test(t)&&
       /\b(?:miss|missed|passes?|whistles?|splashes?|strikes?|hits?|clipped|rakes?|lodges?|ricochets?|plunges?)\b/i.test(t))finalMention=true;
